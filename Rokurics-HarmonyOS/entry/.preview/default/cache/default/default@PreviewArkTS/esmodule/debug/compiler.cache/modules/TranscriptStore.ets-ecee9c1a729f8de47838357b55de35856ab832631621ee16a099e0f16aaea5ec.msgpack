                    providerName: json['providerName'] ?? '',
                    text: json['text'] ?? '',
                    modelName: json['modelName'] ?? null,
                    language: json['language'] ?? null,
                    segments: segs,
                    status: json['status'] ?? 'transcribed'
                });
