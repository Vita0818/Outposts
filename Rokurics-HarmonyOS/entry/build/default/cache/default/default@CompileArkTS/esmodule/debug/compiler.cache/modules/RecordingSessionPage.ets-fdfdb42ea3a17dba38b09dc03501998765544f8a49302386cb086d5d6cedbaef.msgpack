    getTimerColor() {
        switch (this.state) {
            case RecordingState.RECORDING:
                return RokuricsColors.coral;
            case RecordingState.PAUSED:
                return RokuricsColors.softTeal;
            default:
                return RokuricsColors.deepText;
        }
    }
    rerender() {
        this.updateDirtyElements();
    }
    static getEntryName() {
        return "RecordingSessionPage";
    }
}
registerNamedRoute(() => new RecordingSessionPage(undefined, {}), "", { bundleName: "com.vita0818.rokurics", moduleName: "entry", pagePath: "pages/RecordingSessionPage", pageFullPath: "entry/src/main/ets/pages/RecordingSessionPage", integratedHsp: "false", moduleType: "followWithHap" });
//# sourceMappingURL=RecordingSessionPage.js.mapÂ•Ù`/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entry/src/main/ets/services/RecordingManager.etsÙ]/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entry/src/main/ets/models/RecordingModels.etsÙZ/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entry/src/main/ets/utils/FormatHelpers.etsÙZ/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entry/src/main/ets/utils/RokuricsTheme.etsÙX/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entry/src/main/ets/utils/CustomIcons.etsÙa/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entry/src/main/ets/pages/RecordingSessionPage.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ5/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entryÙ//Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS¥entry¥1.0.0Ô␀␀Ù5/Users/vita/Vitemis/Outposts/Rokurics-HarmonyOS/entryÃÃÚPş/**
 * Recording session page - mirrors RecordingSessionView.swift
 */
import { getSharedRecordingManager, RecordingManager } from '../services/RecordingManager'
import { RecordingState, StudyFilingPath, filingLevelTitle } from '../models/RecordingModels'
import { formatClock, formatDuration } from '../utils/FormatHelpers'
import { RokuricsColors, FontWeight } from '../utils/RokuricsTheme'
import { PlayIcon, PauseIcon, StopIcon } from '../utils/CustomIcons'

const FILING_OPTIONS: Record<string, string[]> = {
  'type': ['è¯¾å ‚å½•éŸ³', 'è‡ªå­¦ç¬”è®°', 'ä¼šè®®è®°å½•', 'è®¿è°ˆé‡‡è®¿', 'çµæ„Ÿè®°å½•', 'å…¶ä»–'],
  'subject': ['æ•°å­¦', 'ç‰©ç†', 'åŒ–å­¦', 'ç”Ÿç‰©', 'è®¡ç®—æœº', 'è‹±è¯­', 'å†å²', 'æ–‡å­¦', 'å“²å­¦', 'è‰ºæœ¯'],
  'chapter': [],
  'topic': []
}

@Entry
@Component
struct RecordingSessionPage {
  private recordingManager: RecordingManager = getSharedRecordingManager()
  @State state: RecordingState = RecordingState.IDLE
  @State elapsedSeconds: number = 0
  @State statusText: string = 'å‡†å¤‡ä¸­'
  @State suggestedTitle: string = ''
  @State pendingTitle: string = ''
  @State filingType: string = ''
  @State filingSubject: string = ''
  @State filingChapter: string = ''
  @State filingTopic: string = ''
  @State showFilingPicker: boolean = false
  @State isPausedBlinking: boolean = false
  @State pulsePhase: number = 0

  aboutToAppear(): void {
    this.recordingManager.onStateChange((s: RecordingState) => {
      this.state = s
      this.elapsedSeconds = this.recordingManager.elapsedSeconds
      this.statusText = this.recordingManager.statusMessage
      if (s === RecordingState.PAUSED) {
        this.isPausedBlinking = true
      } else {
        this.isPausedBlinking = false
      }
    })
    this.state = this.recordingManager.state
    this.elapsedSeconds = this.recordingManager.elapsedSeconds
    this.statusText = this.recordingManager.statusMessage
    this.suggestedTitle = this.recordingManager.suggestedTitle
    this.pendingTitle = this.recordingManager.pendingTitle ?? ''

    // Auto-start recording if idle
    if (this.state === RecordingState.IDLE) {
      this.recordingManager.startRecording()
    }

    // Simple pulse for recording indicator
    const updatePulse = () => {
      const t = Date.now() / 1000
      this.pulsePhase = Math.sin(t * Math.PI) * 0.5 + 0.5
      if (this.state === RecordingState.RECORDING || this.state === RecordingState.PAUSED) {
        setTimeout(updatePulse, 50)
      }
    }
    updatePulse()
  }

  private getFilingPath(): StudyFilingPath {
    return new StudyFilingPath(
      this.filingType || undefined,
      this.filingSubject || undefined,
      this.filingChapter || undefined,
      this.filingTopic || undefined
    )
  }

  build() {
    Stack() {
      // Ambient background
      this.SessionBackground()

      Column() {
        // Header
        Row() {
          // Glass circle back button
          Button() {
            Text('â†')
              .fontSize(18)
              .fontWeight(FontWeight.SemiBold)
              .fontColor(RokuricsColors.deepText)
          }
          .width(44)
          .height(44)
          .borderRadius(22)
          .backgroundColor(RokuricsColors.glassSurface + '66')
          .shadow({
            color: RokuricsColors.shadowColor + '10',
            radius: 12,
            offsetY: 6
          })
          .border({
            width: 1,
            color: {
              colors: [
                [0xFFFFFF, 0.44],
                [0xEFFAF8, 0.14],
                [0x59C7C2, 0.12]
              ],
              direction: GradientDirection.RightBottom
            },
            radius: 22
          } as BorderOptions)
          .onClick(() => this.getUIContext().getRouter().back())

          Blank()

          // Stop / Save button
          if (this.state === RecordingState.RECORDING || this.state === RecordingState.PAUSED) {
            Button() {
              Text('åœæ­¢')
                .fontSize(16)
                .fontWeight(FontWeight.SemiBold)
                .fontColor(Color.White)
            }
            .padding({ left: 20, right: 20, top: 10, bottom: 10 })
            .borderRadius(20)
            .backgroundColor(RokuricsColors.coral)
            .shadow({
              color: RokuricsColors.coral + '30',
              radius: 12,
              offsetY: 4
            })
            .onClick(() => {
              this.recordingManager.stopRecording()
            })
          } else if (this.state === RecordingState.FILING) {
            Button() {
              Text('ä¿å­˜')
                .fontSize(16)
                .fontWeight(FontWeight.SemiBold)
                .fontColor(Color.White)
            }
            .padding({ left: 20, right: 20, top: 10, bottom: 10 })
            .borderRadius(20)
            .backgroundColor(RokuricsColors.aqua)
            .shadow({
              color: RokuricsColors.aqua + '30',
              radius: 12,
              offsetY: 4
            })
            .onClick(() => {
              const filing = this.getFilingPath()
              this.recordingManager.finalizeRecording(
                this.pendingTitle || this.suggestedTitle,
                filing.isEmpty ? null : filing
              )
              this.getUIContext().getRouter().back()
            })
          }
        }
        .width('100%')
        .padding({ left: 16, right: 16, top: 56 })

        Blank()

        // Timer card with glass styling (mirrors Apple's liquid glass card)
        Column({ space: 16 }) {
          Text(formatClock(this.elapsedSeconds))
            .fontSize(78)
            .fontWeight(FontWeight.Bold)
            .fontFamily('serif')
            .fontColor(this.getTimerColor())
            .maxLines(1)
            .opacity(this.isPausedBlinking ? (0.4 + this.pulsePhase * 0.6) : 1.0)

          Text(this.statusText)
            .fontSize(15)
            .fontWeight(FontWeight.Medium)
            .fontColor(RokuricsColors.softText)

          // Recording indicator dot
          if (this.state === RecordingState.RECORDING) {
            Row({ space: 6 }) {
              Circle()
                .width(8)
                .height(8)
                .fill(RokuricsColors.coral)
                .opacity(0.7 + this.pulsePhase * 0.3)
              Text('å½•åˆ¶ä¸­')
                .fontSize(12)
                .fontColor(RokuricsColors.coral)
            }
          }

          if (this.state === RecordingState.FAILED) {
            Text(this.recordingManager.lastError ?? 'å½•éŸ³å¤±è´¥')
              .fontSize(13)
              .fontColor(RokuricsColors.coral)
              .textAlign(TextAlign.Center)
              .maxLines(2)
              .padding({ left: 16, right: 16 })
          }
        }
        .width('85%')
        .padding({ top: 36, bottom: 36, left: 18, right: 18 })
        .borderRadius(34)
        .backgroundColor(RokuricsColors.glassSurface + '5C')
        .shadow({
          color: RokuricsColors.shadowColor + '12',
          radius: 24,
          offsetY: 14
        })
        .border({
          width: 1,
          color: {
            colors: [
              [0xFFFFFF, 0.42],
              [0xEFFAF8, 0.18],
              [0x91E8D6, 0.14]
            ],
            direction: GradientDirection.RightBottom
          },
          radius: 34
        } as BorderOptions)

        Blank()

        // Control buttons (glass cards)
        if (this.state === RecordingState.RECORDING || this.state === RecordingState.PAUSED) {
          Row({ space: 12 }) {
            // Pause/Resume button
            Button() {
              Column({ space: 8 }) {
                if (this.state === RecordingState.PAUSED) {
                  PlayIcon(22, RokuricsColors.softTeal)
                } else {
                  PauseIcon(22, RokuricsColors.softTeal)
                }
                Text(this.state === RecordingState.PAUSED ? 'ç»§ç»­' : 'æš‚åœ')
                  .fontSize(13)
                  .fontWeight(FontWeight.SemiBold)
              }
              .foregroundColor(RokuricsColors.softTeal)
              .width('100%')
              .height(76)
              .justifyContent(FlexAlign.Center)
            }
            .layoutWeight(1)
            .height(76)
            .borderRadius(24)
            .backgroundColor(RokuricsColors.glassSurface + '61')
            .shadow({
              color: RokuricsColors.shadowColor + '08',
              radius: 12,
              offsetY: 6
            })
            .border({
              width: 1,
              color: {
                colors: [
                  [0xFFFFFF, 0.34],
                  [0xEFFAF8, 0.14],
                  [0x91E8D6, 0.10]
                ],
                direction: GradientDirection.RightBottom
              },
              radius: 24
            } as BorderOptions)
            .onClick(() => this.recordingManager.toggleRecording())
          }
          .width('100%')
          .padding({ left: 22, right: 22, bottom: 36 })
        }

        // Pause/Resume single button for compact view
        if (this.state === RecordingState.RECORDING || this.state === RecordingState.PAUSED) {
          Button() {
            if (this.state === RecordingState.RECORDING) {
              PauseIcon(36, '#FFFFFF')
            } else {
              PlayIcon(36, '#FFFFFF')
            }
          }
          .width(72)
          .height(72)
          .borderRadius(36)
          .backgroundColor(this.state === RecordingState.RECORDING ? RokuricsColors.coral : RokuricsColors.aqua)
          .shadow({
            color: (this.state === RecordingState.RECORDING ? RokuricsColors.coral : RokuricsColors.aqua) + '40',
            radius: 18,
            offsetY: 6
          })
          .onClick(() => this.recordingManager.toggleRecording())
          .margin({ bottom: 60 })
        }
      }
      .width('100%')
      .height('100%')

      // Filing UI overlay
      if (this.state === RecordingState.FILING) {
        this.FilingOverlay()
      }

      // Saved state
      if (this.state === RecordingState.SAVED) {
        Column({ space: 12 }) {
          Text('å·²ä¿å­˜')
            .fontSize(24)
            .fontWeight(FontWeight.Bold)
            .fontColor(RokuricsColors.aqua)
          Text(`æ—¶é•¿ï¼š${formatDuration(this.elapsedSeconds)}`)
            .fontSize(14)
            .fontColor(RokuricsColors.softText)
          Button() {
            Text('è¿”å›é¦–é¡µ')
              .fontWeight(FontWeight.Medium)
              .fontColor(RokuricsColors.aqua)
          }
          .margin({ top: 20 })
          .onClick(() => {
            this.getUIContext().getRouter().back()
          })
        }
      }

      // Failed state
      if (this.state === RecordingState.FAILED) {
        Column({ space: 12 }) {
          Text('å½•éŸ³å¤±è´¥')
            .fontSize(18)
            .fontColor(RokuricsColors.coral)
          Text(this.recordingManager.lastError ?? '')
            .fontSize(13)
            .fontColor(RokuricsColors.softText)
          Button() {
            Text('è¿”å›')
              .fontColor(RokuricsColors.aqua)
          }
          .margin({ top: 16 })
          .onClick(() => this.getUIContext().getRouter().back())
        }
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor(RokuricsColors.pageBackground)
  }

  @Builder
  FilingOverlay() {
    Stack() {
      // Semi-transparent backdrop
      Column()
        .width('100%')
        .height('100%')
        .backgroundColor('#00000028')
        .onClick(() => {})

      // Filing card overlay
      Scroll() {
        Column({ space: 16 }) {
          // Header
          Text('å½•éŸ³å½’æ¡£')
            .fontSize(30)
            .fontWeight(FontWeight.Bold)
            .fontColor(RokuricsColors.deepText)

          Text('é€‰æ‹©é—¨ç±»â†’è¯¾ç¨‹â†’ç« èŠ‚â†’ä¸»é¢˜ï¼Œæˆ–ç›´æ¥ä¿å­˜')
            .fontSize(14)
            .fontColor(RokuricsColors.softText)

          // Title input
          Column({ space: 8 }) {
            Text('å½•éŸ³æ ‡é¢˜')
              .fontSize(13)
              .fontWeight(FontWeight.SemiBold)
              .fontColor(RokuricsColors.softText)
            TextInput({
              text: this.pendingTitle || this.suggestedTitle,
              placeholder: 'è¾“å…¥å½•éŸ³æ ‡é¢˜'
            })
              .fontSize(20)
              .fontWeight(FontWeight.SemiBold)
              .fontColor(RokuricsColors.deepText)
              .backgroundColor(RokuricsColors.glassSurface + '80')
              .borderRadius(12)
              .padding(16)
              .width('100%')
              .onChange((value: string) => {
                this.pendingTitle = value
                this.recordingManager.updatePendingTitle(value)
              })
          }

          // Filing level buttons
          Row({ space: 8 }) {
            this.LevelButton('é—¨ç±»', this.filingType, true)
            this.LevelButton('è¯¾ç¨‹', this.filingSubject, this.filingType.length > 0)
            this.LevelButton('ç« èŠ‚', this.filingChapter, this.filingSubject.length > 0)
            this.LevelButton('ä¸»é¢˜', this.filingTopic, this.filingChapter.length > 0)
          }

          // Show options for active level
          if (this.filingSubject.length > 0 && this.filingChapter.length > 0) {
            Text('ä¸»é¢˜ (è‡ªç”±è¾“å…¥)')
              .fontSize(12)
              .fontColor(RokuricsColors.softText)
            TextInput({ text: this.filingTopic, placeholder: 'è¾“å…¥ä¸»é¢˜å' })
              .fontSize(14)
              .fontColor(RokuricsColors.deepText)
              .backgroundColor(RokuricsColors.glassSurface + '40')
              .borderRadius(8)
              .padding({ left: 12, right: 12, top: 8, bottom: 8 })
              .onChange((value: string) => { this.filingTopic = value })
          } else if (this.filingType.length > 0 && this.filingSubject.length > 0) {
            Text('ç« èŠ‚ (è‡ªç”±è¾“å…¥)')
              .fontSize(12)
              .fontColor(RokuricsColors.softText)
            TextInput({ text: this.filingChapter, placeholder: 'è¾“å…¥ç« èŠ‚å' })
              .fontSize(14)
              .fontColor(RokuricsColors.deepText)
              .backgroundColor(RokuricsColors.glassSurface + '40')
              .borderRadius(8)
              .padding({ left: 12, right: 12, top: 8, bottom: 8 })
              .onChange((value: string) => { this.filingChapter = value })
          } else if (this.filingType.length > 0) {
            // Subject options
            Row({ space: 6 }) {
              ForEach(FILING_OPTIONS['subject'], (option: string) => {
                Text(option)
                  .fontSize(12)
                  .fontWeight(FontWeight.Medium)
                  .fontColor(this.filingSubject === option ? Color.White : RokuricsColors.softText)
                  .padding({ left: 10, right: 10, top: 6, bottom: 6 })
                  .borderRadius(12)
                  .backgroundColor(this.filingSubject === option ? RokuricsColors.aqua : RokuricsColors.glassSurface + '50')
                  .onClick(() => {
                    if (this.filingSubject === option) {
                      this.filingSubject = ''
                    } else {
                      this.filingSubject = option
                    }
                  })
              })
            }
            .flexShrink(0)
          } else {
            // Type options
            Row({ space: 6 }) {
              ForEach(FILING_OPTIONS['type'], (option: string) => {
                Text(option)
                  .fontSize(12)
                  .fontWeight(FontWeight.Medium)
                  .fontColor(this.filingType === option ? Color.White : RokuricsColors.softText)
                  .padding({ left: 10, right: 10, top: 6, bottom: 6 })
                  .borderRadius(12)
                  .backgroundColor(this.filingType === option ? RokuricsColors.aqua : RokuricsColors.glassSurface + '50')
                  .onClick(() => {
                    if (this.filingType === option) {
                      this.filingType = ''
                    } else {
                      this.filingType = option
                    }
                  })
              })
            }
            .flexShrink(0)
          }

          // Filing summary
          if (this.filingType || this.filingSubject || this.filingChapter || this.filingTopic) {
            Text(`å½’æ¡£è·¯å¾„ï¼š${this.getFilingPath().displaySummary}`)
              .fontSize(12)
              .fontColor(RokuricsColors.aqua)
              .margin({ top: 4 })
          }

          // Action buttons
          Row({ space: 12 }) {
            Button() {
              Text('ç›´æ¥ä¿å­˜')
                .fontSize(15)
                .fontWeight(FontWeight.SemiBold)
                .fontColor(RokuricsColors.softText)
            }
            .layoutWeight(1)
            .height(48)
            .borderRadius(24)
            .backgroundColor(RokuricsColors.glassSurface + '4D')
            .border({ width: 1, color: RokuricsColors.softText + '20', radius: 24 })
            .onClick(() => {
              this.recordingManager.finalizeRecordingDirectSave()
              this.getUIContext().getRouter().back()
            })

            Button() {
              Text('ä¿å­˜å½’æ¡£')
                .fontSize(15)
                .fontWeight(FontWeight.SemiBold)
                .fontColor(Color.White)
            }
            .layoutWeight(1)
            .height(48)
            .borderRadius(24)
            .backgroundColor(
              (this.filingType || this.filingSubject || this.filingChapter || this.filingTopic) ?
                RokuricsColors.aqua : RokuricsColors.tertiaryText
            )
            .enabled(!!(this.filingType || this.filingSubject || this.filingChapter || this.filingTopic))
            .shadow({
              color: RokuricsColors.shadowColor + '16',
              radius: 14,
              offsetY: 8
            })
            .onClick(() => {
              const filing = this.getFilingPath()
              this.recordingManager.finalizeRecording(
                this.pendingTitle || this.suggestedTitle,
                filing.isEmpty ? null : filing
              )
              this.getUIContext().getRouter().back()
            })
          }
          .width('100%')
        }
        .width('100%')
        .padding(22)
        .borderRadius(30)
        .backgroundColor(RokuricsColors.glassSurface + 'F5')
        .shadow({
          color: RokuricsColors.shadowColor + '1C',
          radius: 26,
          offsetY: 14
        })
        .border({
          width: 1,
          color: {
            colors: [
              [0xFFFFFF, 0.50],
              [0xEFFAF8, 0.20],
              [0x91E8D6, 0.16]
            ],
            direction: GradientDirection.RightBottom
          },
          radius: 30
        } as BorderOptions)
        .constraintSize({ maxWidth: 380 })
      }
      .width('100%')
      .height('100%')
      .padding(24)
      .constraintSize({ maxWidth: 420 })
    }
    .width('100%')
    .height('100%')
    .zIndex(10)
    .position({ x: 0, y: 0 })
  }

  @Builder
  LevelButton(label: string, value: string, enabled: boolean) {
    Column({ space: 3 }) {
      Text(label)
        .fontSize(9)
        .fontWeight(FontWeight.Bold)
        .fontColor(RokuricsColors.tertiaryText)
      Text(value || 'â€”')
        .fontSize(11)
        .fontWeight(FontWeight.SemiBold)
        .fontColor(enabled ? RokuricsColors.deepText : RokuricsColors.tertiaryText)
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
        .constraintSize({ maxWidth: 56 })
    }
    .padding({ left: 8, right: 8, top: 6, bottom: 6 })
    .constraintSize({ minWidth: 64 })
    .borderRadius(13)
    .backgroundColor(RokuricsColors.glassSurface + '56')
    .border({
      width: 1,
      color: enabled ? RokuricsColors.aqua + '46' : RokuricsColors.softText + '18',
      radius: 13
    })
    .opacity(enabled ? 1 : 0.46)
  }

  @Builder
  SessionBackground() {
    Stack() {
      Circle()
        .width(220)
        .height(220)
        .fill(RokuricsColors.mint + '20')
        .position({ x: -50, y: -150 })

      Circle()
        .width(260)
        .height(260)
        .fill(RokuricsColors.skyCyan + '16')
        .position({ x: '85%', y: '75%' })
    }
    .width('100%')
    .height('100%')
  }

  private getTimerColor(): string {
    switch (this.state) {
      case RecordingState.RECORDING:
        return RokuricsColors.coral
      case RecordingState.PAUSED:
        return RokuricsColors.softTeal
      default:
        return RokuricsColors.deepText
    }
  }
