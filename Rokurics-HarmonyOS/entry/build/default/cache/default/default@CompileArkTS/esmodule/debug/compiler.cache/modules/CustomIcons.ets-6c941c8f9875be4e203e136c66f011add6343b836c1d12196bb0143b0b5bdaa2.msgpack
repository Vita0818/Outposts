        Circle.width(size * 0.24);
        Circle.height(size * 0.24);
        Circle.fill(color);
        Circle.offset({ y: size * -0.02 });
    }, Circle);
    // Cloud body
    Row.pop();
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        // Upload arrow
        Polygon.create();
        // Upload arrow
        Polygon.points([
            [size * 0.22, size * 0.32],
            [size * 0.42, size * 0.06],
            [size * 0.62, size * 0.32]
        ]);
        // Upload arrow
