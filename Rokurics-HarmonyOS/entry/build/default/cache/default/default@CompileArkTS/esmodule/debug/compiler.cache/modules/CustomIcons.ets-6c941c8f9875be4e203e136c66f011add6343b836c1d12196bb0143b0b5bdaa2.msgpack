// â”€â”€ Play triangle â”€â”€
export function PlayIcon(size, color, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Polygon.create();
        Polygon.points([
            [0, 0],
            [size, size * 0.5],
            [0, size]
        ]);
        Polygon.fill(color);
        Polygon.width(size * 0.7);
        Polygon.height(size);
    }, Polygon);
}
