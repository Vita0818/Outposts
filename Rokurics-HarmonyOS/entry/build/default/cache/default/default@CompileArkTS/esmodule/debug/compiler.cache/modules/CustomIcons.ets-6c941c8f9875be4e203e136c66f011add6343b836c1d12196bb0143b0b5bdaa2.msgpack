// â”€â”€ Back arrow â”€â”€
export function BackIcon(size, color, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Text.create('â†');
        Text.fontSize(size);
        Text.fontWeight(600);
        Text.fontColor(color);
    }, Text);
    Text.pop();
}
