// â”€â”€ Send arrow â”€â”€
export function SendIcon(size, color, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Polygon.create();
        Polygon.points([
            [0, size * 0.4],
            [size * 0.65, size * 0.4],
            [size * 0.65, 0],
            [size, size * 0.5],
            [size * 0.65, size],
            [size * 0.65, size * 0.6],
            [0, size * 0.6]
        ]);
        Polygon.fill(color);
        Polygon.width(size);
        Polygon.height(size);
    }, Polygon);
}
