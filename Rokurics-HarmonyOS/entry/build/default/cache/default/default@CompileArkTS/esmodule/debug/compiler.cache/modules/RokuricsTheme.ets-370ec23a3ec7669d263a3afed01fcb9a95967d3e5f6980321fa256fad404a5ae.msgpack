// Reusable glass card backing (mirrors rokuricsLiquidGlassCard) â”€â”€
export function GlassCardContent(child, parent = null) {
    const __child__ = child;
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender, child = __child__) => {
        Column.create();
        Column.borderRadius(20);
        Column.backgroundColor(RokuricsColors.glassSurface + 'A8');
        Column.shadow({
            color: RokuricsColors.shadowColor + '18',
            radius: 18,
            offsetY: 10
        });
        Column.border({
            width: 1,
            color: {
                colors: [
                    [0xFFFFFF, 0.44],
                    [0xEFFAF8, 0.18],
                    [0x91E8D6, 0.14]
                ],
                direction: GradientDirection.RightBottom
            },
            radius: 20
        });
    }, Column);
    child.builder.bind(this)();
    Column.pop();
}
// â”€â”€ Glass circle (mirrors rokuricsGlassCircle) â”€â”€
export function GlassCircle(size, child, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Stack.create();
        Stack.width(size);
        Stack.height(size);
        Stack.borderRadius(size / 2);
        Stack.backgroundColor(RokuricsColors.glassSurface + '66');
        Stack.shadow({
            color: RokuricsColors.shadowColor + '12',
            radius: 14,
            offsetY: 7
        });
        Stack.border({
            width: 1,
            color: {
                colors: [
                    [0xFFFFFF, 0.44],
                    [0xEFFAF8, 0.14],
                    [0x59C7C2, 0.12]
                ],
                direction: GradientDirection.RightBottom
            },
            radius: size / 2
        });
    }, Stack);
    child.builder.bind(this)();
    Stack.pop();
}
// â”€â”€ Status pill (mirrors RokuricsStatusPill) â”€â”€
export function StatusPill(text, color, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Row.create({ space: 6 });
        Row.padding({ left: 10, right: 10, top: 5, bottom: 5 });
        Row.borderRadius(12);
        Row.backgroundColor(color + '18');
        Row.border({ width: 1, color: color + '30', radius: 12 });
    }, Row);
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Circle.create();
        Circle.width(8);
        Circle.height(8);
        Circle.fill(color);
    }, Circle);
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Text.create(text);
        Text.fontSize(11);
        Text.fontWeight(FontWeight.Medium);
        Text.fontColor(color);
        Text.maxLines(1);
    }, Text);
    Text.pop();
    Row.pop();
}
// â”€â”€ Icon circle button (mirrors RokuricsIconCircleButton) â”€â”€
export function IconCircleButton(symbol, size, tint, onClick, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Button.createWithChild();
        Button.width(size);
        Button.height(size);
        Button.borderRadius(size / 2);
        Button.backgroundColor(RokuricsColors.glassSurface + '66');
        Button.shadow({
            color: RokuricsColors.shadowColor + '10',
            radius: 12,
            offsetY: 6
        });
        Button.border({
            width: 1,
            color: {
                colors: [
                    [0xFFFFFF, 0.44],
                    [0xEFFAF8, 0.14],
                    [0x59C7C2, 0.12]
                ],
                direction: GradientDirection.RightBottom
            },
            radius: size / 2
        });
        Button.onClick(onClick);
    }, Button);
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Text.create(symbol);
        Text.fontSize(size * 0.42);
        Text.fontWeight(FontWeight.SemiBold);
        Text.fontColor(tint);
    }, Text);
    Text.pop();
    Button.pop();
}
// â”€â”€ Waveform icon (mirrors recording leading icon) â”€â”€
export function WaveformIcon(size, parent = null) {
    const __size__ = size;
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender, size = __size__) => {
        Stack.create();
        Stack.width(size);
