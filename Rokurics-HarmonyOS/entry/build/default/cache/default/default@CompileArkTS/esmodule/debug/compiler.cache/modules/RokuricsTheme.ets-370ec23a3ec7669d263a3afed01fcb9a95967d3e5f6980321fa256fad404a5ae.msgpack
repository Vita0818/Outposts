        Stack.height(size);
        Stack.borderRadius(size / 2);
        Stack.backgroundColor(colorAlpha(RokuricsColors.glassSurface, '4A'));
        Stack.border({
            width: 1,
            color: {
                colors: [
                    [0xFFFFFF, 0.20],
                    [RokuricsColors.glassStroke, 0.12],
                    [RokuricsColors.aqua, 0.20]
                ],
