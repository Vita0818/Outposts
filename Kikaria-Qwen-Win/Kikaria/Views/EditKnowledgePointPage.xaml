<Page
    x:Class="Kikaria.Views.EditKnowledgePointPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Background="Transparent"
                    Click="BackButton_Click" />

            <TextBlock Grid.Column="1"
                       x:Name="PageTitle"
                       Text="添加知识点"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Microsoft YaHei, PingFang SC" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="保存"
                    Height="36"
                    CornerRadius="12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"
                    FontFamily="Microsoft YaHei, PingFang SC" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,16,24,32" MaxWidth="700" HorizontalAlignment="Center">

                <controls:LiquidGlassCard x:Name="PresetInfoCard"
                                          CardCornerRadius="14"
                                          Padding="16,12,16,12">
                    <TextBlock x:Name="PresetNameDisplay"
                               Text=""
                               FontSize="13"
                               Opacity="0.5"
                               FontFamily="Microsoft YaHei, PingFang SC" />
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="TitleCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="TitleLabel"
                                   Text="标题"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="TitleBox"
                                 PlaceholderText="输入知识点标题"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="TagsCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="TagsLabel"
                                   Text="标签"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="TagsBox"
                                 PlaceholderText="用逗号分隔多个标签"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="HintCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="HintLabel"
                                   Text="提示"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="HintBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="150"
                                 PlaceholderText="输入提示信息（帮助回忆的线索）"
                                 FontSize="14"
                                 FontFamily="Microsoft YaHei, PingFang SC"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="ContentCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ContentLabel"
                                   Text="内容"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="ContentBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 PlaceholderText="输入完整答案内容（支持 LaTeX 公式）"
                                 FontSize="14"
                                 FontFamily="Cascadia Code, Consolas"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <InfoBar x:Name="ErrorBar"
                         IsOpen="False"
                         Severity="Error"
                         FontFamily="Microsoft YaHei, PingFang SC" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
