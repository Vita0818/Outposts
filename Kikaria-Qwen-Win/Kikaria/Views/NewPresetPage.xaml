<Page
    x:Class="Kikaria.Views.NewPresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Background="Transparent"
                    Click="BackButton_Click" />

            <TextBlock Grid.Column="1"
                       Text="上传新预设"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Microsoft YaHei, PingFang SC"
                       x:Name="PageTitle" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="保存"
                    Height="36"
                    CornerRadius="12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"
                    FontFamily="Microsoft YaHei, PingFang SC" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,16,24,32" MaxWidth="700" HorizontalAlignment="Center">

                <controls:LiquidGlassCard x:Name="NameCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="预设名称"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="NameLabel" />
                        <TextBox x:Name="PresetNameBox"
                                 PlaceholderText="输入预设名称"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="CategoryCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="分类"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="CategoryLabel" />
                        <TextBox x:Name="CategoryBox"
                                 PlaceholderText="输入分类（可选）"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="ImportCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="导入 Markdown 文件"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="ImportLabel" />
                        <Button x:Name="ImportFileButton"
                                Content="选择文件 (.md / .txt)"
                                Height="40"
                                CornerRadius="12"
                                FontSize="14"
                                Click="ImportFile_Click"
                                FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBlock x:Name="ImportedFileName"
                                   Text=""
                                   FontSize="13"
                                   Opacity="0.5"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="EditorCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Markdown 内容"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="EditorLabel" />
                        <TextBox x:Name="MarkdownEditor"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="300"
                                 FontFamily="Cascadia Code, Consolas"
                                 FontSize="14"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="# 知识点标题&#x0a;&#x0a;tags: tag1, tag2&#x0a;&#x0a;hint:&#x0a;提示内容&#x0a;&#x0a;content:&#x0a;答案内容&#x0a;&#x0a;---" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <HyperlinkButton x:Name="FormatGuideLink"
                                 Content="查看 Markdown 格式说明 →"
                                 FontSize="14"
                                 Click="FormatGuide_Click"
                                 FontFamily="Microsoft YaHei, PingFang SC" />

                <InfoBar x:Name="ErrorBar"
                         IsOpen="False"
                         Severity="Error"
                         FontFamily="Microsoft YaHei, PingFang SC" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
