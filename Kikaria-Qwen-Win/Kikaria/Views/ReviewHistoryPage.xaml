<Page
    x:Class="Kikaria.Views.ReviewHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" Padding="24,32,24,32">
            <StackPanel Spacing="20" MaxWidth="700" HorizontalAlignment="Center">

                <TextBlock x:Name="TitleText"
                           Text="复习历史"
                           FontSize="28"
                           FontWeight="Bold"
                           FontFamily="Microsoft YaHei, PingFang SC" />

                <controls:LiquidGlassCard x:Name="CalendarCard"
                                          CardCornerRadius="22"
                                          Padding="20,16,20,20">
                    <StackPanel Spacing="12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PrevMonthButton"
                                    Grid.Column="0"
                                    Content="&#xE76B;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Background="Transparent"
                                    Click="PrevMonth_Click" />

                            <TextBlock x:Name="MonthYearTitle"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei, PingFang SC" />

                            <Button x:Name="NextMonthButton"
                                    Grid.Column="2"
                                    Content="&#xE76C;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Background="Transparent"
                                    Click="NextMonth_Click" />
                        </Grid>

                        <Grid x:Name="DayHeadersGrid" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Grid x:Name="CalendarGrid"
                              ColumnSpacing="4"
                              RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="DaySummaryCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20"
                                          Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="SummaryDateText"
                                   Text=""
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBlock x:Name="SummaryTotalText"
                                   Text=""
                                   FontSize="14"
                                   Opacity="0.7"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <StackPanel x:Name="SummaryBreakdownPanel" Spacing="6" Margin="0,4,0,0">
                            <Grid x:Name="BreakdownGrid" ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="EmptyDayCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20"
                                          Visibility="Collapsed">
                    <TextBlock Text="这一天还没有学习记录"
                               FontSize="15"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               FontFamily="Microsoft YaHei, PingFang SC" />
                </controls:LiquidGlassCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
