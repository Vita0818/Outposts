<Page
    x:Class="Kikaria.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Kikaria.Converters"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F4FC" Offset="0.0"/>
            <GradientStop Color="#FFE8F0FC" Offset="0.5"/>
            <GradientStop Color="#FFF4F8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#503898EC" Offset="0.0"/>
            <GradientStop Color="#3091E1E8" Offset="0.5"/>
            <GradientStop Color="#503898EC" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StartBtnGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF3898EC" Offset="0.0"/>
            <GradientStop Color="#FF30C4D8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3898EC" Offset="0.0"/>
            <GradientStop Color="#FF30C4D8" Offset="1.0"/>
        </LinearGradientBrush>

        <AcrylicBrush x:Key="GlassAcrylic" TintColor="White" TintOpacity="0.55" FallbackColor="#E8F0F8"/>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#B4FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NavCard" TargetType="Border">
            <Setter Property="Background" Value="#B4FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Storyboard x:Name="OrbitStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bubble1Rotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:02:30"/>
            <DoubleAnimation Storyboard.TargetName="Bubble2Rotate" Storyboard.TargetProperty="Angle"
                             From="90" To="450" Duration="0:02:30"/>
            <DoubleAnimation Storyboard.TargetName="Bubble3Rotate" Storyboard.TargetProperty="Angle"
                             From="180" To="540" Duration="0:02:30"/>
            <DoubleAnimation Storyboard.TargetName="Bubble4Rotate" Storyboard.TargetProperty="Angle"
                             From="270" To="630" Duration="0:02:30"/>
        </Storyboard>

        <Storyboard x:Name="BreatheStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Bubble1Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1.15" Duration="0:00:03"/>
            <DoubleAnimation Storyboard.TargetName="Bubble1Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1.15" Duration="0:00:03"/>
            <DoubleAnimation Storyboard.TargetName="Bubble2Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.85" To="1.1" Duration="0:00:04"/>
            <DoubleAnimation Storyboard.TargetName="Bubble2Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1.1" Duration="0:00:04"/>
            <DoubleAnimation Storyboard.TargetName="Bubble3Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.12" Duration="0:00:03.5"/>
            <DoubleAnimation Storyboard.TargetName="Bubble3Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.12" Duration="0:00:03.5"/>
            <DoubleAnimation Storyboard.TargetName="Bubble4Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1.08" Duration="0:00:04.5"/>
            <DoubleAnimation Storyboard.TargetName="Bubble4Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.88" To="1.08" Duration="0:00:04.5"/>
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,40">
            <Grid x:Name="RootGrid" MaxWidth="900" Margin="24,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="64" Margin="0,8,0,0">
                    <TextBlock Text="Kikaria"
                               FontFamily="Georgia, Palatino Linotype, serif"
                               FontSize="39" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF3898EC" Offset="0.0"/>
                                <GradientStop Color="#FF30C4D8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <Button x:Name="AvatarButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="AvatarButton_Click" Padding="0" Background="Transparent" BorderThickness="0">
                        <Grid Width="44" Height="44" CornerRadius="22">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3898EC" Offset="0.0"/>
                                    <GradientStop Color="#FF30C4D8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Height="260" Margin="0,16,0,8">
                    <Grid x:Name="OrbitContainer" Width="190" Height="190"
                          HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Grid Width="32" Height="32" RenderTransformOrigin="0.5,7.0"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="Bubble1Rotate" Angle="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse Width="32" Height="32" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Bubble1Scale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#FFC8F0DC" Opacity="0.7"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Grid Width="24" Height="24" RenderTransformOrigin="0.5,8.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="Bubble2Rotate" Angle="90"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Bubble2Scale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#FFDCC8F0" Opacity="0.6"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Grid Width="20" Height="20" RenderTransformOrigin="0.5,9.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="Bubble3Rotate" Angle="180"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Bubble3Scale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#FFC8ECD0" Opacity="0.65"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Grid Width="28" Height="28" RenderTransformOrigin="0.5,6.0"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="Bubble4Rotate" Angle="270"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Bubble4Scale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#FFF8F8FC" Opacity="0.8"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Button x:Name="StartButton" Width="190" Height="190"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="StartButton_Click" Padding="0" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="190" Height="190" CornerRadius="95">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3898EC" Offset="0.0"/>
                                                <GradientStop Color="#FF30C4D8" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Grid CornerRadius="95" Margin="3">
                                            <Grid.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF48A8F5" Offset="0.0"/>
                                                    <GradientStop Color="#FF48D8EC" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Grid.Background>
                                            <FontIcon Glyph="&#xE72A;" FontSize="56" Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Name="DateText" FontSize="15" Foreground="#FF646E80"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                            <TextBlock FontSize="13" Foreground="#FF949CAC"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif">
                                <Run Text="还剩 "/>
                                <Run x:Name="DaysLeftRun" FontFamily="Cascadia Code, Consolas, monospace" FontSize="15" FontWeight="SemiBold" Foreground="#FF3898EC"/>
                                <Run Text=" 天"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="MasteredRun" FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="28" FontWeight="Bold" Foreground="#FF34C759"/>
                            <TextBlock Text="/" FontSize="22" Foreground="#FFB0C8E0" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            <TextBlock x:Name="GoalRun" FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="22" Foreground="#FF949CAC" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="NavigateScope_Click" HorizontalAlignment="Stretch"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <Border Style="{StaticResource NavCard}" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="ScopeCountText" FontFamily="Cascadia Code, Consolas, monospace"
                                                   FontSize="26" FontWeight="Bold" Foreground="#FF3898EC"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="范围" FontSize="13" Foreground="#FF646E80"
                                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="1" Click="NavigateReinforcement_Click" HorizontalAlignment="Stretch"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <Border Style="{StaticResource NavCard}" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="ReinforcementCountText" FontFamily="Cascadia Code, Consolas, monospace"
                                                   FontSize="26" FontWeight="Bold" Foreground="#FF30C4D8"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="重点" FontSize="13" Foreground="#FF646E80"
                                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="2" Click="NavigateMastered_Click" HorizontalAlignment="Stretch"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <Border Style="{StaticResource NavCard}" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="MasteredCountText" FontFamily="Cascadia Code, Consolas, monospace"
                                                   FontSize="26" FontWeight="Bold" Foreground="#FF34C759"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="已掌握" FontSize="13" Foreground="#FF646E80"
                                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="#203898EC" Margin="0,4"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="16" Foreground="#FF949CAC" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PresetNameText" Grid.Column="1" FontSize="15" Foreground="#FF646E80"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4" ColumnSpacing="12" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="NavigatePresetSelection_Click" HorizontalAlignment="Stretch"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <Border Style="{StaticResource NavCard}" HorizontalAlignment="Stretch">
                            <Grid Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="20" Foreground="#FF3898EC" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="切换预设" FontSize="15" Foreground="#FF1C2028"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="#FF949CAC" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Grid.Column="1" Click="NavigateTodayOverview_Click" HorizontalAlignment="Stretch"
                            Padding="0" Background="Transparent" BorderThickness="0">
                        <Border Style="{StaticResource NavCard}" HorizontalAlignment="Stretch">
                            <Grid Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE707;" FontSize="20" Foreground="#FF30C4D8" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="今日概览" FontSize="15" Foreground="#FF1C2028"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="#FF949CAC" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <Grid x:Name="WideNavRow" Grid.Row="5" Visibility="Collapsed" Margin="0,0,0,16">
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
