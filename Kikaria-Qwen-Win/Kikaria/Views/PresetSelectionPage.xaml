<Page
    x:Class="Kikaria.Views.PresetSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F4FC" Offset="0.0"/>
            <GradientStop Color="#FFE8F0FC" Offset="0.5"/>
            <GradientStop Color="#FFF4F8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#503898EC" Offset="0.0"/>
            <GradientStop Color="#3091E1E8" Offset="0.5"/>
            <GradientStop Color="#503898EC" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="56" Padding="16,0">
            <Button Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="#FF3898EC"/>
            </Button>
            <TextBlock Text="选择预设" FontSize="22" FontWeight="Bold" Foreground="#FF1C2028"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" Margin="24,0,24,24" Spacing="12">

                <Button Click="UploadPreset_Click" HorizontalAlignment="Stretch"
                        Padding="0,16" CornerRadius="18" BorderThickness="1" BorderBrush="#303898EC"
                        Background="#B4FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="#FF3898EC"/>
                        <TextBlock Text="上传新预设" FontSize="15" Foreground="#FF3898EC"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <ItemsRepeater x:Name="PresetList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button Click="PresetItem_Click" Tag="{Binding}" HorizontalAlignment="Stretch"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <Border Background="#B4FFFFFF" BorderThickness="1" CornerRadius="22" Padding="20"
                                        HorizontalAlignment="Stretch">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#503898EC" Offset="0.0"/>
                                            <GradientStop Color="#3091E1E8" Offset="0.5"/>
                                            <GradientStop Color="#503898EC" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="24" Foreground="#FF3898EC"/>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#FF1C2028"
                                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#FF949CAC"
                                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Click="EditPreset_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#FF949CAC"/>
                                            </Button>
                                            <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="#FF949CAC"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
