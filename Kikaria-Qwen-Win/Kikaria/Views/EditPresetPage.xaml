<Page
    x:Class="Kikaria.Views.EditPresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Background="Transparent"
                    Click="BackButton_Click" />

            <TextBlock Grid.Column="1"
                       x:Name="PageTitle"
                       Text="编辑预设"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Microsoft YaHei, PingFang SC" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="保存"
                    Height="36"
                    CornerRadius="12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"
                    FontFamily="Microsoft YaHei, PingFang SC" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,16,24,32" MaxWidth="700" HorizontalAlignment="Center">

                <controls:LiquidGlassCard x:Name="NameCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="NameLabel"
                                   Text="预设名称"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="PresetNameBox"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="CategoryCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CategoryLabel"
                                   Text="分类"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="CategoryBox"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ExportMarkdownButton"
                            Content="导出 Markdown"
                            Height="40"
                            CornerRadius="12"
                            FontSize="14"
                            Click="ExportMarkdown_Click"
                            FontFamily="Microsoft YaHei, PingFang SC" />
                    <Button x:Name="EditRawMarkdownButton"
                            Content="编辑原始 Markdown"
                            Height="40"
                            CornerRadius="12"
                            FontSize="14"
                            Click="EditRawMarkdown_Click"
                            FontFamily="Microsoft YaHei, PingFang SC" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             PlaceholderText="搜索知识点..."
                             FontSize="14"
                             TextChanged="SearchBox_TextChanged"
                             FontFamily="Microsoft YaHei, PingFang SC" />

                    <Button x:Name="AddPointButton"
                            Grid.Column="1"
                            Content="&#xE710;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Height="36"
                            Width="36"
                            CornerRadius="12"
                            Margin="8,0,0,0"
                            Click="AddPoint_Click" />
                </Grid>

                <StackPanel x:Name="KnowledgePointsPanel" Spacing="8" />

                <Button x:Name="DeletePresetButton"
                        Content="删除预设"
                        Height="44"
                        CornerRadius="14"
                        FontSize="15"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        Click="DeletePreset_Click"
                        Visibility="Collapsed"
                        FontFamily="Microsoft YaHei, PingFang SC" />

            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="DeletePointDialog"
                       Title="删除知识点"
                       PrimaryButtonText="确认删除"
                       CloseButtonText="取消"
                       DefaultButton="Close">
            <TextBlock x:Name="DeletePointMessage"
                       TextWrapping="Wrap"
                       FontFamily="Microsoft YaHei, PingFang SC" />
        </ContentDialog>

        <ContentDialog x:Name="DeletePresetDialog"
                       Title="删除预设"
                       PrimaryButtonText="确认删除"
                       CloseButtonText="取消"
                       DefaultButton="Close">
            <TextBlock x:Name="DeletePresetMessage"
                       TextWrapping="Wrap"
                       FontFamily="Microsoft YaHei, PingFang SC" />
        </ContentDialog>

        <InfoBar x:Name="ErrorBar"
                 IsOpen="False"
                 Severity="Error"
                 VerticalAlignment="Bottom"
                 Margin="24"
                 FontFamily="Microsoft YaHei, PingFang SC" />
    </Grid>
</Page>
