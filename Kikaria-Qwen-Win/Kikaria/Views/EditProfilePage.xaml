<Page
    x:Class="Kikaria.Views.EditProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Background="Transparent"
                    Click="BackButton_Click" />

            <TextBlock Grid.Column="1"
                       x:Name="PageTitle"
                       Text="编辑个人资料"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Microsoft YaHei, PingFang SC" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="保存"
                    Height="36"
                    CornerRadius="12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"
                    FontFamily="Microsoft YaHei, PingFang SC" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Padding="24,16,24,32" MaxWidth="500" HorizontalAlignment="Center">

                <controls:LiquidGlassCard x:Name="AvatarCard"
                                          CardCornerRadius="22"
                                          Padding="32,28,32,28">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">

                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                            <Ellipse x:Name="AvatarBackground"
                                     Width="100"
                                     Height="100" />
                            <PersonPicture x:Name="AvatarPicture"
                                           Width="100"
                                           Height="100" />
                            <Border x:Name="AvatarOverlay"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="BottomRight"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="16"
                                    Margin="0,0,2,2">
                                <FontIcon Glyph="&#xE710;"
                                          FontSize="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White" />
                            </Border>
                            <Button x:Name="ChangePhotoButton"
                                    Width="100"
                                    Height="100"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="50"
                                    Click="ChangePhoto_Click"
                                    Opacity="0" />
                        </Grid>

                        <Button x:Name="ChangePhotoLabel"
                                Content="更换头像"
                                FontSize="14"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                Click="ChangePhoto_Click"
                                FontFamily="Microsoft YaHei, PingFang SC" />

                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="NameCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DisplayNameLabel"
                                   Text="显示名称"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="DisplayNameBox"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="UserIdCard"
                                          CardCornerRadius="16"
                                          Padding="20,16,20,16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="UserIdLabel"
                                   Text="用户 ID"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei, PingFang SC" />
                        <TextBox x:Name="UserIdBox"
                                 FontSize="15"
                                 FontFamily="Microsoft YaHei, PingFang SC" />
                    </StackPanel>
                </controls:LiquidGlassCard>

                <InfoBar x:Name="SuccessBar"
                         IsOpen="False"
                         Severity="Success"
                         Message="资料已保存"
                         FontFamily="Microsoft YaHei, PingFang SC" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
