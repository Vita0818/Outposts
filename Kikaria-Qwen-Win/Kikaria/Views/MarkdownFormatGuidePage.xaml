<Page
    x:Class="Kikaria.Views.MarkdownFormatGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Background="Transparent"
                    Click="BackButton_Click" />

            <TextBlock Grid.Column="1"
                       x:Name="PageTitle"
                       Text="Markdown 格式说明"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Microsoft YaHei, PingFang SC" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,16,24,32" MaxWidth="700" HorizontalAlignment="Center">

                <controls:LiquidGlassCard x:Name="IntroCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="简介"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="IntroTitle" />
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="22"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="IntroBody">
                            <Run Text="Kikaria 使用 Markdown 格式来组织知识点。每个知识点由标题、标签、提示和答案内容组成，知识点之间用 " />
                            <Run Text="---" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                            <Run Text=" 分隔。" />
                        </TextBlock>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="FormatCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="格式模板"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="FormatTitle" />
                        <Border CornerRadius="10"
                                Padding="16,14,16,14"
                                Background="#1A000000">
                            <TextBlock FontFamily="Cascadia Code, Consolas"
                                       FontSize="13"
                                       LineHeight="20"
                                       IsTextSelectionEnabled="True"
                                       x:Name="FormatCode">
# 知识点标题

tags: 标签1, 标签2

hint:
这里是提示信息，帮助你回忆。
可以包含 $LaTeX$ 公式。

content:
这里是完整的答案内容。
支持行内公式 $E = mc^2$ 和块级公式：

$$
\int_0^\infty e^{-x^2} dx = \frac{\sqrt{\pi}}{2}
$$

---
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="RulesCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="格式规则"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="RulesTitle" />
                        <StackPanel Spacing="6" x:Name="RulesList">
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">1.</Run>
                                <Run Text=" 每个知识点必须以 " />
                                <Run Text="# 标题" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                                <Run Text=" 开头" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">2.</Run>
                                <Run Text=" 标签行格式: " />
                                <Run Text="tags: tag1, tag2" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                                <Run Text="（可选）" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">3.</Run>
                                <Run Text=" 提示部分以 " />
                                <Run Text="hint:" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                                <Run Text=" 开头，后续行为提示内容" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">4.</Run>
                                <Run Text=" 内容部分以 " />
                                <Run Text="content:" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                                <Run Text=" 开头，后续行为答案内容" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">5.</Run>
                                <Run Text=" 知识点之间用 " />
                                <Run Text="---" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                                <Run Text=" 分隔（单独一行）" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">6.</Run>
                                <Run Text=" 行内公式使用单美元符号: " />
                                <Run Text="$E = mc^2$" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" FontFamily="Microsoft YaHei, PingFang SC">
                                <Run FontWeight="SemiBold">7.</Run>
                                <Run Text=" 块级公式使用双美元符号: " />
                                <Run Text="$$ ... $$" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" />
                                <Run Text="（各占一行）" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="LatexCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="LaTeX 公式示例"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="LatexTitle" />
                        <StackPanel Spacing="8">
                            <Border CornerRadius="10" Padding="14,10,14,10" Background="#1A000000">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="行内公式:" FontSize="13" Opacity="0.6" FontFamily="Microsoft YaHei, PingFang SC" />
                                    <TextBlock Text="$\sum_{i=1}^{n} i = \frac{n(n+1)}{2}$"
                                               FontFamily="Cascadia Code, Consolas" FontSize="13"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Padding="14,10,14,10" Background="#1A000000">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="块级公式:" FontSize="13" Opacity="0.6" FontFamily="Microsoft YaHei, PingFang SC" />
                                    <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="13"
                                               IsTextSelectionEnabled="True">
$$
f(x) = \frac{1}{\sigma\sqrt{2\pi}} e^{-\frac{(x-\mu)^2}{2\sigma^2}}
$$
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Padding="14,10,14,10" Background="#1A000000">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="矩阵:" FontSize="13" Opacity="0.6" FontFamily="Microsoft YaHei, PingFang SC" />
                                    <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="13"
                                               IsTextSelectionEnabled="True">
$$
\begin{pmatrix} a &amp; b \\ c &amp; d \end{pmatrix}
$$
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="ExampleCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="完整示例"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="ExampleTitle" />
                        <Border CornerRadius="10"
                                Padding="16,14,16,14"
                                Background="#1A000000">
                            <TextBlock FontFamily="Cascadia Code, Consolas"
                                       FontSize="13"
                                       LineHeight="20"
                                       IsTextSelectionEnabled="True"
                                       x:Name="ExampleCode">
# 牛顿第二定律

tags: 力学, 牛顿定律

hint:
力与加速度之间的关系，
想想 $F$、$m$、$a$ 三者的关系。

content:
牛顿第二定律表述为：

$$
F = ma
$$

其中 $F$ 是合力，$m$ 是质量，$a$ 是加速度。

力的单位是牛顿 (N)，$1\text{N} = 1\text{kg} \cdot \text{m/s}^2$。

---

# 动能定理

tags: 力学, 能量

hint:
合外力做功与动能变化的关系。

content:
动能定理：合外力所做的功等于物体动能的变化量。

$$
W = \Delta E_k = \frac{1}{2}mv_2^2 - \frac{1}{2}mv_1^2
$$
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </controls:LiquidGlassCard>

                <controls:LiquidGlassCard x:Name="AIPromptCard"
                                          CardCornerRadius="18"
                                          Padding="24,20,24,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="AI 生成提示词"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="AIPromptTitle" />
                        <TextBlock Text="将以下提示词发送给 AI，可以自动生成符合格式的知识点 Markdown："
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="AIPromptDesc" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    CornerRadius="10"
                                    Padding="14,10,14,10"
                                    Background="#1A000000">
                                <TextBlock x:Name="AIPromptText"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Text="请帮我把以下知识点整理成 Kikaria 格式的 Markdown。每个知识点需要包含标题（# 开头）、tags 标签、hint 提示（用于帮助回忆的线索，不要太直白）和 content 完整内容。知识点之间用 --- 分隔。支持 LaTeX 公式（行内用 $...$，块级用 $$...$$）。" />
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="CopyPromptButton"
                                    Content="复制"
                                    Height="36"
                                    CornerRadius="10"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Click="CopyPrompt_Click"
                                    FontFamily="Microsoft YaHei, PingFang SC" />
                        </Grid>
                    </StackPanel>
                </controls:LiquidGlassCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
