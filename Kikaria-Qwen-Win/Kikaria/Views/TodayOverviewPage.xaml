<Page
    x:Class="Kikaria.Views.TodayOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F4FC" Offset="0.0"/>
            <GradientStop Color="#FFE8F0FC" Offset="0.5"/>
            <GradientStop Color="#FFF4F8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#503898EC" Offset="0.0"/>
            <GradientStop Color="#3091E1E8" Offset="0.5"/>
            <GradientStop Color="#503898EC" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="56" Padding="16,0">
            <Button Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="#FF3898EC"/>
            </Button>
            <TextBlock Text="今日概览" FontSize="22" FontWeight="Bold" Foreground="#FF1C2028"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" Margin="24,0,24,24" Spacing="16">
                <Border Background="#B4FFFFFF" BorderThickness="1" CornerRadius="28" Padding="24"
                        BorderBrush="{StaticResource GlassStroke}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="今日学习统计" FontSize="13" FontWeight="SemiBold" Foreground="#FF949CAC"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="HintCountText" FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="28" FontWeight="Bold" Foreground="#FF3898EC"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="查看提示" FontSize="12" Foreground="#FF949CAC"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="AnswerCountText" FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="28" FontWeight="Bold" Foreground="#FF30C4D8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="查看答案" FontSize="12" Foreground="#FF949CAC"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="MasteredCountText" FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="28" FontWeight="Bold" Foreground="#FF34C759"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="已掌握" FontSize="12" Foreground="#FF949CAC"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#B4FFFFFF" BorderThickness="1" CornerRadius="28" Padding="24"
                        BorderBrush="{StaticResource GlassStroke}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="总体进度" FontSize="13" FontWeight="SemiBold" Foreground="#FF949CAC"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                        <TextBlock x:Name="ProgressText" FontSize="16" Foreground="#FF1C2028"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
