<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Kikaria.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Kikaria.Converters"
    xmlns:local="using:Kikaria">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibility" />
            <converters:ColorToBrushConverter x:Key="ColorToBrush" />
            <converters:DateToStringConverter x:Key="DateToString" />

            <Color x:Key="SkyLightColor">#64BAF5</Color>
            <Color x:Key="CyanLightColor">#91E1E8</Color>
            <Color x:Key="DeepTextColor">#214054</Color>
            <Color x:Key="SoftTextColor">#6B8A9E</Color>
            <Color x:Key="MasteredGreenColor">#5CC28A</Color>
            <Color x:Key="NextAmberColor">#8A7DBF</Color>
            <Color x:Key="RemoveCoralColor">#DB524D</Color>

            <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyLightColor}" />
            <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanLightColor}" />
            <SolidColorBrush x:Key="DeepTextBrush" Color="{StaticResource DeepTextColor}" />
            <SolidColorBrush x:Key="SoftTextBrush" Color="{StaticResource SoftTextColor}" />
            <SolidColorBrush x:Key="MasteredGreenBrush" Color="{StaticResource MasteredGreenColor}" />
            <SolidColorBrush x:Key="NextAmberBrush" Color="{StaticResource NextAmberColor}" />
            <SolidColorBrush x:Key="RemoveCoralBrush" Color="{StaticResource RemoveCoralColor}" />

            <LinearGradientBrush x:Key="PageGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EDFAFF" Offset="0.0" />
                <GradientStop Color="#DBF5FA" Offset="0.5" />
                <GradientStop Color="#F5FAFF" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ActionGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#59B8F7" Offset="0.0" />
                <GradientStop Color="#80DEE3" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="MasteredGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#63C78C" Offset="0.0" />
                <GradientStop Color="#ADE8C2" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NextGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C7B8F0" Offset="0.0" />
                <GradientStop Color="#9487CC" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="RemoveGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E66159" Offset="0.0" />
                <GradientStop Color="#FA9480" Offset="1.0" />
            </LinearGradientBrush>

            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">14</CornerRadius>

            <x:Double x:Key="AppTitleFontSize">34</x:Double>
            <x:Double x:Key="ChineseTitleFontSize">22</x:Double>
            <x:Double x:Key="ChineseHeadlineFontSize">18</x:Double>
            <x:Double x:Key="ChineseBodyFontSize">16</x:Double>
            <x:Double x:Key="TagFontSize">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
