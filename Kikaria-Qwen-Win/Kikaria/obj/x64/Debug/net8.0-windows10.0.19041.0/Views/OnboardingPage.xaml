<Page
    x:Class="Kikaria.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d">

    <Grid x:ConnectionId='2' x:Name="RootGrid">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="32"
                    Padding="32"
                    MaxWidth="500">

            <TextBlock x:ConnectionId='3' x:Name="AppTitleText"
                       Text="Kikaria"
                       FontSize="42"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI, SF Pro Display" />

            <controls:LiquidGlassCard x:ConnectionId='4' x:Name="OnboardingCard"
                                      CardCornerRadius="24"
                                      Padding="36,32,36,32"
                                      MinHeight="320">
                <Grid x:ConnectionId='7' x:Name="PageContentGrid">

                    <StackPanel x:ConnectionId='8' x:Name="Page1Content"
                                Spacing="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Ellipse x:ConnectionId='21' x:Name="Icon1Circle" Width="80" Height="80" />
                            <FontIcon x:ConnectionId='22' Glyph="&#xE82D;"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      x:Name="Icon1" />
                        </Grid>
                        <TextBlock x:ConnectionId='19' Text="选择一套预设"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="Page1Title" />
                        <TextBlock x:ConnectionId='20' Text="从数学、物理、计算机科学与英语预设开始，&#x0a;也可以上传自己的 Markdown 知识点。"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   Opacity="0.6"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="Page1Subtitle" />
                    </StackPanel>

                    <StackPanel x:ConnectionId='9' x:Name="Page2Content"
                                Spacing="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Ellipse x:ConnectionId='17' x:Name="Icon2Circle" Width="80" Height="80" />
                            <FontIcon x:ConnectionId='18' Glyph="&#xEA80;"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      x:Name="Icon2" />
                        </Grid>
                        <TextBlock x:ConnectionId='15' Text="先回忆，再查看"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="Page2Title" />
                        <TextBlock x:ConnectionId='16' Text="背诵时先看知识点名称，&#x0a;必要时查看提示，再查看答案。"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   Opacity="0.6"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="Page2Subtitle" />
                    </StackPanel>

                    <StackPanel x:ConnectionId='10' x:Name="Page3Content"
                                Spacing="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Ellipse x:ConnectionId='13' x:Name="Icon3Circle" Width="80" Height="80" />
                            <FontIcon x:ConnectionId='14' Glyph="&#xE73E;"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      x:Name="Icon3" />
                        </Grid>
                        <TextBlock x:ConnectionId='11' Text="整理你的学习状态"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="Page3Title" />
                        <TextBlock x:ConnectionId='12' Text="把不熟的内容加入重点集锦，&#x0a;把已经掌握的内容标记为已掌握。"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   Opacity="0.6"
                                   FontFamily="Microsoft YaHei, PingFang SC"
                                   x:Name="Page3Subtitle" />
                    </StackPanel>

                </Grid>
            </controls:LiquidGlassCard>

            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <StackPanel x:ConnectionId='5' x:Name="PageIndicators"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center" />

                <Button x:ConnectionId='6' x:Name="NextButton"
                        Content="下一步"
                        Width="200"
                        Height="48"
                        CornerRadius="16"
                        FontSize="17"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                                                
                        FontFamily="Microsoft YaHei, PingFang SC" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>

