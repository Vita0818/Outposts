<Page x:ConnectionId='1'
    x:Class="Kikaria.Views.MasteredPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kikaria.Models"
    xmlns:conv="using:Kikaria.Converters"
    mc:Ignorable="d"
                                  >

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F4FC" Offset="0.0"/>
            <GradientStop Color="#FFE8F0FC" Offset="0.5"/>
            <GradientStop Color="#FFF4F8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassStrokeGreen" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5034C759" Offset="0.0"/>
            <GradientStop Color="#305CC28A" Offset="0.5"/>
            <GradientStop Color="#5034C759" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MasteredGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF34C759" Offset="0.0"/>
            <GradientStop Color="#FF20A840" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCardGreen" TargetType="Border">
            <Setter Property="Background" Value="#B4FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="56" Padding="16,0">
            <Button x:ConnectionId='21'                          Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="#FF34C759"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,0,24,16" Spacing="12">
            <TextBlock Text="已掌握" FontSize="28" FontWeight="Bold" Foreground="#FF1C2028"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>

            <Border Style="{StaticResource GlassCardGreen}" Padding="16" CornerRadius="18">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18" Foreground="#FF949CAC" VerticalAlignment="Center"/>
                    <TextBox x:ConnectionId='20' x:Name="SearchBox" Grid.Column="1"
                             PlaceholderText="搜索知识点..."
                             Background="Transparent" BorderThickness="0"
                             FontSize="15" Foreground="#FF1C2028"
                             FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                                
                             Padding="0,4"/>
                </Grid>
            </Border>

            <Button x:ConnectionId='17' x:Name="StartReviewButton"                           HorizontalAlignment="Stretch"
                    MaxWidth="700" Padding="0,16" CornerRadius="18" BorderThickness="0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF34C759" Offset="0.0"/>
                        <GradientStop Color="#FF20A840" Offset="1.0"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72A;" FontSize="18" Foreground="White"/>
                    <TextBlock Text="开始复习" FontSize="17" Foreground="White" FontWeight="SemiBold"
                               FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                    <Border x:ConnectionId='18' x:Name="CountBadge" Background="#30FFFFFF" CornerRadius="10" Padding="8,2" Margin="4,0,0,0">
                        <TextBlock x:ConnectionId='19' x:Name="CountText" FontSize="13" Foreground="White"
                                   FontFamily="Cascadia Code, Consolas, monospace"/>
                    </Border>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid x:ConnectionId='4' x:Name="ContentRoot" MaxWidth="700" Margin="24,0,24,24">
                <StackPanel Spacing="12">
                    <Border x:ConnectionId='5' x:Name="EmptyState" Style="{StaticResource GlassCardGreen}" Visibility="Collapsed">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" Padding="20">
                            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="#FF91E1E8" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有已掌握" FontSize="17" Foreground="#FF949CAC"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                            <TextBlock Text="在背诵时标记已掌握的知识点会出现在这里" FontSize="13" Foreground="#FFB0C8E0"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ItemsRepeater x:ConnectionId='6' x:Name="CardList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate                                   >
                                <Border x:ConnectionId='8' Background="#B4FFFFFF" BorderThickness="1" CornerRadius="22" Padding="20">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5034C759" Offset="0.0"/>
                                            <GradientStop Color="#305CC28A" Offset="0.5"/>
                                            <GradientStop Color="#5034C759" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <TextBlock x:ConnectionId='10'                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#FF1C2028"
                                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <ItemsRepeater x:ConnectionId='11'                            >
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="6"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate                      >
                                                        <Border x:ConnectionId='15' Background="#2034C759" CornerRadius="8" Padding="8,2">
                                                            <TextBlock x:ConnectionId='16'                 FontSize="11" Foreground="#FF34C759"
                                                                       FontFamily="Segoe UI, sans-serif"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <TextBlock x:ConnectionId='12'                      FontSize="13" Foreground="#FF949CAC"
                                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2"/>

                                            <TextBlock x:ConnectionId='13'                         FontSize="13" Foreground="#FF646E80"
                                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="#2034C759" CornerRadius="10" Padding="8,4"
                                                    HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#FF34C759"/>
                                            </Border>

                                            <Button x:ConnectionId='9'                                          
                                                    Background="Transparent" BorderThickness="0" Padding="6"
                                                    HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="#FFFF453A"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:ConnectionId='2' x:Name="ToastBorder" Grid.Row="0" Grid.RowSpan="4"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#E01C2028" CornerRadius="14" Padding="20,10"
                Margin="0,70,0,0" Visibility="Collapsed">
            <TextBlock x:ConnectionId='3' x:Name="ToastText" FontSize="14" Foreground="White"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
        </Border>
    </Grid>
</Page>

