<Page x:ConnectionId='1'
    x:Class="Kikaria.Views.ScopeSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Kikaria.Converters"
    mc:Ignorable="d"
                                  >

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F4FC" Offset="0.0"/>
            <GradientStop Color="#FFE8F0FC" Offset="0.5"/>
            <GradientStop Color="#FFF4F8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#503898EC" Offset="0.0"/>
            <GradientStop Color="#3091E1E8" Offset="0.5"/>
            <GradientStop Color="#503898EC" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3898EC" Offset="0.0"/>
            <GradientStop Color="#FF30C4D8" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#B4FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="56" Padding="16,0">
            <Button x:ConnectionId='12'                          Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="#FF3898EC"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,0,24,16" Spacing="8">
            <TextBlock Text="选择范围" FontSize="28" FontWeight="Bold" Foreground="#FF1C2028"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
            <TextBlock x:ConnectionId='10' x:Name="SubtitleText" FontSize="15" Foreground="#FF646E80"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>

            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,8,0,0" CornerRadius="18">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18" Foreground="#FF949CAC" VerticalAlignment="Center"/>
                    <TextBox x:ConnectionId='11' x:Name="SearchBox" Grid.Column="1"
                             PlaceholderText="搜索标签..."
                             Background="Transparent" BorderThickness="0"
                             FontSize="15" Foreground="#FF1C2028"
                             FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                                
                             Padding="0,4"/>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid x:ConnectionId='3' x:Name="ContentRoot" MaxWidth="700" Margin="24,0">
                <StackPanel Spacing="12">
                    <Border x:ConnectionId='4' x:Name="EmptyState" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="20">
                            <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="#FFB0C8E0" HorizontalAlignment="Center"/>
                            <TextBlock Text="没有找到匹配的标签" FontSize="15" Foreground="#FF949CAC"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ItemsRepeater x:ConnectionId='5' x:Name="TagGrid">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="120" MinColumnSpacing="10" MinRowSpacing="10"
                                               ItemsStretch="None"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate                      >
                                <Button x:ConnectionId='7'                                      HorizontalAlignment="Stretch"
                                        Padding="0" Background="Transparent" BorderThickness="0">
                                    <Border x:Name="ChipBorder" CornerRadius="14" Padding="16,10"
                                            Background="#B4FFFFFF" BorderThickness="1" BorderBrush="#303898EC">
                                        <TextBlock x:ConnectionId='9'                 FontSize="14" Foreground="#FF3898EC"
                                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Padding="24,12,24,24">
            <Button x:ConnectionId='2'                          HorizontalAlignment="Stretch" MaxWidth="700"
                    Padding="0,16" CornerRadius="18" BorderThickness="0" Margin="0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF3898EC" Offset="0.0"/>
                        <GradientStop Color="#FF30C4D8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Button.Background>
                <TextBlock Text="完成" FontSize="17" Foreground="White" FontWeight="SemiBold"
                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</Page>

