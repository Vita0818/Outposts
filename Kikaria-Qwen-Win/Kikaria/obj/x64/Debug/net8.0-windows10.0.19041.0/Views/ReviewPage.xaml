<Page x:ConnectionId='1'
    x:Class="Kikaria.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Kikaria.ViewModels"
    xmlns:conv="using:Kikaria.Converters"
    xmlns:controls="using:Kikaria.Controls"
    mc:Ignorable="d"
                                  
                          >

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F4FC" Offset="0.0"/>
            <GradientStop Color="#FFE8F0FC" Offset="0.5"/>
            <GradientStop Color="#FFF4F8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#503898EC" Offset="0.0"/>
            <GradientStop Color="#3091E1E8" Offset="0.5"/>
            <GradientStop Color="#503898EC" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3898EC" Offset="0.0"/>
            <GradientStop Color="#FF30C4D8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MasteredGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF34C759" Offset="0.0"/>
            <GradientStop Color="#FF20A840" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AmberGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF9F0A" Offset="0.0"/>
            <GradientStop Color="#FFFF7F00" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CoralGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF453A" Offset="0.0"/>
            <GradientStop Color="#FFDC2828" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#B4FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ShortcutBadge" TargetType="Border">
            <Setter Property="Background" Value="#303898EC"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid x:ConnectionId='2' Background="{StaticResource PageBg}"
          ManipulationMode="TranslateX,TranslateY"
                                                            >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="56" Padding="16,0">
            <Button x:ConnectionId='36'                          Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="#FF3898EC"/>
            </Button>
            <TextBlock x:ConnectionId='37' x:Name="ModeLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold" Foreground="#FF646E80"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:ConnectionId='20' x:Name="ContentRoot" MaxWidth="700" Margin="24,0" HorizontalAlignment="Center">
                <StackPanel x:ConnectionId='21' x:Name="MainContent" Spacing="16">

                    <StackPanel x:ConnectionId='22' x:Name="EmptyState" Visibility="Collapsed" Spacing="16"
                                VerticalAlignment="Center" Margin="0,80,0,0">
                        <FontIcon Glyph="&#xE8FC;" FontSize="48" Foreground="#FFB0C8E0" HorizontalAlignment="Center"/>
                        <TextBlock Text="没有匹配的知识点" FontSize="18" Foreground="#FF646E80"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                        <TextBlock Text="尝试调整范围选择" FontSize="14" Foreground="#FF949CAC"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:ConnectionId='23' x:Name="ReinforcementCompleteState" Visibility="Collapsed" Spacing="16"
                                VerticalAlignment="Center" Margin="0,80,0,0">
                        <FontIcon Glyph="&#xE77B;" FontSize="48" Foreground="#FF34C759" HorizontalAlignment="Center"/>
                        <TextBlock Text="全部完成!" FontSize="22" FontWeight="Bold" Foreground="#FF34C759"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                        <TextBlock Text="所有重点知识点已复习完毕" FontSize="14" Foreground="#FF949CAC"
                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif" HorizontalAlignment="Center"/>
                        <Button x:ConnectionId='35'                          HorizontalAlignment="Center" Margin="0,8,0,0"
                                Padding="24,12" CornerRadius="14" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3898EC" Offset="0.0"/>
                                    <GradientStop Color="#FF30C4D8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="返回首页" Foreground="White" FontSize="15"
                                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:ConnectionId='24' x:Name="PointContent" Spacing="16">

                        <TextBlock x:ConnectionId='25' x:Name="PointTitle" FontFamily="Georgia, Palatino Linotype, serif"
                                   FontSize="28" FontWeight="SemiBold" Foreground="#FF1C2028"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <ItemsRepeater x:ConnectionId='26' x:Name="TagRepeater" HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                      >
                                    <Border x:ConnectionId='33' Background="#203898EC" CornerRadius="10" Padding="10,4">
                                        <TextBlock x:ConnectionId='34'                 FontSize="12" Foreground="#FF3898EC"
                                                   FontFamily="Segoe UI, sans-serif" FontWeight="Medium"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border HorizontalAlignment="Center" Background="#2034C759" CornerRadius="12" Padding="12,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="#FF34C759"/>
                                <TextBlock x:ConnectionId='31' x:Name="TodayCountText" FontSize="13" Foreground="#FF34C759"
                                           FontFamily="Cascadia Code, Consolas, monospace"/>
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='27' x:Name="HintCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="#20FF9F0A" CornerRadius="8" Padding="8,3">
                                        <TextBlock Text="提示" FontSize="12" FontWeight="SemiBold" Foreground="#FFFF9F0A"
                                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                                    </Border>
                                </StackPanel>
                                <controls:MathTextControl x:ConnectionId='30' x:Name="HintMathText"
                                    MathFontSize="16" TextColor="#FF1C2028"
                                    LineSpacing="12"/>
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='28' x:Name="AnswerCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="#2034C759" CornerRadius="8" Padding="8,3">
                                        <TextBlock Text="答案" FontSize="12" FontWeight="SemiBold" Foreground="#FF34C759"
                                                   FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
                                    </Border>
                                </StackPanel>
                                <controls:MathTextControl x:ConnectionId='29' x:Name="AnswerMathText"
                                    MathFontSize="16" TextColor="#FF1C2028"
                                    LineSpacing="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid x:ConnectionId='3' x:Name="ActionBar" Grid.Row="2" Padding="24,8,24,24">
            <Grid x:ConnectionId='6' x:Name="ActionContent" MaxWidth="700" HorizontalAlignment="Center">

                <StackPanel x:ConnectionId='7' x:Name="RevealActions" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:ConnectionId='18' Grid.Column="0"                        HorizontalAlignment="Stretch"
                                Padding="0,16" CornerRadius="16" BorderThickness="1" BorderBrush="#303898EC"
                                Background="#B4FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA80;" FontSize="18" Foreground="#FF3898EC"/>
                                <TextBlock Text="查看提示" FontSize="15" Foreground="#FF3898EC"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif" FontWeight="SemiBold"/>
                                <Border Style="{StaticResource ShortcutBadge}">
                                    <TextBlock Text="Space" FontSize="10" Foreground="#FF3898EC"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='19' Grid.Column="1"                          HorizontalAlignment="Stretch"
                                Padding="0,16" CornerRadius="16" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3898EC" Offset="0.0"/>
                                    <GradientStop Color="#FF30C4D8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="White"/>
                                <TextBlock Text="查看答案" FontSize="15" Foreground="White"
                                           FontFamily="Microsoft YaHei, PingFang SC, sans-serif" FontWeight="SemiBold"/>
                                <Border Background="#30FFFFFF" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Enter" FontSize="10" Foreground="White"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:ConnectionId='8' x:Name="PostRevealActions" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:ConnectionId='9' x:Name="Action1Button" Grid.Column="0"                      
                                HorizontalAlignment="Stretch" Padding="0,14" CornerRadius="16"
                                BorderThickness="1" BorderBrush="#303898EC" Background="#B4FFFFFF">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:ConnectionId='16' x:Name="Action1Icon" Glyph="&#xE73E;" FontSize="16" Foreground="#FF3898EC"/>
                                    <TextBlock x:ConnectionId='17' x:Name="Action1Text" FontSize="13" Foreground="#FF3898EC"
                                               FontFamily="Microsoft YaHei, PingFang SC, sans-serif" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Style="{StaticResource ShortcutBadge}">
                                    <TextBlock x:ConnectionId='15' x:Name="Action1Shortcut" FontSize="10" Foreground="#FF3898EC"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='10' x:Name="Action2Button" Grid.Column="1"                      
                                HorizontalAlignment="Stretch" Padding="0,14" CornerRadius="16"
                                BorderThickness="1" BorderBrush="#3034C759" Background="#B4FFFFFF">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:ConnectionId='13' x:Name="Action2Icon" Glyph="&#xE73E;" FontSize="16" Foreground="#FF34C759"/>
                                    <TextBlock x:ConnectionId='14' x:Name="Action2Text" FontSize="13" Foreground="#FF34C759"
                                               FontFamily="Microsoft YaHei, PingFang SC, sans-serif" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Background="#3034C759" CornerRadius="6" Padding="6,2" Margin="0" VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='12' x:Name="Action2Shortcut" FontSize="10" Foreground="#FF34C759"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='11' x:Name="NextButton" Grid.Column="2"                   
                                HorizontalAlignment="Stretch" Padding="0,14" CornerRadius="16" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFF9F0A" Offset="0.0"/>
                                    <GradientStop Color="#FFFF7F00" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72A;" FontSize="16" Foreground="White"/>
                                    <TextBlock Text="下一个" FontSize="13" Foreground="White"
                                               FontFamily="Microsoft YaHei, PingFang SC, sans-serif" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Background="#30FFFFFF" CornerRadius="6" Padding="6,2" Margin="0" VerticalAlignment="Center">
                                    <TextBlock Text="K" FontSize="10" Foreground="White"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:ConnectionId='4' x:Name="ToastBorder" Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#E01C2028" CornerRadius="14" Padding="20,10"
                Margin="0,70,0,0" Visibility="Collapsed">
            <TextBlock x:ConnectionId='5' x:Name="ToastText" FontSize="14" Foreground="White"
                       FontFamily="Microsoft YaHei, PingFang SC, sans-serif"/>
        </Border>
    </Grid>
</Page>

