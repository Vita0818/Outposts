{
  "$schema": "https://charm.land/crush.json",
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "glob",
      "job_output",
      "lsp_diagnostics",
      "lsp_references",
      "lsp_restart"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(edit|write|multiedit|bash)$",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./.crush/hooks/allow-workdir-or-build.ps1",
        "timeout": 5
      }
    ]
  }
}