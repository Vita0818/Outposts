<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LiquidGlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{ThemeResource SystemControlAcrylicElementMediumHighBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="White" Offset="0" Opacity="0.42" />
                    <GradientStop Color="White" Offset="0.76" Opacity="0.1" />
                    <GradientStop Color="{Binding Source={StaticResource KikariaTheme.GlassStrokeAccent}, Path=Color}" Offset="1" Opacity="0.13" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Color="{Binding Source={StaticResource KikariaTheme.Shadow}, Path=Color}"
                    Opacity="0.12"
                    Offset="0,10"
                    BlurRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidGlassButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Background" Value="{StaticResource KikariaTheme.ActionGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Color="{Binding Source={StaticResource KikariaTheme.Sky}, Path=Color}"
                    Opacity="0.3"
                    Offset="0,6"
                    BlurRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="54" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource KikariaTheme.DeepText}" />
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource KikariaTheme.DeepText}" />
    </Style>

    <Style x:Key="CardSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource KikariaTheme.SoftText}" />
    </Style>

</ResourceDictionary>