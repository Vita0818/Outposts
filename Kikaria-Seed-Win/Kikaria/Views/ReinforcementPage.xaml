<Page
    x:Class="Kikaria.Views.ReinforcementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Kikaria.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40" MaxWidth="800" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,40">
            <Button Content="← Back" Click="BackButton_Click" />
            <TextBlock Text="Reinforcement List" Style="{ThemeResource TitleTextBlockStyle}" Margin="20,0,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="ReinforcementListView" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:KnowledgePoint">
                    <Expander Header="{Binding Title}" Margin="0,10" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="20" Padding="20">
                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="15" CornerRadius="4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Hint:" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" Padding="15" CornerRadius="4">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Content:" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" />
                                </StackPanel>
                            </Border>

                            <Button Content="Remove from Reinforcement" 
                                    Tag="{Binding Id}" 
                                    Click="RemoveFromReinforcementButton_Click"
                                    HorizontalAlignment="Right" />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.EmptyContent>
                <TextBlock Text="No knowledge points in reinforcement list." HorizontalAlignment="Center" Margin="0,100,0,0" />
            </ListView.EmptyContent>
        </ListView>
    </Grid>
</Page>