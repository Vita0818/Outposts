<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.ReinforcementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="24,48,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button
                x:Name="BackButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="42"
                Height="42"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardSubtleFillBrush}"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Text="重点集锦"
            Style="{StaticResource PageTitleStyle}"
            Foreground="{ThemeResource DeepTextBrush}"
            Margin="0,14,0,12" />

        <!-- 搜索栏 -->
        <Border
            Grid.Row="2"
            CornerRadius="22"
            Background="{ThemeResource CardSubtleFillBrush}"
            BorderBrush="{ThemeResource GlassCardStrokeBrush}"
            BorderThickness="1"
            Padding="16,2,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource BlueGrayBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    PlaceholderText="搜索知识点"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{StaticResource KikariaSans}"
                    FontSize="15"
                    VerticalAlignment="Center"
                    TextChanged="OnSearchChanged" />
                <Button
                    x:Name="ClearSearchButton"
                    Grid.Column="2"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="34"
                    Height="34"
                    Background="Transparent"
                    Visibility="Collapsed"
                    Click="OnClearSearchClick">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" Margin="0,12,0,8" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <controls:GlassCard x:Name="EmptyCard" Visibility="Collapsed" CardRadius="30">
                    <StackPanel Spacing="12" Padding="10">
                        <FontIcon Glyph="&#xE7A3;" FontSize="40" Foreground="{ThemeResource SkyBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="还没有重点" Style="{StaticResource HeadlineStyle}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource DeepTextBrush}" TextAlignment="Center" />
                        <TextBlock Text="在背诵时查看答案后，可以把知识点加入这里。" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource SoftTextBrush}" TextAlignment="Center" />
                    </StackPanel>
                </controls:GlassCard>

                <controls:GlassCard x:Name="NoResultsCard" Visibility="Collapsed" CardRadius="30">
                    <StackPanel Spacing="12" Padding="10">
                        <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource SkyBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="没有找到相关知识点" Style="{StaticResource HeadlineStyle}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource DeepTextBrush}" TextAlignment="Center" />
                        <TextBlock Text="换个关键词试试看。" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource SoftTextBrush}" TextAlignment="Center" />
                    </StackPanel>
                </controls:GlassCard>

                <StackPanel x:Name="PointsPanel" Spacing="12" />
            </StackPanel>
        </ScrollViewer>

        <controls:GlassCard
            Grid.Row="4"
            CardRadius="28"
            ContentPadding="0"
            Margin="0,12,0,0">
            <Button
                Style="{StaticResource ActionButtonStyle}"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                Click="OnStartReviewClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="开始重点背诵" Style="{StaticResource HeadlineStyle}" FontSize="19" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StartCountText" Grid.Column="1" Style="{StaticResource NumberStyle}" FontSize="19" FontWeight="Bold" Foreground="{ThemeResource SkyBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </controls:GlassCard>
    </Grid>
</Page>
