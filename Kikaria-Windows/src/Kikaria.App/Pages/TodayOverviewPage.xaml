<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.TodayOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <ScrollViewer Padding="24,48,24,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="560" HorizontalAlignment="Stretch">
            <Grid>
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Click="OnBackClick">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
                </Button>
            </Grid>

            <StackPanel Spacing="6" Margin="0,10,0,0">
                <TextBlock
                    Text="今日概览"
                    Style="{StaticResource PageTitleStyle}"
                    Foreground="{ThemeResource DeepTextBrush}" />
                <TextBlock
                    x:Name="PresetNameText"
                    Style="{StaticResource BodyStyle}"
                    Foreground="{ThemeResource SoftTextBrush}" />
            </StackPanel>

            <controls:GlassCard CardRadius="30" ContentPadding="22">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="今日新增已掌握"
                        Style="{StaticResource SubHeadlineStyle}"
                        Foreground="{ThemeResource SoftTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Name="MarkedCountText"
                            Style="{StaticResource NumberStyle}"
                            FontSize="54"
                            FontWeight="Bold"
                            Foreground="{ThemeResource MasteredDeepGreenBrush}" />
                        <TextBlock
                            x:Name="GoalText"
                            Style="{StaticResource NumberStyle}"
                            FontSize="23"
                            Foreground="{ThemeResource SoftTextBrush}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,8" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ProgressMessageText"
                        Style="{StaticResource BodyStyle}"
                        Foreground="{ThemeResource DeepTextBrush}"
                        Opacity="0.85" />
                </StackPanel>
            </controls:GlassCard>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:GlassCard Grid.Row="0" Grid.Column="0" CardRadius="26" ContentPadding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="查看答案" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" />
                        <TextBlock x:Name="ReviewedCountText" Style="{StaticResource NumberStyle}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource SkyBrush}" />
                    </StackPanel>
                </controls:GlassCard>
                <controls:GlassCard Grid.Row="0" Grid.Column="1" CardRadius="26" ContentPadding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="总已掌握" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" />
                        <TextBlock x:Name="MasteredTotalText" Style="{StaticResource NumberStyle}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource MasteredGreenBrush}" />
                    </StackPanel>
                </controls:GlassCard>
                <controls:GlassCard Grid.Row="1" Grid.Column="0" CardRadius="26" ContentPadding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="查看提示" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" />
                        <TextBlock x:Name="HintCountText" Style="{StaticResource NumberStyle}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource CyanBrush}" />
                    </StackPanel>
                </controls:GlassCard>
                <controls:GlassCard Grid.Row="1" Grid.Column="1" CardRadius="26" ContentPadding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="倒数" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" />
                        <TextBlock x:Name="CountdownText" Style="{StaticResource NumberStyle}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource NextAmberBrush}" />
                    </StackPanel>
                </controls:GlassCard>
            </Grid>

            <controls:GlassCard CardRadius="26" ContentPadding="20,16,20,16">
                <Button
                    Style="{StaticResource ActionButtonStyle}"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Click="OnOpenHistoryClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="复习历史" Style="{StaticResource HeadlineStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="1" Glyph="&#xE787;" FontSize="17" Foreground="{ThemeResource SkyBrush}" Margin="0,0,8,0" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </controls:GlassCard>
        </StackPanel>
    </ScrollViewer>
</Page>
