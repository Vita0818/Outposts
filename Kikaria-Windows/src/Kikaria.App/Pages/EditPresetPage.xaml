<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.EditPresetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="24,48,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button
                x:Name="BackButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="42"
                Height="42"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardSubtleFillBrush}"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
            </Button>
            <TextBlock
                Text="编辑预设"
                Style="{StaticResource HeadlineStyle}"
                Foreground="{ThemeResource DeepTextBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <Button
                x:Name="SaveButton"
                Style="{StaticResource ActionButtonStyle}"
                Background="Transparent"
                Foreground="{ThemeResource SkyBrush}"
                Content="保存"
                MinHeight="42"
                Padding="10,6,10,6"
                HorizontalAlignment="Right"
                Click="OnSaveClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Stretch">
                <TextBox
                    x:Name="NameBox"
                    Header="预设名称"
                    Style="{StaticResource InputTextBoxStyle}" />
                <TextBox
                    x:Name="CategoryBox"
                    Header="分类"
                    Style="{StaticResource InputTextBoxStyle}" />

                <Button
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Foreground="{ThemeResource DeepTextBrush}"
                    Click="OnExportClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72D;" FontSize="15" />
                        <TextBlock Text="导出 Markdown" />
                    </StackPanel>
                </Button>

                <Button
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{ThemeResource ActionGradientBrush}"
                    Foreground="White"
                    Click="OnAddPointClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="15" />
                        <TextBlock Text="添加知识点" />
                    </StackPanel>
                </Button>

                <!-- 搜索栏 -->
                <Border
                    CornerRadius="22"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    BorderBrush="{ThemeResource GlassCardStrokeBrush}"
                    BorderThickness="1"
                    Padding="16,2,8,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource BlueGrayBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="搜索知识点"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="{StaticResource KikariaSans}"
                            FontSize="15"
                            VerticalAlignment="Center"
                            TextChanged="OnSearchChanged" />
                        <Button
                            x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Style="{StaticResource CircleButtonStyle}"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <controls:GlassCard x:Name="NoResultsCard" Visibility="Collapsed" CardRadius="26">
                    <StackPanel Spacing="10" Padding="8">
                        <FontIcon Glyph="&#xE721;" FontSize="34" Foreground="{ThemeResource SkyBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="没有找到相关知识点" Style="{StaticResource SubHeadlineStyle}" Foreground="{ThemeResource DeepTextBrush}" TextAlignment="Center" />
                        <TextBlock Text="换个关键词试试看。" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" TextAlignment="Center" />
                    </StackPanel>
                </controls:GlassCard>

                <StackPanel x:Name="PointsPanel" Spacing="12" />

                <Button
                    x:Name="DeletePresetButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Foreground="{ThemeResource RemoveCoralBrush}"
                    Content="删除此预设"
                    Margin="0,6,0,0"
                    Click="OnDeletePresetClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
