<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <ScrollViewer Padding="24,48,24,32" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="560" HorizontalAlignment="Stretch">

            <!-- 标题 + 关闭 -->
            <Grid>
                <TextBlock
                    Text="设置"
                    Style="{StaticResource PageTitleStyle}"
                    Foreground="{ThemeResource DeepTextBrush}"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="CloseButton"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource DeepTextBrush}" />
                </Button>
            </Grid>

            <!-- 个人资料 -->
            <controls:GlassCard CardRadius="30" ContentPadding="22">
                <StackPanel Spacing="12">
                    <Border
                        Width="86"
                        Height="86"
                        CornerRadius="999"
                        Background="{ThemeResource ActionGradientBrush}"
                        HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="AvatarInitialText"
                            Text="V"
                            Style="{StaticResource NumberStyle}"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="DisplayNameText"
                            Style="{StaticResource HeadlineStyle}"
                            FontSize="26"
                            Foreground="{ThemeResource DeepTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="HandleText"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="{ThemeResource SoftTextBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{ThemeResource CardSubtleFillBrush}"
                        Foreground="{ThemeResource DeepTextBrush}"
                        Content="编辑个人资料"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        Click="OnEditProfileClick" />
                </StackPanel>
            </controls:GlassCard>

            <!-- 学习 -->
            <controls:GlassCard CardRadius="28">
                <StackPanel Spacing="4">
                    <TextBlock Text="学习" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" Margin="4,0,0,6" />

                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnDailyGoalRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="每日学习目标" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DailyGoalValueText" Grid.Column="1" Style="{StaticResource NumberStyle}" FontSize="15" Foreground="{ThemeResource SoftTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 每日目标滚轮 -->
                    <StackPanel x:Name="DailyGoalPanel" Visibility="Collapsed" Spacing="10" Margin="4,8,4,8">
                        <controls:WheelPicker x:Name="DailyGoalPicker" />
                        <Button
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{ThemeResource ActionGradientBrush}"
                            Foreground="White"
                            Content="完成"
                            Click="OnDailyGoalDoneClick" />
                    </StackPanel>

                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />

                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnCountdownRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="倒数日" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CountdownValueText" Grid.Column="1" Style="{StaticResource NumberStyle}" FontSize="15" Foreground="{ThemeResource SoftTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 倒数日起止滚轮 -->
                    <StackPanel x:Name="CountdownPanel" Visibility="Collapsed" Spacing="12" Margin="4,8,4,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="开始日期" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:WheelPicker x:Name="StartYearPicker" Grid.Column="0" />
                                <controls:WheelPicker x:Name="StartMonthPicker" Grid.Column="1" />
                                <controls:WheelPicker x:Name="StartDayPicker" Grid.Column="2" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="结束日期" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:WheelPicker x:Name="EndYearPicker" Grid.Column="0" />
                                <controls:WheelPicker x:Name="EndMonthPicker" Grid.Column="1" />
                                <controls:WheelPicker x:Name="EndDayPicker" Grid.Column="2" />
                            </Grid>
                        </StackPanel>
                        <TextBlock
                            x:Name="CountdownErrorText"
                            Text="结束日期不能早于开始日期。"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="{ThemeResource RemoveCoralBrush}"
                            Visibility="Collapsed" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{ThemeResource CardSubtleFillBrush}"
                                Foreground="{ThemeResource DeepTextBrush}"
                                Content="清除"
                                Click="OnCountdownClearClick" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{ThemeResource ActionGradientBrush}"
                                Foreground="White"
                                Content="完成"
                                Click="OnCountdownDoneClick" />
                        </Grid>
                    </StackPanel>

                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />

                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnDangerRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="进度安全线" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DangerValueText" Grid.Column="1" Style="{StaticResource NumberStyle}" FontSize="15" Foreground="{ThemeResource SoftTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 安全线滚轮 -->
                    <StackPanel x:Name="DangerPanel" Visibility="Collapsed" Spacing="10" Margin="4,8,4,8">
                        <controls:WheelPicker x:Name="DangerPicker" />
                        <Button
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{ThemeResource ActionGradientBrush}"
                            Foreground="White"
                            Content="完成"
                            Click="OnDangerDoneClick" />
                    </StackPanel>

                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />

                    <TextBlock
                        x:Name="DangerStatusText"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{ThemeResource SoftTextBrush}"
                        TextWrapping="Wrap"
                        Margin="4,0,4,4" />
                </StackPanel>
            </controls:GlassCard>

            <!-- 通知 -->
            <controls:GlassCard CardRadius="28">
                <StackPanel Spacing="4">
                    <TextBlock Text="通知" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" Margin="4,0,0,6" />
                    <ToggleSwitch
                        x:Name="NotificationsToggle"
                        Header="学习进度通知"
                        FontFamily="{StaticResource KikariaSans}"
                        OnContent="学习进度通知"
                        OffContent="学习进度通知"
                        Toggled="OnNotificationsToggled" />

                    <StackPanel x:Name="NotificationTimeSection" Visibility="Collapsed" Spacing="8" Margin="4,6,4,0">
                        <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnNotificationTimeRowClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="通知时间" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="NotificationTimeValueText" Grid.Column="1" Style="{StaticResource NumberStyle}" FontSize="15" Foreground="{ThemeResource SoftTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="NotificationTimePanel" Visibility="Collapsed" Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:WheelPicker x:Name="NotifyHourPicker" Grid.Column="0" />
                                <controls:WheelPicker x:Name="NotifyMinutePicker" Grid.Column="1" />
                            </Grid>
                            <Button
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{ThemeResource ActionGradientBrush}"
                                Foreground="White"
                                Content="完成"
                                Click="OnNotificationTimeDoneClick" />
                        </StackPanel>

                        <TextBlock
                            x:Name="CountdownMissingText"
                            Text="需设置倒数日"
                            Style="{StaticResource CaptionStyle}"
                            Foreground="{ThemeResource SoftTextBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock
                        Text="Windows 版未接入系统通知：开关与时间仅保存在本机，进度提醒状态在下方展示。"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        Margin="4,8,4,4" />
                </StackPanel>
            </controls:GlassCard>

            <!-- 帮助 -->
            <controls:GlassCard CardRadius="28">
                <StackPanel Spacing="4">
                    <TextBlock Text="帮助" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" Margin="4,0,0,6" />
                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnOnboardingRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="新手引导" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />
                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnMarkdownGuideRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Markdown 格式" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </controls:GlassCard>

            <!-- 关于 -->
            <controls:GlassCard CardRadius="28">
                <StackPanel Spacing="4">
                    <TextBlock Text="关于" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" Margin="4,0,0,6" />
                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="18" HorizontalAlignment="Stretch" Click="OnPrivacyRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="隐私政策" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />
                    <Grid Padding="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版权声明" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="© 2026 Vita" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource SoftTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />
                    <Grid Padding="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource DeepTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="VersionValueText" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource SoftTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="4,6,4,6" />
                    <TextBlock
                        Text="浙ICP备2026034004号"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{ThemeResource SoftTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="4,6,4,6" />
                </StackPanel>
            </controls:GlassCard>
        </StackPanel>
    </ScrollViewer>
</Page>
