<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="24,48,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 头像(→ 设置) -->
        <Grid Grid.Row="0">
            <TextBlock
                Text="Kikaria"
                Style="{StaticResource AppTitleStyle}"
                Foreground="{ThemeResource DeepTextBrush}"
                VerticalAlignment="Center" />
            <Button
                x:Name="AvatarButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnAvatarClick">
                <Border Width="56" Height="56" CornerRadius="999" Background="{ThemeResource ActionGradientBrush}">
                    <TextBlock
                        x:Name="AvatarInitialText"
                        Text="V"
                        Style="{StaticResource NumberStyle}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </Button>
        </Grid>

        <!-- 开始背诵大按钮 -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <!-- 装饰气泡 -->
            <Border Width="64" Height="64" CornerRadius="999" Opacity="0.48" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-96,-118,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource CyanColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource BubbleMintColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="56" Height="56" CornerRadius="999" Opacity="0.42" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="102,-104,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource BubbleLavenderColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource MistColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="54" Height="54" CornerRadius="999" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="92,128,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource BubbleGreenColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource CyanColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button
                x:Name="StartReviewButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="190"
                Height="190"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="开始背诵"
                Click="OnStartReviewClick">
                <Grid>
                    <Border Width="190" Height="190" CornerRadius="999" Background="{ThemeResource ActionGradientBrush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                    <FontIcon Glyph="&#xE72A;" FontSize="64" Foreground="#F5FFFFFF" />
                </Grid>
            </Button>
        </Grid>

        <!-- 进度卡(→ 今日概览) + 仪表卡 -->
        <StackPanel Grid.Row="2" Spacing="16">
            <controls:GlassCard CardRadius="28" ContentPadding="20,18,20,18">
                <Button
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="Transparent"
                    Padding="0"
                    CornerRadius="28"
                    Click="OnProgressCardClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="HomeDateText"
                                Style="{StaticResource HeadlineStyle}"
                                FontSize="22"
                                Foreground="{ThemeResource DeepTextBrush}" />
                            <TextBlock
                                x:Name="HomeDaysLeftText"
                                Style="{StaticResource CaptionStyle}"
                                Foreground="{ThemeResource SoftTextBrush}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="HomeProgressText"
                            Grid.Column="1"
                            Style="{StaticResource NumberStyle}"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{ThemeResource MasteredDeepGreenBrush}"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </controls:GlassCard>

            <controls:GlassCard CardRadius="28" ContentPadding="0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="28,28,0,0" Click="OnScopeClick">
                            <StackPanel Spacing="6">
                                <TextBlock Text="范围" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ScopeCountText" Style="{StaticResource NumberStyle}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource SkyBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1" Background="{ThemeResource SeparatorBrush}" Margin="0,14,0,14" />
                        <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="0" Click="OnReinforcementClick">
                            <StackPanel Spacing="6">
                                <TextBlock Text="重点集锦" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ReinforcedCountText" Style="{StaticResource NumberStyle}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource CyanBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Background="{ThemeResource SeparatorBrush}" Margin="0,14,0,14" />
                        <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="0" Click="OnMasteredClick">
                            <StackPanel Spacing="6">
                                <TextBlock Text="已掌握" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MasteredCountText" Style="{StaticResource NumberStyle}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource MasteredGreenBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Background="{ThemeResource SeparatorBrush}" Height="1" Margin="14,0,14,0" />
                    <Button Style="{StaticResource ActionButtonStyle}" Background="Transparent" CornerRadius="0,0,28,28" HorizontalAlignment="Stretch" Click="OnPresetRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="PresetNameText" Style="{StaticResource SubHeadlineStyle}" Foreground="{ThemeResource DeepTextBrush}" />
                                <TextBlock Text="当前预设" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource SoftTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </controls:GlassCard>
        </StackPanel>
    </Grid>
</Page>
