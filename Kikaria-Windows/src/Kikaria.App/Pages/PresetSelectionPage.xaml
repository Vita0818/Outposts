<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.PresetSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="24,48,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button
                x:Name="BackButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="42"
                Height="42"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardSubtleFillBrush}"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Text="切换预设"
            Style="{StaticResource PageTitleStyle}"
            Foreground="{ThemeResource DeepTextBrush}"
            Margin="0,14,0,14" />

        <Button
            Grid.Row="2"
            Style="{StaticResource ActionButtonStyle}"
            Background="{ThemeResource ActionGradientBrush}"
            Foreground="White"
            Margin="0,0,0,6"
            Click="OnUploadNewPresetClick">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE710;" FontSize="15" />
                <TextBlock Text="上传新预设" />
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PresetListPanel" Spacing="14" />
        </ScrollViewer>
    </Grid>
</Page>
