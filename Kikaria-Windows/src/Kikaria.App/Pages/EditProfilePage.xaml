<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.EditProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="24,48,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button
                x:Name="BackButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="42"
                Height="42"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardSubtleFillBrush}"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
            </Button>
            <TextBlock
                Text="编辑个人资料"
                Style="{StaticResource HeadlineStyle}"
                Foreground="{ThemeResource DeepTextBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <Button
                x:Name="SaveButton"
                Style="{StaticResource ActionButtonStyle}"
                Background="Transparent"
                Foreground="{ThemeResource SkyBrush}"
                Content="保存"
                MinHeight="42"
                Padding="10,6,10,6"
                HorizontalAlignment="Right"
                Click="OnSaveClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="480" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Border
                        Width="92"
                        Height="92"
                        CornerRadius="999"
                        Background="{ThemeResource ActionGradientBrush}"
                        HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="AvatarInitialText"
                            Text="V"
                            Style="{StaticResource NumberStyle}"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Text="Windows 版使用文字头像(昵称首字母)"
                        Style="{StaticResource CaptionStyle}"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="14">
                    <TextBox
                        x:Name="DisplayNameBox"
                        Header="显示名称"
                        Style="{StaticResource InputTextBoxStyle}"
                        TextChanged="OnFieldChanged" />
                    <TextBox
                        x:Name="UserHandleBox"
                        Header="用户 ID"
                        Style="{StaticResource InputTextBoxStyle}"
                        TextChanged="OnFieldChanged" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
