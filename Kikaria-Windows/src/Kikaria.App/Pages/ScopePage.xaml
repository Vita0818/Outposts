<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.ScopePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="24,48,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button
                x:Name="BackButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="42"
                Height="42"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardSubtleFillBrush}"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,14">
            <TextBlock
                Text="选择范围"
                Style="{StaticResource PageTitleStyle}"
                Foreground="{ThemeResource DeepTextBrush}" />
            <TextBlock
                x:Name="SummaryText"
                Style="{StaticResource BodyStyle}"
                Foreground="{ThemeResource SoftTextBrush}" />
        </StackPanel>

        <!-- 搜索栏 -->
        <Border
            Grid.Row="2"
            CornerRadius="22"
            Background="{ThemeResource CardSubtleFillBrush}"
            BorderBrush="{ThemeResource GlassCardStrokeBrush}"
            BorderThickness="1"
            Padding="16,2,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource BlueGrayBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    PlaceholderText="搜索标签或知识点"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{StaticResource KikariaSans}"
                    FontSize="15"
                    VerticalAlignment="Center"
                    TextChanged="OnSearchChanged" />
                <Button
                    x:Name="ClearSearchButton"
                    Grid.Column="2"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="34"
                    Height="34"
                    Background="Transparent"
                    Visibility="Collapsed"
                    Click="OnClearSearchClick">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource BlueGrayBrush}" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <controls:GlassCard
                    x:Name="EmptyTagsCard"
                    Visibility="Collapsed"
                    CardRadius="30">
                    <StackPanel Spacing="12" Padding="10">
                        <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource SkyBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="没有找到相关标签" Style="{StaticResource HeadlineStyle}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource DeepTextBrush}" TextAlignment="Center" />
                        <TextBlock Text="换个关键词试试看。" Style="{StaticResource BodyStyle}" Foreground="{ThemeResource SoftTextBrush}" TextAlignment="Center" />
                    </StackPanel>
                </controls:GlassCard>

                <!-- 标签多选网格(代码构建,两列) -->
                <Grid x:Name="TagsGrid" Padding="0,4,0,8" />
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="4"
            Style="{StaticResource ActionButtonStyle}"
            Background="{ThemeResource ActionGradientBrush}"
            Foreground="White"
            Content="完成"
            Margin="0,10,0,0"
            Click="OnDoneClick" />
    </Grid>
</Page>
