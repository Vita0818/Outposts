<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikaria.App.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikaria.App.Controls"
    Background="{ThemeResource PageGradientBrush}">

    <Grid Padding="16,48,16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏:返回 / 上一个 / 范围 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Button
                x:Name="BackButton"
                Style="{StaticResource CircleButtonStyle}"
                Width="42"
                Height="42"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardSubtleFillBrush}"
                Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="15" Foreground="{ThemeResource DeepTextBrush}" />
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button
                    x:Name="PreviousButton"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="42"
                    Height="42"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Click="OnPreviousClick">
                    <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="{ThemeResource SkyBrush}" />
                </Button>
                <Button
                    x:Name="ScopeButton"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="42"
                    Height="42"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Click="OnScopeClick">
                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource SkyBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 空态:重点/已掌握清空 → 完成页;普通模式无匹配 → 提示 -->
        <StackPanel
            x:Name="CompletionPanel"
            Grid.Row="1"
            Spacing="28"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <FontIcon Glyph="&#xE73E;" FontSize="72" Foreground="{ThemeResource MasteredGreenBrush}" HorizontalAlignment="Center" />
            <Button
                Style="{StaticResource ActionButtonStyle}"
                Background="{ThemeResource ActionGradientBrush}"
                Foreground="White"
                Content="返回首页"
                Click="OnReturnHomeClick" />
        </StackPanel>

        <controls:GlassCard
            x:Name="EmptyStateCard"
            Grid.Row="1"
            Visibility="Collapsed"
            CardRadius="30"
            VerticalAlignment="Center">
            <StackPanel Spacing="12" Padding="10">
                <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource SkyBrush}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="暂无知识点"
                    Style="{StaticResource HeadlineStyle}"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{ThemeResource DeepTextBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    Text="请返回后调整选择范围。"
                    Style="{StaticResource BodyStyle}"
                    Foreground="{ThemeResource SoftTextBrush}"
                    TextAlignment="Center" />
            </StackPanel>
        </controls:GlassCard>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="16" Margin="0,8,0,16">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource NumberStyle}"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource DeepTextBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="TagsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />
                </ScrollViewer>

                <Border
                    x:Name="TodayPill"
                    Style="{StaticResource TagPillBorderStyle}"
                    HorizontalAlignment="Center"
                    Padding="18,8,18,8">
                    <TextBlock
                        x:Name="TodayPillText"
                        Style="{StaticResource TagTextStyle}"
                        Foreground="{ThemeResource DeepTextBrush}" />
                </Border>

                <controls:GlassCard x:Name="HintCard" Visibility="Collapsed" CardRadius="26" ContentPadding="18">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="提示"
                            Style="{StaticResource SubHeadlineStyle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{ThemeResource SkyBrush}" />
                        <controls:MathText x:Name="HintMath" MathFontSize="17" />
                    </StackPanel>
                </controls:GlassCard>

                <controls:GlassCard x:Name="AnswerCard" Visibility="Collapsed" CardRadius="26" ContentPadding="18">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="答案"
                            Style="{StaticResource SubHeadlineStyle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{ThemeResource SkyBrush}" />
                        <controls:MathText x:Name="AnswerMath" MathFontSize="17" />
                    </StackPanel>
                </controls:GlassCard>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部动作区 -->
        <StackPanel Grid.Row="2" Spacing="12" Margin="0,4,0,0">
            <!-- 揭示按钮(查看答案前) -->
            <StackPanel x:Name="RevealPanel" Spacing="12">
                <Button
                    x:Name="RevealHintButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{ThemeResource CardSubtleFillBrush}"
                    Foreground="{ThemeResource DeepTextBrush}"
                    Click="OnRevealHintClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7A3;" FontSize="16" />
                        <TextBlock Text="查看提示" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RevealAnswerButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{ThemeResource ActionGradientBrush}"
                    Foreground="White"
                    Click="OnRevealAnswerClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                        <TextBlock Text="查看答案" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 答案后的动作网格(按模式在代码里构建) -->
            <StackPanel x:Name="ActionPanel" Spacing="12" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
