<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kikaria.App.Controls.GlassCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 玻璃拟态卡片:Acrylic 背景(fillOpacity 0.48)+ 渐变描边(stroke 0.42)+ 彩色投影 -->
    <Grid>
        <Border
            x:Name="ShadowBorder"
            Background="{ThemeResource ShadowBrush}"
            CornerRadius="28"
            Opacity="0.12"
            Translation="0,6,0" />
        <Border
            x:Name="CardBorder"
            Background="{ThemeResource GlassCardBackgroundBrush}"
            BorderBrush="{ThemeResource GlassCardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="28">
            <ContentPresenter x:Name="CardContent" Margin="18" />
        </Border>
    </Grid>
</UserControl>
