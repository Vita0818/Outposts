    pickMarkdownFile() {
        try {
            const documentPicker = new picker.DocumentViewPicker();
            const pickOptions = new picker.DocumentSelectOptions();
            pickOptions.maxSelectNumber = 1;
            pickOptions.fileSuffixFilters = ['.md', '.txt', '.markdown'];
            documentPicker.select(pickOptions).then((uris) => {
                if (uris.length === 0) {
                    return;
                }
                const uri = uris[0];
                try {
                    const content = fileIo.readTextSync(uri);
                    if (content.length > 0) {
                        this.markdownText = content;
                        this.updateParsedCount();
                        const lastSep = Math.max(uri.lastIndexOf('/'), uri.lastIndexOf('\\'));
                        let filename = uri.substring(lastSep + 1);
                        const dotIdx = filename.lastIndexOf('.');
                        if (dotIdx > 0) {
                            filename = filename.substring(0, dotIdx);
                        }
                        if (this.name.trim().length === 0) {
                            this.name = filename;
                        }
                    }
                }
                catch (ioErr) {
                    this.errorMessage = 'è¯»å–æ–‡ä»¶å¤±è´¥ï¼Œè¯·æ£€æŸ¥æ–‡ä»¶æ ¼å¼ã€‚';
                }
            });
        }
        catch (e) {
            this.errorMessage = 'æ— æ³•æ‰“å¼€æ–‡ä»¶é€‰æ‹©å™¨ï¼Œè¯·é‡è¯•ã€‚';
        }
    }
    exportMarkdown() {
        try {
            const pasteData = pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, this.markdownText);
            pasteboard.getSystemPasteboard().setData(pasteData, () => {
                this.errorMessage = '';
                // show brief success via errorMessage as info
                this.errorMessage = `å·²å¤åˆ¶ ${this.parsedCount} æ¡çŸ¥è¯†ç‚¹åˆ°å‰ªè´´æ¿`;
                setTimeout(() => { if (this.errorMessage.indexOf('å·²å¤åˆ¶') >= 0) {
                    this.errorMessage = '';
                } }, 2000);
            });
        }
        catch (e) {
            this.errorMessage = 'å¤åˆ¶å¤±è´¥ï¼Œè¯·é‡è¯•';
        }
    }
    updateParsedCount() {
        if (this.markdownText.trim().length === 0) {
            this.parsedCount = 0;
            return;
        }
        try {
