            .fontSize(13)
            .fontColor(KikariaColors.SOFT_TEXT)
        }
        .width('100%')
        .padding({ left: 20, right: 20, top: 12, bottom: 12 })

        if (this.queueLength === 0) {
          // Empty state
          Column({ space: 16 }) {
            Text('æ²¡æœ‰å¾…å¤ä¹ çš„é¡¹ç›®')
              .fontSize(20)
              .fontWeight(FontWeight.Medium)
              .fontColor(KikariaColors.DEEP_TEXT)

            Text(this.getEmptyMessage())
              .fontSize(15)
              .fontColor(KikariaColors.SOFT_TEXT)
              .textAlign(TextAlign.Center)
              .padding({ left: 40, right: 40 })

            this.primaryButton('è¿”å›é¦–é¡µ', KikariaColors.ACTION_GRADIENT_START, KikariaColors.ACTION_GRADIENT_END, () => {
              navPathStack.pop()
            }, false)
          }
          .width('100%')
          .height('100%')
          .justifyContent(FlexAlign.Center)
          .padding(24)
        } else {
          // Review content
          Scroll() {
            if (this.useTwoColumn) {
              Row({ space: reviewLandscapeColumnSpacing() }) {
                Column() { this.readingColumn() }
                  .width(reviewLandscapeLeftWidth())
                Column() {
                  if (this.isContentVisible) { this.actionPanel() }
                }
                .width(reviewLandscapeRightWidth())
              }
              .width('100%')
              .constraintSize({ maxWidth: reviewLandscapeMaxWidth() })
              .justifyContent(FlexAlign.Center)
            } else {
              Column({ space: 18 }) {
                if (this.tags.length > 0) {
                  Row({ space: 8 }) {
                    ForEach(this.tags, (tag: string) => {
                      Text(tag)
                        .fontSize(12).fontWeight(FontWeight.Medium)
                        .fontColor(KikariaColors.SOFT_TEXT)
                        .backgroundColor(KikariaColors.MIST)
                        .borderRadius(8)
                        .padding({ left: 10, right: 10, top: 4, bottom: 4 })
                    })
                  }.width('100%').justifyContent(FlexAlign.Center)
                }
                Row() {
                  Text(`ä»Šæ—¥å¤ä¹ : ${this.todayReviewCount} æ¬¡`)
                    .fontSize(12).fontColor(KikariaColors.TERTIARY_TEXT)
                }.width('100%').justifyContent(FlexAlign.Center)

                Text(this.title)
                  .fontSize(32).fontWeight(FontWeight.Bold)
                  .fontColor(KikariaColors.DEEP_TEXT)
                  .textAlign(TextAlign.Center).width('100%').padding({ top: 8 })

                if (this.isHintVisible) {
                  this.revealCard('ğŸ’¡ æç¤º', KikariaColors.SKY, this.hint)
                } else {
                  this.primaryButton('ğŸ’¡ æŸ¥çœ‹æç¤º', KikariaColors.NEXT_GRADIENT_START, KikariaColors.NEXT_GRADIENT_END,
                    () => { appState.showHint(); this.refreshFromState() }, true)
                }
                if (this.isContentVisible) {
                  this.revealCard('ğŸ“– ç­”æ¡ˆ', KikariaColors.MASTERED_GREEN, this.content)
                  this.actionPanel()
                } else if (this.isHintVisible) {
                  this.primaryButton('ğŸ“– æŸ¥çœ‹ç­”æ¡ˆ', KikariaColors.ACTION_GRADIENT_START, KikariaColors.ACTION_GRADIENT_END,
                    () => { appState.showContent(); this.refreshFromState() }, true)
                }
                Row().height(40)
              }
              .width('100%')
              .constraintSize({ maxWidth: isPadLandscape() ? reviewMaxWidth() : '100%' })
            }
          }
          .width('100%')
          .layoutWeight(1)
          .scrollBar(BarState.Off)
          .align(Alignment.TopStart)
          .padding({ left: this.contentPadH, right: this.contentPadH })
        }
      }
      .width('100%')
      .height('100%')
      .backgroundColor(KikariaColors.PAGE_BG)
    }
    .hideTitleBar(true)
    .width('100%')
    .height('100%')
  }

  advanceOrFinish(): void {
    if (this.hasNext) {
      appState.nextPoint()
      setTimeout(() => {
        this.refreshFromState()
      }, 200)
    } else {
      navPathStack.pop()
    }
  }

  getModeTitle(): string {
    switch (this.reviewMode) {
      case ReviewMode.NORMAL:
        return 'å¤ä¹ '
      case ReviewMode.REINFORCEMENT:
        return 'é‡ç‚¹å¤ä¹ '
      case ReviewMode.MASTERED:
        return 'å·²æŒæ¡å›é¡¾'
    }
  }

  getEmptyMessage(): string {
    switch (this.reviewMode) {
      case ReviewMode.NORMAL:
        return 'å½“å‰èŒƒå›´å†…æ‰€æœ‰çŸ¥è¯†ç‚¹å‡å·²æŒæ¡ï¼è°ƒæ•´æ ‡ç­¾ç­›é€‰æˆ–ç»§ç»­å·©å›ºå§ã€‚'
      case ReviewMode.REINFORCEMENT:
        return 'é‡ç‚¹é›†é”¦ä¸­æš‚æ— é¡¹ç›®ã€‚åœ¨å¤ä¹ è¿‡ç¨‹ä¸­å°†é‡è¦çŸ¥è¯†ç‚¹åŠ å…¥é‡ç‚¹é›†é”¦å§ã€‚'
      case ReviewMode.MASTERED:
        return 'æš‚æ— å·²æŒæ¡çš„çŸ¥è¯†ç‚¹ã€‚ç»§ç»­å¤ä¹ ï¼ŒæŒæ¡æ›´å¤šçŸ¥è¯†å§ï¼'
    }
  }
}

@Entry
@Component
struct ReviewPage {
  build() {
    Navigation() {
      ReviewPageContent()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(KikariaColors.PAGE_BG)
    .hideTitleBar(true)
    .hideBackButton(true)
  }
}
