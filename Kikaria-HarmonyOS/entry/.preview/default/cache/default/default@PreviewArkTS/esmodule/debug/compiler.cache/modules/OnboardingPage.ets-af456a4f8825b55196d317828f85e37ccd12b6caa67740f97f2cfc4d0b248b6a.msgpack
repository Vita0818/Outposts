              if (this.currentPage > 0) { this.currentPage-- }
            })

          if (this.currentPage < 2) {
            Button('ä¸‹ä¸€æ­¥')
              .fontSize(15)
              .fontWeight(FontWeight.Medium)
              .fontColor('#FFFFFF')
              .linearGradient({
                angle: 135,
                colors: [[KikariaColors.ACTION_GRADIENT_START, 0], [KikariaColors.ACTION_GRADIENT_END, 1]]
              })
              .borderRadius(14)
              .height(44)
              .layoutWeight(1)
              .onClick(() => { this.currentPage++ })
          } else {
            Button('å¼€å§‹ä½¿ç”¨')
              .fontSize(15)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FFFFFF')
              .linearGradient({
                angle: 135,
                colors: [[KikariaColors.ACTION_GRADIENT_START, 0], [KikariaColors.ACTION_GRADIENT_END, 1]]
              })
              .borderRadius(14)
              .height(44)
              .layoutWeight(1)
              .shadow({ radius: 10, color: KikariaColors.SHADOW_COLOR, offsetY: 4 })
              .onClick(() => {
                appState.completeOnboarding()
                navPathStack.pop()
              })
          }
        }
        .width('100%')
        .constraintSize({ maxWidth: isPadLandscape() ? 760 : '100%' })
        .padding({ left: this.contentPadH, right: this.contentPadH, bottom: 24 })
      }
      .width('100%')
      .height('100%')
      .backgroundColor(KikariaColors.PAGE_BG)
    }
    .hideTitleBar(true)
    .width('100%')
    .height('100%')
  }
}

@Entry
@Component
struct OnboardingPage {
  build() {
    Navigation() {
      OnboardingPageContent()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(KikariaColors.PAGE_BG)
    .hideTitleBar(true)
    .hideBackButton(true)
  }
}
