          Text('â€¢ æ ‡é¢˜ä»¥ # å¼€å¤´ï¼Œåæ¥çŸ¥è¯†ç‚¹åç§°\nâ€¢ hint: å’Œ content: å¿…é¡»å„å ä¸€è¡Œï¼Œä»¥å†’å·ç»“å°¾\nâ€¢ æç¤ºå’Œç­”æ¡ˆçš„å†…å®¹ä»ä¸‹ä¸€è¡Œå¼€å§‹\nâ€¢ æ¯ä¸ªçŸ¥è¯†ç‚¹è‡³å°‘éœ€è¦æ ‡é¢˜ã€tagsã€hint å’Œ content\nâ€¢ æ ‡ç­¾æœ‰åŠ©äºåœ¨é¦–é¡µæŒ‰èŒƒå›´ç­›é€‰\nâ€¢ ä½¿ç”¨ --- åˆ†éš”ä¸åŒçš„çŸ¥è¯†ç‚¹')
            .fontSize(15).fontColor(KikariaColors.DEEP_TEXT).width('100%')
        }.width('100%')

        Row().height(40)
      }
      .width('100%')
      .constraintSize({ maxWidth: isPadLandscape() ? 760 : '100%' })
      .padding({ left: this.contentPadH, right: this.contentPadH })
    }
    .width('100%')
    .height('100%')
    .backgroundColor(KikariaColors.PAGE_BG)
    .scrollBar(BarState.Off)
  }
}

@Entry
@Component
struct MarkdownFormatGuidePage {
  build() {
    Navigation() {
      MarkdownFormatGuideContent()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(KikariaColors.PAGE_BG)
    .hideTitleBar(true)
    .hideBackButton(true)
  }
}
