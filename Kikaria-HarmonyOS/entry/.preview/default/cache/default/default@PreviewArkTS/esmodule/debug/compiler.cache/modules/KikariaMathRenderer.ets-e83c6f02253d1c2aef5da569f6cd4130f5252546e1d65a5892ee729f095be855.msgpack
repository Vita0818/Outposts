import { LatexTokenType, tokenizeLatex } from './KikariaLatexParser';
/** Convert a LaTeX math expression to Unicode for display. */
export function renderMathToUnicode(latex, isBlock = false) {
    let s = latex.trim();
    // Strip block delimiters if present
    if (s.startsWith('$$') && s.endsWith('$$') && s.length >= 4) {
