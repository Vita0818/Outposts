    s = replaceBracedCommand(s, '\\mathbf', (v) => v);
    s = replaceBracedCommand(s, '\\text', (v) => v);
    s = replaceBracedCommand(s, '\\bar', (v) => `${renderMathToUnicode(v)}Ì„`);
