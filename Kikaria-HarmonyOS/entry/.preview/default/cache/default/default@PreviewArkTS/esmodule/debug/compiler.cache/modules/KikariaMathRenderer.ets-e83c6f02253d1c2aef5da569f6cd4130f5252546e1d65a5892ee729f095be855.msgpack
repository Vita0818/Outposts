function extractBracedGroup(text, start) {
    if (start >= text.length || text[start] !== '{') {
        return null;
    }
    let cursor = start + 1;
    const begin = cursor;
    let depth = 1;
    while (cursor < text.length) {
        if (text[cursor] === '{') {
            depth++;
        }
        else if (text[cursor] === '}') {
            depth--;
            if (depth === 0) {
                const result = new BracedGroup();
                result.value = text.substring(begin, cursor);
                result.nextIdx = cursor + 1;
                return result;
            }
        }
        cursor++;
    }
    return null;
}
