        '\\begin{matrix}': '', '\\end{matrix}': '',
        '\\\\': '\n', '&': '  ', '\\qquad': '  ', '\\quad': ' ', '\\,': ' ', '\\;': ' ',
        '\\:': ' ', '\\!': '', '\\left': '', '\\right': '',
        '\\Bigg': '', '\\bigg': '', '\\Big': '', '\\big': '',
        // Integrals
        '\\iiint': 'âˆ«âˆ«âˆ«', '\\iint': 'âˆ«âˆ«', '\\int': 'âˆ«', '\\oint': 'âˆ®',
        // Sum, product, limit (with subscript rendering handled below)
        '\\sum': 'Î£', '\\prod': 'Î ', '\\coprod': 'âˆ',
        // Greek lowercase
        '\\alpha': 'Î±', '\\beta': 'Î²', '\\gamma': 'Î³', '\\delta': 'Î´',
        '\\epsilon': 'Îµ', '\\varepsilon': 'Îµ', '\\zeta': 'Î¶', '\\eta': 'Î·',
        '\\theta': 'Î¸', '\\vartheta': 'Ï‘', '\\iota': 'Î¹', '\\kappa': 'Îº',
        '\\lambda': 'Î»', '\\mu': 'Î¼', '\\nu': 'Î½', '\\xi': 'Î¾',
        '\\pi': 'Ï€', '\\varpi': 'Ï–', '\\rho': 'Ï', '\\varrho': 'Ï±',
        '\\sigma': 'Ïƒ', '\\varsigma': 'Ï‚', '\\tau': 'Ï„', '\\upsilon': 'Ï…',
        '\\phi': 'Ï†', '\\varphi': 'Ï•', '\\chi': 'Ï‡', '\\psi': 'Ïˆ', '\\omega': 'Ï‰',
        // Greek uppercase
        '\\Gamma': 'Î“', '\\Delta': 'Î”', '\\Theta': 'Î˜', '\\Lambda': 'Î›',
        '\\Xi': 'Î', '\\Pi': 'Î ', '\\Sigma': 'Î£', '\\Upsilon': 'Î¥',
        '\\Phi': 'Î¦', '\\Psi': 'Î¨', '\\Omega': 'Î©',
        // Operators
        '\\partial': 'âˆ‚', '\\nabla': 'âˆ‡', '\\infty': 'âˆ', '\\emptyset': 'âˆ…',
        '\\forall': 'âˆ€', '\\exists': 'âˆƒ', '\\neg': 'Â¬', '\\lnot': 'Â¬',
        // Relations
        '\\neq': 'â‰ ', '\\ne': 'â‰ ', '\\leq': 'â‰¤', '\\le': 'â‰¤',
        '\\geq': 'â‰¥', '\\ge': 'â‰¥', '\\to': 'â†’', '\\rightarrow': 'â†’',
        '\\leftarrow': 'â†', '\\Rightarrow': 'â‡’', '\\Leftrightarrow': 'â‡”',
        '\\approx': 'â‰ˆ', '\\equiv': 'â‰¡', '\\sim': 'âˆ¼', '\\propto': 'âˆ',
        '\\subset': 'âŠ‚', '\\subseteq': 'âŠ†', '\\supset': 'âŠƒ', '\\supseteq': 'âŠ‡',
        '\\in': 'âˆˆ', '\\notin': 'âˆ‰', '\\ni': 'âˆ‹',
        '\\parallel': 'âˆ¥', '\\perp': 'âŠ¥',
        // Binary ops
