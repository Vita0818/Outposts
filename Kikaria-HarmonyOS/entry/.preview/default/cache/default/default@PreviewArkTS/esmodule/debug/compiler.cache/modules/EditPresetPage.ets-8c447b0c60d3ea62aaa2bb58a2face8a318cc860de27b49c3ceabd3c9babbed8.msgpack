              .borderRadius(14)
              .backgroundColor(`${KikariaColors.SKY}10`)
              .border({ width: 1, color: `${KikariaColors.SKY}33`, style: BorderStyle.Dashed })
              .onClick(() => {
                navPathStack.pushPathByName('EditKnowledgePointPage', undefined)
              })

              // Knowledge point list
              if (this.filteredPoints.length === 0) {
                Column({ space: 8 }) {
                  Text(this.searchQuery.length > 0 ? 'æ²¡æœ‰åŒ¹é…çš„çŸ¥è¯†ç‚¹' : 'æš‚æ— çŸ¥è¯†ç‚¹')
                    .fontSize(15)
                    .fontColor(KikariaColors.SOFT_TEXT)
                }
                .width('100%')
                .padding(30)
                .justifyContent(FlexAlign.Center)
                .borderRadius(16)
                .backgroundColor(KikariaColors.CARD_BG_TRANSLUCENT)
                .backdropBlur(12)
              } else {
                ForEach(this.filteredPoints, (kp: KnowledgePoint) => {
                  Column({ space: 8 }) {
                    Row({ space: 8 }) {
                      Column({ space: 6 }) {
                        Row({ space: 8 }) {
                          Text(kp.title)
                            .fontSize(15)
                            .fontWeight(FontWeight.Medium)
                            .fontColor(KikariaColors.DEEP_TEXT)
                            .maxLines(2)
                            .textOverflow({ overflow: TextOverflow.Ellipsis })
                            .layoutWeight(1)

                          if (kp.isMastered) {
                            Text('âœ“')
                              .fontSize(12)
                              .fontWeight(FontWeight.Bold)
                              .fontColor(KikariaColors.MASTERED_GREEN)
                          }
                          if (kp.isReinforced) {
                            Text('â˜…')
                              .fontSize(12)
                              .fontColor(KikariaColors.NEXT_AMBER)
                          }
                        }

                        if (kp.tags.length > 0) {
                          Row({ space: 6 }) {
                            ForEach(kp.tags.slice(0, 4), (tag: string) => {
                              Text(tag)
                                .fontSize(10)
                                .fontColor(KikariaColors.SOFT_TEXT)
                                .backgroundColor(KikariaColors.MIST)
                                .borderRadius(6)
                                .padding({ left: 8, right: 8, top: 2, bottom: 2 })
                            })
                          }
                        }
                      }
                      .layoutWeight(1)
                      .alignItems(HorizontalAlign.Start)

                      Button() {
                        Text('âœ•')
                          .fontSize(14)
                          .fontColor(KikariaColors.REMOVE_CORAL)
                      }
                      .width(32)
                      .height(32)
                      .borderRadius(16)
                      .backgroundColor(`${KikariaColors.REMOVE_CORAL}10`)
                      .onClick(() => {
                        appState.deleteKnowledgePoint(kp.id)
                        this.refreshState()
                        this.showToast(`å·²åˆ é™¤: ${kp.title}`)
                      })
                    }
                    .width('100%')
                    .onClick(() => {
                      navPathStack.pushPathByName('EditKnowledgePointPage', new RouteParams(undefined, kp.id))
                    })

                    Divider()
                      .strokeWidth(0.5)
                      .color(KikariaColors.MIST)
                  }
                  .width('100%')
                  .padding(14)
                  .borderRadius(14)
                  .backgroundColor(KikariaColors.CARD_BG)
                  .shadow({ radius: 6, color: KikariaColors.SHADOW_COLOR, offsetY: 2 })
                  .margin({ bottom: 8 })
                })
              }

              // Delete preset button
              if (!appState.currentPreset.isBuiltIn && appState.presets.length > 1) {
                Column() {
                  Button('åˆ é™¤æ­¤é¢„è®¾')
                    .fontSize(15)
                    .fontWeight(FontWeight.Medium)
                    .fontColor('#FFFFFF')
                    .width('100%')
                    .height(48)
                    .borderRadius(14)
                    .backgroundColor(KikariaColors.REMOVE_CORAL)
                    .margin({ top: 16 })
                    .onClick(() => {
                      this.showDeletePresetConfirm = true
                    })
                }
                .width('100%')
              }

              Row().height(40)
            }
            .width('100%')
            .constraintSize({ maxWidth: isPadLandscape() ? 760 : '100%' })
            .padding({ left: this.contentPadH, right: this.contentPadH })
          }
          .width('100%')
          .layoutWeight(1)
          .scrollBar(BarState.Off)
        }
        .width('100%')
        .height('100%')
        .backgroundColor(KikariaColors.PAGE_BG)

        // Delete preset confirmation dialog
        if (this.showDeletePresetConfirm) {
          Column() {
            Column({ space: 16 }) {
              Text('åˆ é™¤é¢„è®¾')
                .fontSize(17)
                .fontWeight(FontWeight.Bold)
                .fontColor(KikariaColors.DEEP_TEXT)

              Text(`ç¡®å®šè¦åˆ é™¤ã€Œ${this.presetName}ã€å—ï¼Ÿæ­¤æ“ä½œä¸å¯æ’¤é”€ï¼Œæ‰€æœ‰è¯¥é¢„è®¾ä¸‹çš„å­¦ä¹ è¿›åº¦å°†ä¸¢å¤±ã€‚`)
                .fontSize(14)
                .fontColor(KikariaColors.SOFT_TEXT)
                .textAlign(TextAlign.Center)

              Row({ space: 12 }) {
                Button('å–æ¶ˆ')
                  .fontSize(15)
                  .fontWeight(FontWeight.Medium)
                  .fontColor(KikariaColors.SOFT_TEXT)
                  .backgroundColor(KikariaColors.MIST)
                  .borderRadius(12)
                  .height(42)
                  .layoutWeight(1)
                  .onClick(() => {
                    this.showDeletePresetConfirm = false
                  })

                Button('ç¡®è®¤åˆ é™¤')
                  .fontSize(15)
                  .fontWeight(FontWeight.Bold)
                  .fontColor('#FFFFFF')
                  .backgroundColor(KikariaColors.REMOVE_CORAL)
                  .borderRadius(12)
                  .height(42)
                  .layoutWeight(1)
                  .onClick(() => {
                    const success = appState.deletePreset(this.presetId)
                    this.showDeletePresetConfirm = false
                    if (success) {
                      navPathStack.pop()
                    } else {
                      this.showToast('æ— æ³•åˆ é™¤æœ€åä¸€ä¸ªé¢„è®¾')
                    }
                  })
              }
              .width('100%')
            }
            .width('80%')
            .padding(24)
            .borderRadius(20)
            .backgroundColor(KikariaColors.CARD_BG)
            .shadow({ radius: 24, color: KikariaColors.SHADOW_COLOR, offsetY: 8 })
          }
          .width('100%')
          .height('100%')
          .justifyContent(FlexAlign.Center)
          .backgroundColor(KikariaColors.OVERLAY_BG)
          .onClick(() => {
            this.showDeletePresetConfirm = false
          })
        }

        // Toast
        if (this.toastVisible) {
          Row() {
            Text(this.toastMessage)
              .fontSize(15)
              .fontColor('#FFFFFF')
              .padding({ left: 20, right: 20, top: 12, bottom: 12 })
          }
          .borderRadius(20)
          .backgroundColor(`${KikariaColors.DEEP_TEXT}E6`)
          .position({ top: 80, left: '10%' })
          .width('80%')
          .justifyContent(FlexAlign.Center)
        }
      }
      .width('100%')
      .height('100%')
    }
    .hideTitleBar(true)
    .width('100%')
    .height('100%')
  }
}

@Entry
@Component
struct EditPresetPage {
  build() {
    Navigation() {
      EditPresetPageContent()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(KikariaColors.PAGE_BG)
    .hideTitleBar(true)
    .hideBackButton(true)
  }
}
