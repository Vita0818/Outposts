}
export function homeLandscapeCardScale() {
    return Math.min(Math.max(homeLandscapeRightWidth() / 420, 1.0), 1.05);
}
export function reviewLandscapeMaxWidth() {
    return 1160;
}
export function reviewLandscapeAvailableWidth() {
    const w = getScreenWidthVP();
    return Math.max(0, Math.min(w - pageHorizontalPadding() * 2, reviewLandscapeMaxWidth()));
}
export function reviewLandscapeColumnSpacing() {
    const aw = reviewLandscapeAvailableWidth();
    return Math.min(Math.max(aw * 0.055, 48), 64);
}
export function reviewLandscapeRightWidth() {
    const aw = reviewLandscapeAvailableWidth();
    return Math.min(Math.max(aw * 0.32, 340), 380);
}
export function reviewLandscapeLeftWidth() {
    const aw = reviewLandscapeAvailableWidth();
    return Math.max(0, aw - reviewLandscapeRightWidth() - reviewLandscapeColumnSpacing());
}
export function settingsLandscapeMaxWidth() {
    return 1080;
}
export function settingsLandscapeAvailableWidth() {
