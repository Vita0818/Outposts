import display from "@ohos.display";
let _cachedWidthVP = 0;
let _cachedHeightVP = 0;
function refreshScreenMetrics() {
    try {
        const d = display.getDefaultDisplaySync();
        const w = d.width;
        const h = d.height;
        const density = d.densityPixels;
        _cachedWidthVP = density > 0 ? Math.round(w / density) : w;
        _cachedHeightVP = density > 0 ? Math.round(h / density) : h;
    }
    catch (e) {
        _cachedWidthVP = 390;
        _cachedHeightVP = 844;
    }
}
function getScreenWidthVP() {
    if (_cachedWidthVP <= 0) {
        refreshScreenMetrics();
    }
    return _cachedWidthVP;
}
function getScreenHeightVP() {
    if (_cachedHeightVP <= 0) {
        refreshScreenMetrics();
    }
    return _cachedHeightVP;
}
export function refreshLayoutCache() {
    refreshScreenMetrics();
}
// Width category matching KikariaAdaptiveLayout.WidthCategory
export function isTabletWidth() {
    return getScreenWidthVP() >= 600;
}
export function isPadLandscape() {
    return getScreenWidthVP() >= 900;
}
export function isPadPortrait() {
    return isTabletWidth() && getScreenHeightVP() >= getScreenWidthVP();
}
export function isTwoColumnCapable() {
    return getScreenWidthVP() >= 950 && getScreenWidthVP() > getScreenHeightVP();
}
/** Returns max content width in vp based on screen */
export function contentMaxWidth() {
    const w = getScreenWidthVP();
    if (w >= 900)
        return 760;
    if (w >= 600)
        return 600;
    return w;
}
/** Returns horizontal page padding */
export function pageHorizontalPadding() {
    const w = getScreenWidthVP();
    if (w >= 1200)
        return 40;
    if (w >= 900)
        return 40;
    if (w >= 600)
        return 32;
    return 24;
}
// ---- Scale factors matching iOS adaptive metrics ----
export function homeScale() {
    const w = getScreenWidthVP();
    const h = getScreenHeightVP();
    if (isPadPortrait())
        return w >= 900 ? 1.36 : 1.30;
    return isTabletWidth() ? 1.14 : 1.0;
}
export function homeHeaderScale() {
    const w = getScreenWidthVP();
    if (isPadPortrait())
        return w >= 900 ? 1.20 : 1.16;
    return isTabletWidth() ? 1.14 : 1.0;
}
export function reviewScale() {
    const w = getScreenWidthVP();
    if (isPadPortrait())
        return w >= 900 ? 1.20 : 1.18;
    return isTabletWidth() ? 1.15 : 1.0;
}
export function reviewButtonScale() {
    const w = getScreenWidthVP();
    if (isPadPortrait())
        return w >= 900 ? 1.18 : 1.14;
    return 1.0;
}
export function cardScale() {
    const w = getScreenWidthVP();
    if (isPadPortrait())
        return w >= 900 ? 1.24 : 1.18;
    return isTabletWidth() ? 1.05 : 1.0;
}
export function presetScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.18 : 1.12) : 1.0;
}
export function scopeScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.16 : 1.10) : 1.0;
}
export function overviewScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.18 : 1.12) : 1.0;
}
export function settingsScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.16 : 1.10) : 1.0;
}
export function settingsRowScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.14 : 1.08) : 1.0;
}
export function newPresetScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.16 : 1.10) : 1.0;
}
export function listCardScale() {
    const w = getScreenWidthVP();
    return isPadPortrait() ? (w >= 900 ? 1.16 : 1.10) : 1.0;
}
// ---- Two-column landscape layout constants ----
export function homeLandscapeMaxWidth() {
    return 1080;
}
export function homeLandscapeAvailableWidth() {
    const w = getScreenWidthVP();
    return Math.max(0, Math.min(w - pageHorizontalPadding() * 2, homeLandscapeMaxWidth()));
}
export function homeLandscapeColumnSpacing() {
    const aw = homeLandscapeAvailableWidth();
    return Math.min(Math.max(aw * 0.06, 56), 68);
}
export function homeLandscapeRightWidth() {
    const aw = homeLandscapeAvailableWidth();
    return Math.min(Math.max(aw * 0.39, 400), 430);
}
export function homeLandscapeLeftWidth() {
    const aw = homeLandscapeAvailableWidth();
    return Math.min(Math.max(aw - homeLandscapeRightWidth() - homeLandscapeColumnSpacing(), 410), 560);
}
export function homeLandscapeBubbleScale() {
