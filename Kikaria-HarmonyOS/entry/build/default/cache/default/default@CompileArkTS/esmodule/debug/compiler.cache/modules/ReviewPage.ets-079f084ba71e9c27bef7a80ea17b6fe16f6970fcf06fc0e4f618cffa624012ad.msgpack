                } else {
                  this.primaryButton('ğŸ’¡ æŸ¥çœ‹æç¤º', KikariaColors.NEXT_GRADIENT_START, KikariaColors.NEXT_GRADIENT_END,
                    () => { appState.showHint(); this.refreshFromState() }, true)
                }
                if (this.isContentVisible) {
