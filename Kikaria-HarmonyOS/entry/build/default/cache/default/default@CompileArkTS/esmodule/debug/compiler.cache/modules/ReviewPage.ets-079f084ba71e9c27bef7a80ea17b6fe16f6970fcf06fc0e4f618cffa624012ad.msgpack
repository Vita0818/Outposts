                }.width('100%').justifyContent(FlexAlign.Center)

                Text(this.title)
                  .fontSize(32).fontWeight(FontWeight.Bold)
                  .fontColor(KikariaColors.DEEP_TEXT)
                  .textAlign(TextAlign.Center).width('100%').padding({ top: 8 })

                if (this.isHintVisible) {
