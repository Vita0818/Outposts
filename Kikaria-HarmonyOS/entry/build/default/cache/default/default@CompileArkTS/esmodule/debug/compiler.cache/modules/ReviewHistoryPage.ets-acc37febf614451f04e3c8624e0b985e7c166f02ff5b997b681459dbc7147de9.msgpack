  activityIcon(type: StudyActivityType): string {
    switch (type) {
      case StudyActivityType.MARKED_MASTERED: return 'âœ“'
      case StudyActivityType.REMOVED_MASTERED: return 'â†©'
      case StudyActivityType.ADDED_REINFORCEMENT: return 'â˜…'
