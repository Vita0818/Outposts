@Entry
@Component
struct EditKnowledgePointPage {
  build() {
    Navigation() {
      EditKnowledgePointPageContent()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(KikariaColors.PAGE_BG)
    .hideTitleBar(true)
    .hideBackButton(true)
  }
}
