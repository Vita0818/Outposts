<Window x:Class="Intatis.Gui.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intatis Windows"
        Width="1024"
        Height="760"
        MinWidth="960"
        MinHeight="680">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="6">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Endpoint" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="BaseUrlBox" Width="300" Margin="0,0,12,0" />
                <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ModelBox" Width="180" Margin="0,0,12,0" />
                <TextBlock Text="Reasoning" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ReasoningBox" Width="130" Margin="0,0,12,0" />
                <CheckBox x:Name="UsageCheckBox" Content="Usage"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="API Key" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ApiKeyBox" Width="220" Margin="0,0,12,0" />
                <Button Width="105" Content="Save Config" Click="OnSaveConfigClick" />
            </DockPanel>
        </Border>

        <TabControl x:Name="ModeTabs" Grid.Row="1">
            <TabItem x:Name="ChatTab" Header="Chat">
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ChatHistory"
                             FontFamily="Consolas"
                             FontSize="14"
                             Margin="0,0,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <DockPanel Grid.Row="1">
                        <TextBox x:Name="ChatInput"
                                 Margin="0,0,8,0"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="78"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource CodeInput}" />
                        <Button Width="110" Content="Send" Click="OnChatSend" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="CodeTab" Header="Code">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Workspace" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="WorkspaceBox" Width="520" Margin="0,0,8,0" />
                        <Button Width="80" Content="Apply" Click="OnApplyWorkspace" />
                    </DockPanel>
                    <ListBox x:Name="CodeOutput"
                             Grid.Row="1"
                             FontFamily="Consolas"
                             FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBox x:Name="CodeInput"
                                 Margin="0,0,8,0"
                                 Height="80"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource CodeInput}" />
                        <Button Width="110" Content="Run" Click="OnCodeRun" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="CoworkTab" Header="Cowork">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="CoworkHistory"
                             FontFamily="Consolas"
                             FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBox x:Name="CoworkInput"
                                 Margin="0,0,8,0"
                                 Height="78"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource CodeInput}" />
                        <Button Width="110" Content="Send" Click="OnCoworkSend" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
