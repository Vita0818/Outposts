<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Intatis.App.Views.CodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Intatis.App.ViewModels">

    <Grid RowSpacing="6" Padding="0,20,0,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Workspace header: pick workspace, state + model. -->
        <Grid Grid.Row="0" Margin="20,0" ColumnSpacing="10" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.WorkspaceName, Mode=OneWay}" Style="{StaticResource HeadlineStyle}" />
                <TextBlock Text="{x:Bind ViewModel.AgentState, Mode=OneWay}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="New Session" Style="{StaticResource PillButtonStyle}" Click="OnNewSessionClick" />
            <Button Grid.Column="2" Content="Choose Workspace…" Style="{StaticResource PillButtonStyle}" Click="OnChooseWorkspaceClick" />
            <ComboBox
                Grid.Column="3"
                MinWidth="190"
                MaxWidth="260"
                ItemsSource="{x:Bind ViewModel.ModelOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,4">
            <ListView
                x:Name="Transcript"
                SelectionMode="None"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                MaxWidth="860"
                HorizontalAlignment="Stretch">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CodeItemVm">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind KindCaption}" Style="{StaticResource MetadataStyle}" />
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource MetadataStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Detail, Mode=OneWay}"
                                Style="{StaticResource ChatBodyStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Pending permission card (Layer C). -->
        <Border
            Grid.Row="2"
            Style="{StaticResource CardStyle}"
            CornerRadius="14"
            Margin="20,4"
            MaxWidth="860"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.PendingPermission, Mode=OneWay, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Permission request" Style="{StaticResource HeadlineStyle}" />
                    <Border CornerRadius="8" Padding="8,2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind ViewModel.PendingPermission.Risk, Mode=OneWay, FallbackValue=''}" Style="{StaticResource MetadataStyle}" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.PendingPermission.Agent, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.PendingPermission.Reason, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PendingPermission.Args, Mode=OneWay, FallbackValue=''}" Style="{StaticResource MonoStyle}" MaxHeight="120" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Allow" Style="{StaticResource PillButtonStyle}" Click="OnApproveClick" />
                    <Button Content="Decline" Style="{StaticResource PillButtonStyle}" Click="OnDeclineClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="3"
            Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
            Style="{StaticResource CaptionStyle}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="{x:Bind ViewModel.ErrorText, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}"
            Margin="20,2" />

        <!-- Composer -->
        <Grid Grid.Row="4" Margin="20,2,20,0" ColumnSpacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                Grid.Column="0"
                Style="{StaticResource ComposerInputStyle}"
                PlaceholderText="Ask the coder agent…"
                Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnInputKeyDown" />
            <Button
                Grid.Column="1"
                Content="Stop"
                Style="{StaticResource PillButtonStyle}"
                Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                Click="OnStopClick" />
            <Button
                Grid.Column="2"
                Content="Send"
                Style="{StaticResource PillButtonStyle}"
                Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert, FallbackValue=Visible}"
                Click="OnSendClick" />
        </Grid>
    </Grid>
</Page>
