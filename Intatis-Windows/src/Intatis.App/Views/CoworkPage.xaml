<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Intatis.App.Views.CoworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Intatis.App.ViewModels">

    <Grid Padding="0,20,0,14" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Cowork" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Workspace, Mode=OneWay}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="New Session…" Style="{StaticResource PillButtonStyle}" Click="OnNewSessionClick" />
            <Button Grid.Column="2" Content="Add Agent…" Style="{StaticResource PillButtonStyle}" Click="OnAddAgentClick" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14" Margin="20,4,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="348" />
            </Grid.ColumnDefinitions>

            <!-- Thread column -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ListView
                        x:Name="AgentThread"
                        SelectionMode="None"
                        ItemsSource="{x:Bind ViewModel.Thread, Mode=OneWay}">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,14" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageItemVm">
                                <Grid>
                                    <StackPanel
                                        Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Right"
                                        MaxWidth="560">
                                        <Border
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="16"
                                            Padding="15,11">
                                            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                       Style="{StaticResource ChatBodyStyle}"
                                                       Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel
                                        Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVis}, ConverterParameter=invert, FallbackValue=Visible}"
                                        Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Caption}" Style="{StaticResource MetadataStyle}" />
                                            <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource MetadataStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource ChatBodyStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- Pending permission card -->
                <Border
                    Grid.Row="1"
                    Style="{StaticResource RailCardStyle}"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.PendingPermission, Mode=OneWay, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Permission request" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PendingPermission.Tool, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.PendingPermission.Reason, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Allow" Style="{StaticResource PillButtonStyle}" Click="OnApproveClick" />
                            <Button Content="Decline" Style="{StaticResource PillButtonStyle}" Click="OnDeclineClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                    Style="{StaticResource CaptionStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind ViewModel.ErrorText, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />

                <!-- Composer -->
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="InputBox"
                        Grid.Column="0"
                        Style="{StaticResource ComposerInputStyle}"
                        PlaceholderText="Message @main, or @agent…"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnInputKeyDown" />
                    <Button
                        Grid.Column="1"
                        Content="Stop"
                        Style="{StaticResource PillButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Click="OnStopClick" />
                    <Button
                        Grid.Column="2"
                        Content="Send"
                        Style="{StaticResource PillButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert, FallbackValue=Visible}"
                        Click="OnSendClick" />
                </Grid>
            </Grid>

            <!-- Status rail: agents, reviewer, tasks. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Border Style="{StaticResource RailCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Agents" Style="{StaticResource HeadlineStyle}" />
                            <ListView
                                x:Name="AgentsList"
                                SelectionMode="Single"
                                ItemsSource="{x:Bind ViewModel.Agents, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedAgent, Mode=TwoWay}"
                                SelectionChanged="OnAgentSelected">

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgentRowVm">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="14" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStyle}" />
                                                <TextBlock Text="{x:Bind Model, Mode=OneWay}" Style="{StaticResource MetadataStyle}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RailCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Control plane" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ReviewerLabel, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RailCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Session tasks" Style="{StaticResource HeadlineStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TaskLines, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource MetadataStyle}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
