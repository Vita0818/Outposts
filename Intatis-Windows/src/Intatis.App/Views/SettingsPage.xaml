<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Intatis.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Intatis.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,24,0,20">
        <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Center" Margin="20,0">

            <TextBlock Text="Settings" Style="{StaticResource PageHeaderStyle}" />

            <!-- Provider catalog card. -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Provider list -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Providers" Style="{StaticResource HeadlineStyle}" />
                        <ListView
                            x:Name="ProvidersList"
                            SelectionMode="Single"
                            ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                            SelectionChanged="OnProviderSelected">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderVm">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyStyle}" />
                                        <TextBlock Text="{x:Bind ModelCountLabel, Mode=OneWay}" Style="{StaticResource MetadataStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="＋ Add provider" Style="{StaticResource PillButtonStyle}" Click="OnAddProviderClick" />
                    </StackPanel>

                    <!-- Provider editor -->
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="Provider details" Style="{StaticResource HeadlineStyle}" />
                        <TextBox
                            Header="Provider name"
                            Text="{x:Bind ViewModel.SelectedProvider.DisplayName, Mode=TwoWay, FallbackValue=''}" />
                        <TextBox
                            Header="API key source (read-only — edit the config file or auth.json)"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedProvider.KeyDescription, Mode=OneWay, FallbackValue=''}" />
                        <TextBox
                            Header="Base URL"
                            PlaceholderText="https://api.openai.com/v1"
                            Text="{x:Bind ViewModel.SelectedProvider.BaseUrl, Mode=TwoWay, FallbackValue=''}" />
                        <TextBox
                            Header="Chat endpoint override (optional)"
                            Text="{x:Bind ViewModel.SelectedProvider.ChatEndpoint, Mode=TwoWay, FallbackValue=''}" />

                        <TextBlock Text="Models" Style="{StaticResource HeadlineStyle}" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProvider.Models, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelRowVm">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="Model ID" Text="{x:Bind Id, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Header="Display name" Text="{x:Bind DisplayName, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Content="🗑"
                                            VerticalAlignment="Bottom"
                                            Click="OnDeleteModelClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ Add model" Style="{StaticResource PillButtonStyle}" Click="OnAddModelClick" />
                        <Button
                            Content="Delete provider"
                            Style="{StaticResource PillButtonStyle}"
                            Click="OnDeleteProviderClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Role routes summary -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Role routes" Style="{StaticResource HeadlineStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.RolesSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Role routes are managed in the Intatis JSON config (model, permission_reviewer_model, image_model, transcription_model, embedding_model, reranker_model)."
                        Style="{StaticResource MetadataStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save" Style="{StaticResource PillButtonStyle}" Click="OnSaveClick" />
                <Button Content="Test provider" Style="{StaticResource PillButtonStyle}" Click="OnTestProviderClick" />
                <Button Content="Reload from disk" Style="{StaticResource PillButtonStyle}" Click="OnReloadClick" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Configuration file -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Configuration" Style="{StaticResource HeadlineStyle}" />
                    <TextBlock
                        Text="{x:Bind ConfigPathText, Mode=OneWay}"
                        Style="{StaticResource MonoStyle}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <Button Content="Reveal in Explorer" Style="{StaticResource PillButtonStyle}" Click="OnRevealConfigClick" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
