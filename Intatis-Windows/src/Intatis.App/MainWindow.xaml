<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Intatis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Intatis">

    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="236"
        SelectionChanged="OnSelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Padding="16,20,16,14" Spacing="2">
                <TextBlock Text="Intatis" Style="{StaticResource BrandStyle}" />
                <TextBlock Text="Windows · local AI workspace" Style="{StaticResource MetadataStyle}" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Chat" Tag="chat">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Code" Tag="code">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE943;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Cowork" Tag="cowork">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE716;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
