<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Intatis.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Intatis.App"
    RequestedTheme="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <converters:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />

            <!-- Typography: 9 named roles ported from IntatisTypography. -->
            <FontFamily x:Key="IntatisSans">Segoe UI</FontFamily>
            <FontFamily x:Key="IntatisSerif">Georgia, Times New Roman, serif</FontFamily>
            <FontFamily x:Key="IntatisMono">Cascadia Code, Consolas</FontFamily>

            <Style x:Key="BrandStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSerif}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSerif}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HeadlineStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="BodyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ChatBodyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="MetadataStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="MonoStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IntatisMono}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Cards and rows. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="RailCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="SidebarRowStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,9" />
            </Style>

            <!-- Composer controls (control height 40, pill radius 20). -->
            <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style x:Key="ComposerInputStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource IntatisSans}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxHeight" Value="140" />
                <Setter Property="PlaceholderText" Value="Message Intatis…" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
