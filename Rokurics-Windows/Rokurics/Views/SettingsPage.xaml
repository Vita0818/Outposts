<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32,24" MaxWidth="600">
            <StackPanel Spacing="20">

                <TextBlock Text="设置"
                           Style="{StaticResource PageTitleStyle}" />

                <!-- Profile section -->
                <Border Style="{StaticResource RokuricsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="用户信息"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox Header="显示名称"
                                 Text="{x:Bind ViewModel.UserDisplayName, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <!-- AI Provider Settings -->
                <Border Style="{StaticResource RokuricsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AI 转写"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox Header="转写引擎"
                                  ItemsSource="{x:Bind ViewModel.TranscriptionProviderOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTranscriptionProvider, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RokuricsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="笔记生成"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox Header="笔记引擎"
                                  ItemsSource="{x:Bind ViewModel.NoteProviderOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedNoteProvider, Mode=TwoWay}" />

                        <!-- OpenAI settings -->
                        <TextBlock Text="OpenAI 兼容配置"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,8,0,0" />
                        <TextBox Header="Base URL"
                                 Text="{x:Bind ViewModel.OpenAiBaseUrl, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}"
                                 PlaceholderText="https://api.openai.com/v1" />
                        <TextBox Header="API Key"
                                 Text="{x:Bind ViewModel.OpenAiApiKey, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}"
                                 PlaceholderText="sk-..." />
                        <TextBox Header="Model Name"
                                 Text="{x:Bind ViewModel.OpenAiModelName, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}" />

                        <!-- Anthropic settings -->
                        <TextBlock Text="Anthropic 配置"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,8,0,0" />
                        <TextBox Header="Base URL"
                                 Text="{x:Bind ViewModel.AnthropicBaseUrl, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}" />
                        <TextBox Header="API Key"
                                 Text="{x:Bind ViewModel.AnthropicApiKey, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}" />
                        <TextBox Header="Model Name"
                                 Text="{x:Bind ViewModel.AnthropicModelName, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RokuricsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AI 对话"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox Header="对话引擎"
                                  ItemsSource="{x:Bind ViewModel.ChatProviderOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedChatProvider, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Connection settings -->
                <Border Style="{StaticResource RokuricsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Mac 连接"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox Header="Mac 地址"
                                 Text="{x:Bind ViewModel.MacAddress, Mode=TwoWay}"
                                 Style="{StaticResource RokuricsTextBoxStyle}" />
                        <NumberBox Header="端口"
                                   Value="{x:Bind ViewModel.MacPort, Mode=TwoWay}"
                                   Minimum="1" Maximum="65535" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="测试连接"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    Command="{x:Bind ViewModel.TestConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.ConnectionTestResult, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Save button -->
                <Button Content="保存设置"
                        Style="{StaticResource RokuricsAccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        HorizontalAlignment="Center"
                        Width="200"
                        Height="44" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
