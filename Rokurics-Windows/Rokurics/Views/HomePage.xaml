<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MaxWidth="520" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Recording status card -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource RokuricsCardStyle}"
                    Margin="0,0,0,12">
                <StackPanel Spacing="16">
                    <!-- Status -->
                    <TextBlock Text="录音"
                               Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" />

                    <!-- Elapsed time -->
                    <TextBlock Text="{x:Bind ViewModel.ElapsedDisplay, Mode=OneWay}"
                               FontSize="48"
                               FontWeight="Light"
                               FontFamily="{StaticResource RokuricsFontFamily}"
                               HorizontalAlignment="Center"
                               FontVariant="TabularNums" />

                    <!-- Record button -->
                    <Button Content="{x:Bind ViewModel.RecordingStateText, Mode=OneWay}"
                            Style="{StaticResource RokuricsAccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="ToggleRecording_Click"
                            Width="200"
                            Height="44" />
                </StackPanel>
            </Border>

            <!-- Recording list -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource RokuricsCardStyle}"
                    Margin="0,12,0,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="录音记录"
                               Style="{StaticResource SectionTitleStyle}" />

                    <ListView ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                            <Run Text="{Binding CreatedAt}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Duration}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="{Binding UploadStatus}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Quick action cards -->
            <Border Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource RokuricsCardStyle}"
                    Margin="0,0,0,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="快捷操作"
                               Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="学习库"
                                Style="{StaticResource RokuricsButtonStyle}"
                                Click="NavigateToLibrary_Click" />
                        <Button Content="AI 对话"
                                Style="{StaticResource RokuricsButtonStyle}"
                                Click="NavigateToChat_Click" />
                        <Button Content="设置"
                                Style="{StaticResource RokuricsButtonStyle}"
                                Click="NavigateToSettings_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
