<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rokurics.Views.FolderColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource RokuricsCardStyle}"
            Padding="16" CornerRadius="18">
        <StackPanel Spacing="14">

            <!-- Header -->
            <TextBlock Text="选择文件夹颜色"
                       FontSize="14" FontWeight="SemiBold" />

            <!-- Current selection preview -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border x:Name="PreviewSwatch"
                        Width="36" Height="36"
                        CornerRadius="10"
                        Background="#007AFF" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="ColorNameBlock"
                               Text="蓝色"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ColorTokenBlock"
                               Text="Blue"
                               FontSize="11" Opacity="0.4" />
                </StackPanel>
            </StackPanel>

            <!-- Color swatch grid (4x3 = 12 colors + default) -->
            <ItemsControl x:Name="SwatchGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid MaximumRowsOrColumns="4"
                                              ItemWidth="52" ItemHeight="52"
                                              Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="44" Height="44"
                                CornerRadius="12"
                                Background="{Binding Brush}"
                                Tag="{Binding Token}"
                                PointerPressed="Swatch_PointerPressed"
                                Margin="4">
                            <!-- Selection ring -->
                            <Border x:Name="SelectionRing"
                                    BorderBrush="White"
                                    BorderThickness="0"
                                    CornerRadius="14"
                                    Margin="-3" />
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding ChineseName}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EnglishName}"
                                                   FontSize="10" Opacity="0.5" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Divider -->
            <Rectangle Height="0.5"
                       Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                       Opacity="0.5" />

            <!-- Actions: Reset + Confirm -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="恢复默认"
                        FontSize="12"
                        Click="ResetToDefault_Click"
                        HorizontalAlignment="Left" />

                <Button x:Name="ConfirmButton"
                        Grid.Column="2"
                        Content="确认"
                        Style="{StaticResource RokuricsAccentButtonStyle}"
                        FontSize="12" Padding="14,8"
                        Click="Confirm_Click" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
