<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="≡"
                    Style="{StaticResource RokuricsIconButtonStyle}"
                    Click="ToggleConversationList_Click"
                    FontSize="18" />

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.ActiveConversation.Title, Mode=OneWay, FallbackValue='新对话'}"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <Button Grid.Column="2"
                    Content="✚"
                    Style="{StaticResource RokuricsIconButtonStyle}"
                    Click="NewConversation_Click"
                    FontSize="16" />
        </Grid>

        <!-- Sidebar + chat area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Conversation list sidebar -->
            <Border Grid.Column="0"
                    Width="260"
                    Style="{StaticResource RokuricsCardStyle}"
                    Visibility="{x:Bind ViewModel.ShowConversationList, Mode=OneWay}"
                    Margin="0,0,8,0"
                    Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="最近对话"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,8" />

                    <ListView ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8,6" Spacing="4">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UpdatedAt}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Messages area -->
            <ScrollViewer Grid.Column="1" x:Name="MessagesScrollViewer">
                <StackPanel Padding="24,16" Spacing="16" MaxWidth="780">
                    <!-- Greeting -->
                    <TextBlock Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}"
                               FontSize="28"
                               FontWeight="Light"
                               FontFamily="{StaticResource RokuricsFontFamily}"
                               HorizontalAlignment="Center"
                               Margin="0,80,0,20"
                               Opacity="0.6"
                               Visibility="{x:Bind ViewModel.ActiveConversation, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" />

                    <!-- Messages -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveMessages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="{Binding Role, Converter={StaticResource ChatRoleToAlignmentConverter}}"
                                      MaxWidth="600">
                                    <Border Background="{Binding Role, Converter={StaticResource ChatRoleToBackgroundConverter}}"
                                            CornerRadius="12"
                                            Padding="14,10">
                                        <TextBlock Text="{Binding Content}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading indicator -->
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                 Height="2" />

                    <!-- Error -->
                    <Border Background="#22FF453A"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Foreground="#FF453A"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Input bar -->
        <Border Grid.Row="2"
                Style="{StaticResource RokuricsCardStyle}"
                Margin="24,12,24,20"
                Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.DraftMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="消息"
                         Style="{StaticResource RokuricsTextBoxStyle}"
                         AcceptsReturn="True"
                         MaxHeight="120"
                         IsEnabled="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />

                <Button Grid.Column="1"
                        Content="↑"
                        Style="{StaticResource RokuricsAccentButtonStyle}"
                        Width="40"
                        Height="40"
                        FontSize="18"
                        Click="Send_Click"
                        IsEnabled="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
