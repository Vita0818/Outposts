<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.MacSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Rokurics.Views">

    <Page.Resources>
        <DataTemplate x:Key="SettingsRowTemplate" x:DataType="views:SettingsRowItem">
            <StackPanel Spacing="0">
                <Button Padding="18,15"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource RokuricsButtonStyle}"
                        Background="Transparent"
                        HorizontalContentAlignment="Stretch"
                        Click="SettingsRow_Click"
                        Tag="{x:Bind ActionTag}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Value}" FontSize="14" Opacity="0.5" />
                            <TextBlock Text="›" FontSize="12" Opacity="0.3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                           Margin="18,0,0,0"
                           Visibility="{x:Bind SeparatorVisibility}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource RokuricsPageGradientBrush}">
        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="1040" Spacing="18">

                <TextBlock Text="设置"
                           Style="{StaticResource PageTitleStyle}" />

                <!-- Profile pane + Settings list side-by-side -->
                <Grid ColumnSpacing="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" MaxWidth="610" />
                    </Grid.ColumnDefinitions>

                    <!-- Profile pane -->
                    <Border Grid.Column="0"
                            Style="{StaticResource RokuricsGlassCardStyle}"
                            Padding="24,26" CornerRadius="22">
                        <StackPanel Spacing="13" HorizontalAlignment="Center">
                            <Border Width="96" Height="96"
                                    CornerRadius="48"
                                    Background="{StaticResource RokuricsActionGradientBrush}"
                                    HorizontalAlignment="Center">
                                <PersonPicture Width="88" Height="88"
                                               Initials="{x:Bind UserInitials, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind UserDisplayName, Mode=OneWay}"
                                       FontSize="30" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind UserHandle, Mode=OneWay}"
                                       FontSize="15" Opacity="0.5"
                                       HorizontalAlignment="Center" />
                            <Button Content="编辑个人资料"
                                    Style="{StaticResource RokuricsGlassCapsuleStyle}"
                                    FontSize="13"
                                    Click="EditProfile_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Settings groups -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <!-- Transcription Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="转写" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />
                                <ItemsControl x:Name="TranscriptionRows"
                                              ItemTemplate="{StaticResource SettingsRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- AI Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="AI" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />
                                <ItemsControl x:Name="AIRows"
                                              ItemTemplate="{StaticResource SettingsRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- About Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />
                                <ItemsControl x:Name="AboutRows"
                                              ItemTemplate="{StaticResource SettingsRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
