<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.MacSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource RokuricsPageGradientBrush}">
        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="1040" Spacing="18">

                <TextBlock Text="设置"
                           Style="{StaticResource PageTitleStyle}" />

                <!-- Profile pane + Settings list side-by-side -->
                <Grid ColumnSpacing="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" MaxWidth="610" />
                    </Grid.ColumnDefinitions>

                    <!-- Profile pane — Mac: avatar 92x92 with accentGradient ring, cornerRadius 22, padding 24,26 -->
                    <Border Grid.Column="0"
                            Style="{StaticResource RokuricsGlassCardStyle}"
                            Padding="24,26" CornerRadius="22">
                        <StackPanel Spacing="13" HorizontalAlignment="Center">
                            <!-- Avatar with accent gradient ring matching Mac -->
                            <Border Width="96" Height="96"
                                    CornerRadius="48"
                                    Background="{StaticResource RokuricsActionGradientBrush}"
                                    HorizontalAlignment="Center">
                                <PersonPicture Width="88" Height="88"
                                               Initials="{x:Bind UserInitials, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind UserDisplayName, Mode=OneWay}"
                                       FontSize="30" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind UserHandle, Mode=OneWay}"
                                       FontSize="15" Opacity="0.5"
                                       HorizontalAlignment="Center" />
                            <Button Content="编辑个人资料"
                                    Style="{StaticResource RokuricsGlassCapsuleStyle}"
                                    FontSize="13"
                                    Click="EditProfile_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Settings groups -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <!-- Transcription Section — Mac: cornerRadius 22, glass card -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="转写" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />

                                <Button Padding="18,15" Click="TranscriptionProvider_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Provider" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind TranscriptionProvider, Mode=OneWay}"
                                                       FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="TranscriptionModel_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模型" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind WhisperModelName, Mode=OneWay}"
                                                       FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="TranscriptionAuthTest_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="授权与测试" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="待配置" FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- AI Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="AI" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />

                                <Button Padding="18,15" Click="AIProvider_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Provider" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind NoteProvider, Mode=OneWay}"
                                                       FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="AIModel_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模型" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind AIModelName, Mode=OneWay}"
                                                       FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="AIApiSettings_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API 设置" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="查看" FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="AITest_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="测试" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="查看" FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- About Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />

                                <Button Padding="18,15" Click="OpenStorage_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="存储" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="打开" FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="ShowPrivacyPolicy_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="隐私政策" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="查看" FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="18,0,0,0" />

                                <Button Padding="18,15" Click="ShowCopyright_Click"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="版权" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="1.0 (1)" FontSize="14" Opacity="0.5" />
                                            <TextBlock Text="›" FontSize="12" Opacity="0.3"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
