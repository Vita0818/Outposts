<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.StudyLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with back and breadcrumbs -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="←"
                        Style="{StaticResource RokuricsIconButtonStyle}"
                        Click="GoBack_Click"
                        IsEnabled="{x:Bind ViewModel.CurrentPath.IsRoot, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}" />
            </StackPanel>

            <!-- Breadcrumbs -->
            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <HyperlinkButton Click="Breadcrumb_Click"
                                             FontSize="13"
                                             Padding="4,2">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </HyperlinkButton>
                            <TextBlock Text=" › "
                                       Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Level title -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.LevelTitle, Mode=OneWay}"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,20" />

        <!-- Content: folders and items -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8">
                <!-- Folders -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RokuricsCardStyle}"
                                    Padding="12,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE838;"
                                              FontSize="20"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                            <Run Text="{Binding ItemCount}" />
                                            <Run Text=" 项" />
                                        </TextBlock>
                                    </StackPanel>

                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE76C;"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Opacity="0.5" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Items (when at leaf level) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RokuricsCardStyle}"
                                    Padding="12,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                                <Run Text="{Binding CreatedAt}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding SourceDescription}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding TranscriptionStatus}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="删除"
                                            Style="{StaticResource RokuricsButtonStyle}"
                                            FontSize="12"
                                            Click="DeleteItem_Click"
                                            Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <TextBlock Text="暂无内容"
                           Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,32,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
