<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.MacStudyLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource RokuricsPageGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="1120" Spacing="20">

                <!-- Title -->
                <TextBlock Text="学习库"
                           Style="{StaticResource PageTitleStyle}" />

                <!-- Browser navigation bar -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource RokuricsIconButtonStyle}"
                            Click="GoBack_Click"
                            IsEnabled="{x:Bind CanGoBack, Mode=OneWay}">
                        <SymbolIcon Symbol="Back" />
                    </Button>

                    <!-- Breadcrumbs -->
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{x:Bind Breadcrumbs, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <HyperlinkButton Content="{Binding}"
                                                     FontSize="12"
                                                     Padding="4,2" />
                                    <TextBlock Text=" › " FontSize="12" Opacity="0.4"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Style="{StaticResource RokuricsIconButtonStyle}"
                                Click="NewFolder_Click"
                                ToolTipService.ToolTip="新建文件夹">
                            <SymbolIcon Symbol="NewFolder" />
                        </Button>
                        <Button Style="{StaticResource RokuricsIconButtonStyle}"
                                Click="ImportToChat_Click"
                                ToolTipService.ToolTip="导入 AI 对话上下文">
                            <SymbolIcon Symbol="Message" />
                        </Button>
                        <Button Style="{StaticResource RokuricsIconButtonStyle}"
                                Click="OpenTrash_Click"
                                ToolTipService.ToolTip="打开废纸篓">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sync status bar -->
                <Border x:Name="SyncStatusBar"
                        Style="{StaticResource RokuricsCardStyle}"
                        Padding="12,10"
                        Visibility="Collapsed"
                        CornerRadius="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0"
                                  Symbol="Sync"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Grid.Column="1"
                                   x:Name="SyncStatusText"
                                   Text="上次同步: 暂无"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                x:Name="SyncNowStudyButton"
                                Content="立即同步"
                                FontSize="12"
                                Padding="10,6"
                                Click="SyncStudyLibrary_Click" />
                    </Grid>
                </Border>

                <!-- Content area -->
                <Grid>
                    <!-- Detail view (shown when a recording is selected) -->
                    <StackPanel x:Name="DetailPanel" x:Load="False" Visibility="Collapsed" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    Click="CloseDetail_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Back" />
                                    <TextBlock Text="返回" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                <TextBlock Text="{x:Bind DetailTitle, Mode=OneWay}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind DetailSubtitle, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Content="导入对话"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        FontSize="12" />
                                <Button Content="删除"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        FontSize="12"
                                        Foreground="#FF453A" />
                            </StackPanel>
                        </Grid>

                        <!-- Action buttons grid (2x2) -->
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="转写"
                                    x:Name="TranscribeButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                    Click="TranscribeButton_Click" />
                            <Button Grid.Column="1" Content="查看转写"
                                    x:Name="ViewTranscriptButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                    Click="ViewTranscriptButton_Click" />
                            <Button Grid.Column="2" Content="AI 总结"
                                    x:Name="GenerateNoteButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                    Click="GenerateNoteButton_Click" />
                            <Button Grid.Column="3" Content="查看总结"
                                    x:Name="ViewNoteButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                    Click="ViewNoteButton_Click" />
                        </Grid>

                        <!-- Filing picker (4-level) -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock Text="归档分类" FontSize="14" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="门类" FontSize="10" Opacity="0.5" />
                                        <TextBox x:Name="TypeBox" PlaceholderText="未分类" FontSize="12"
                                                 GotFocus="FilingBox_GotFocus"
                                                 TextChanged="FilingBox_TextChanged" />
                                        <ListView x:Name="TypeCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                  ItemClick="Candidate_ItemClick"
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="课程" FontSize="10" Opacity="0.5" />
                                        <TextBox x:Name="SubjectBox" PlaceholderText="未填写" FontSize="12"
                                                 GotFocus="FilingBox_GotFocus"
                                                 TextChanged="FilingBox_TextChanged" />
                                        <ListView x:Name="SubjectCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                  ItemClick="Candidate_ItemClick"
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="章节" FontSize="10" Opacity="0.5" />
                                        <TextBox x:Name="ChapterBox" PlaceholderText="未填写" FontSize="12"
                                                 GotFocus="FilingBox_GotFocus"
                                                 TextChanged="FilingBox_TextChanged" />
                                        <ListView x:Name="ChapterCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                  ItemClick="Candidate_ItemClick"
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Text="主题" FontSize="10" Opacity="0.5" />
                                        <TextBox x:Name="TopicBox" PlaceholderText="未填写" FontSize="12"
                                                 GotFocus="FilingBox_GotFocus"
                                                 TextChanged="FilingBox_TextChanged" />
                                        <ListView x:Name="TopicCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                  ItemClick="Candidate_ItemClick"
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Inline create-new-value (matching MacStudyFilingPicker) -->
                                <StackPanel x:Name="CreateNewPanel"
                                            Visibility="Collapsed"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,4,0,0">
                                    <TextBlock x:Name="CreateNewLabel"
                                               Text="新建值"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="CreateNewTextBox"
                                             PlaceholderText="输入名称"
                                             FontSize="12"
                                             Width="160" />
                                    <Button Content="确定"
                                            FontSize="12"
                                            Padding="8,4"
                                            Click="CreateNewValueConfirm_Click" />
                                    <Button Content="取消"
                                            FontSize="12"
                                            Padding="8,4"
                                            Click="CreateNewValueCancel_Click" />
                                </StackPanel>
                                <Button x:Name="ShowCreateNewButton"
                                        Content="+ 新建分类值"
                                        FontSize="11"
                                        HorizontalAlignment="Left"
                                        Click="ShowCreateNewValue_Click"
                                        Margin="0,4,0,0" />
                                <Button Content="保存归档"
                                        Style="{StaticResource RokuricsAccentButtonStyle}"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Padding="12,8"
                                        Click="SaveFiling_Click" />
                            </StackPanel>
                        </Border>

                        <!-- File status panel -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="文件状态" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind FileStatusText, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- AI Summary preview -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="AI 摘要" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind SummaryPreviewText, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock x:Name="SummaryKeyPoints"
                                           Text="{x:Bind SummaryKeyPointsText, Mode=OneWay}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Browser view -->
                    <StackPanel x:Name="BrowserPanel" Spacing="18">
                        <!-- Empty state -->
                        <Border x:Name="EmptyState"
                                Style="{StaticResource RokuricsCardStyle}"
                                Visibility="Collapsed"
                                Padding="22">
                            <StackPanel Spacing="9">
                                <SymbolIcon Symbol="Library"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="暂无学习内容"
                                           FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="收到或保存的录音会在这里按门类、课程、章节和主题逐层显示。"
                                           FontSize="14" Opacity="0.6" />
                            </StackPanel>
                        </Border>

                        <!-- Folder tiles grid -->
                        <ItemsControl x:Name="FoldersGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid MaximumRowsOrColumns="6"
                                                          ItemWidth="160" ItemHeight="140"
                                                          Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Recording cards list -->
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Transcript detail view (full-page) -->
                    <StackPanel x:Name="TranscriptPanel" x:Load="False" Visibility="Collapsed" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    Click="CloseTranscript_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Back" />
                                    <TextBlock Text="返回" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                <TextBlock x:Name="TranscriptTitle"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="TranscriptSubtitle"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Transcript metadata -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="转写信息" FontSize="14" FontWeight="SemiBold" />
                                <Grid x:Name="TranscriptMetadataGrid"
                                      ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Transcript content -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="18">
                            <ScrollViewer MaxHeight="600">
                                <TextBlock x:Name="TranscriptContent"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Note detail view (full-page) -->
                    <StackPanel x:Name="NotePanel" x:Load="False" Visibility="Collapsed" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    Click="CloseNote_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Back" />
                                    <TextBlock Text="返回" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                <TextBlock x:Name="NoteTitle"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="NoteSubtitle"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Note metadata -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="笔记信息" FontSize="14" FontWeight="SemiBold" />
                                <Grid x:Name="NoteMetadataGrid"
                                      ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Note content -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="18">
                            <ScrollViewer MaxHeight="600">
                                <TextBlock x:Name="NoteContent"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
