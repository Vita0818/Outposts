<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rokurics.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand header — Mac: "Rokurics" serif 30pt, "Windows" 12pt medium secondary -->
        <StackPanel Grid.Row="0" Padding="20,24,20,18" Spacing="4">
            <TextBlock Text="Rokurics"
                       FontFamily="{StaticResource RokuricsSerifFont}"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Windows"
                       FontFamily="{StaticResource RokuricsFontFamily}"
                       FontSize="12"
                       FontWeight="Medium"
                       Opacity="0.5" />
        </StackPanel>

        <!-- Sidebar items — Mac: VStack spacing 6, horizontal padding 12, vertical padding 4 -->
        <ListView Grid.Row="1"
                  x:Name="SidebarItemsList"
                  SelectionMode="Single"
                  SelectionChanged="OnItemSelected"
                  Padding="12,4"
                  Background="Transparent">
            <ListView.Resources>
                <!-- Custom ListViewItem style with aqua gradient selection matching Mac -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="CornerRadius" Value="15" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid x:Name="RootGrid" CornerRadius="15">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#034FBEBA" Offset="0" />
                                            <GradientStop Color="#0394E6C2" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>
            <ListViewItem x:Name="StudyLibraryItem" Tag="studyLibrary" IsSelected="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Library" />
                    <TextBlock Text="学习库" FontSize="13" FontWeight="Medium" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem x:Name="AIChatItem" Tag="aiChat">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="AI" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="对话" FontSize="13" FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
            <ListViewItem x:Name="ConnectionItem" Tag="iPhoneConnection">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EA;" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="iPhone" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="连接" FontSize="13" FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- Bottom: Profile / Settings button — matching Mac sidebar profile button -->
        <Button Grid.Row="2"
                x:Name="SettingsButton"
                Click="OnSettingsClicked"
                Margin="14"
                Padding="12,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PersonPicture Width="30" Height="30"
                               Initials="{x:Bind UserInitials, Mode=OneWay}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind UserDisplayName, Mode=OneWay, FallbackValue='User'}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind UserHandle, Mode=OneWay, FallbackValue='@user'}"
                               FontSize="10" Opacity="0.5" />
                </StackPanel>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
