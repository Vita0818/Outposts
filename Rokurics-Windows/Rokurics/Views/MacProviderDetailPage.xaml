<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.MacProviderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Rokurics.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="820" Spacing="20">

                <!-- Back button + title -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← 返回设置"
                            Style="{StaticResource RokuricsButtonStyle}"
                            FontSize="13"
                            Click="GoBack_Click" />

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="PageTitle"
                                   Text="Provider 详情"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="PageSubtitle"
                                   Text="查看和配置 Provider 连接参数"
                                   FontSize="13" Opacity="0.5" />
                    </StackPanel>
                </Grid>

                <!-- Provider detail card (dynamic) -->
                <views:ProviderDetailCard x:Name="DetailCard" />

                <!-- Additional info: endpoint configuration -->
                <Border Style="{StaticResource RokuricsCardStyle}"
                        Padding="0" CornerRadius="22">
                    <StackPanel Spacing="0">
                        <Grid Padding="20,16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE946;"
                                      FontSize="16"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="端点与密钥管理"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="API 密钥存储在本地设置中，不会上传或同步。建议使用环境变量或 Windows Credential Manager 管理敏感凭据。"
                                           FontSize="12" Opacity="0.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="0.5" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   Margin="20,0" Opacity="0.5" />

                        <StackPanel Padding="20,14" Spacing="14">

                            <!-- Endpoint URL info -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Endpoint"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="EndpointUrlBlock"
                                           Grid.Column="1"
                                           Text="未配置"
                                           FontSize="13" FontWeight="SemiBold"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Authentication method info -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="认证方式"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="AuthMethodBlock"
                                           Grid.Column="1"
                                           Text="Bearer Token (API Key)"
                                           FontSize="13" FontWeight="SemiBold" />
                            </Grid>

                            <!-- Key storage info -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="密钥存储"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="KeyStorageBlock"
                                           Grid.Column="1"
                                           Text="Rokurics/settings.json"
                                           FontSize="13" FontWeight="SemiBold"
                                           IsTextSelectionEnabled="True" />
                            </Grid>

                            <!-- Last validated time -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="上次验证"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LastValidatedBlock"
                                           Grid.Column="1"
                                           Text="尚未验证"
                                           FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Configuration notes -->
                <Border Style="{StaticResource RokuricsCardStyle}"
                        Padding="20" CornerRadius="22">
                    <StackPanel Spacing="10">
                        <TextBlock Text="配置说明"
                                   FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConfigNotesBlock"
                                   FontSize="12" Opacity="0.6"
                                   TextWrapping="Wrap">
                            <Run Text="• OpenAI-compatible: 支持任何兼容 OpenAI Chat Completions API 的服务 (OpenAI, DeepSeek, Qwen, LM Studio, Ollama 等)" />
                            <LineBreak />
                            <Run Text="• Claude / Anthropic: 使用 Anthropic Messages API，需要有效的 API Key 和 Anthropic Version header" />
                            <LineBreak />
                            <Run Text="• 模型列表通过 /v1/models (OpenAI) 或 /v1/models (Anthropic) 端点获取" />
                            <LineBreak />
                            <Run Text="• 如果网络受限或 API 未配置，可以使用内置模型名称列表" />
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
