<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Rokurics.Views.MacIPhoneConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Breathing animation: opacity pulse + scale wobble matching Mac 4.8s easeInOut -->
        <Storyboard x:Name="BreathingAnimation"
                    RepeatBehavior="Forever"
                    AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DeviceBubbleScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.04"
                             Duration="0:0:4.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DeviceBubbleScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.04"
                             Duration="0:0:4.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DeviceBubble"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.72"
                             Duration="0:0:4.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Fingerprint visibility toggle animation — Mac: 0.18s easeInOut -->
        <Storyboard x:Name="FingerprintShowAnimation" Duration="0:0:0.18">
            <DoubleAnimation Storyboard.TargetName="FingerprintCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1.0"
                             Duration="0:0:0.18" />
        </Storyboard>
        <Storyboard x:Name="FingerprintHideAnimation" Duration="0:0:0.18">
            <DoubleAnimation Storyboard.TargetName="FingerprintCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0"
                             Duration="0:0:0.18" />
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource RokuricsPageGradientBrush}">
        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="26">

                <!-- Header (mirrors connectionTitle) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="iPhone 连接"
                                   Style="{StaticResource PageTitleStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            x:Name="StatusCapsule"
                            Style="{StaticResource RokuricsCardStyle}"
                            Padding="14,8"
                            CornerRadius="16">
                        <TextBlock Text="未配对" FontSize="12" FontWeight="Bold" />
                    </Border>
                </Grid>

                <!-- Paired section (visible when device is connected) -->
                <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed" Spacing="24">
                    <!-- Device bubble + card -->
                    <Grid ColumnSpacing="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="286" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Device bubble — Mac: 286x286, accentGradient, 4.8s breathing + wobble -->
                        <Border x:Name="DeviceBubble"
                                Grid.Column="0"
                                Width="286" Height="286"
                                CornerRadius="143"
                                HorizontalAlignment="Center"
                                Background="{StaticResource RokuricsActionGradientBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DeviceBubbleScaleTransform" />
                            </Border.RenderTransform>
                            <FontIcon Glyph="&#xE8EA;" FontSize="68"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Connected device card — Mac: cornerRadius 24, padding 22 -->
                        <Border Grid.Column="1"
                                Style="{StaticResource RokuricsLargeGlassCardStyle}"
                                Padding="22" CornerRadius="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="iPhone"
                                           FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ConnectionInfo, Mode=OneWay}"
                                           FontSize="13" Opacity="0.5" />

                                <!-- Status rows -->
                                <Border Style="{StaticResource RokuricsCardStyle}"
                                        Padding="12" CornerRadius="16">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="状态" FontSize="11" Opacity="0.5" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ConnectionState, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最近在线" FontSize="11" Opacity="0.5" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind LastSeenText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最近同步" FontSize="11" Opacity="0.5" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind LastSyncText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Action buttons -->
                                <StackPanel Spacing="10">
                                    <Button x:Name="SyncNowButton"
                                            Content="立即同步"
                                            Style="{StaticResource RokuricsAccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="SyncNow_Click" />
                                    <Button x:Name="ConnectionDetailButton"
                                            Content="查看连接信息"
                                            Style="{StaticResource RokuricsAccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="ConnectionDetail_Click" />
                                    <Button x:Name="DisconnectButton"
                                            Content="断开连接"
                                            Style="{StaticResource RokuricsDestructiveButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="Disconnect_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Unpaired section (mirrors pairingInformationCard) -->
                <StackPanel x:Name="UnpairedPanel" Visibility="Visible" Spacing="16">
                    <Border Style="{StaticResource RokuricsLargeGlassCardStyle}"
                            Padding="22" CornerRadius="24">
                        <StackPanel Spacing="16">
                            <!-- Address + Port row -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Style="{StaticResource RokuricsCardStyle}"
                                        Padding="16,14" CornerRadius="18">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Mac 地址" FontSize="12" FontWeight="SemiBold" Opacity="0.5" />
                                        <TextBlock Text="{x:Bind LocalAddress, Mode=OneWay}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Style="{StaticResource RokuricsCardStyle}"
                                        Padding="16,14" CornerRadius="18">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="端口" FontSize="12" FontWeight="SemiBold" Opacity="0.5" />
                                        <TextBlock Text="{x:Bind LocalPort, Mode=OneWay}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Fingerprint — Mac: visibility toggled with 0.18s animation -->
                            <Border x:Name="FingerprintCard"
                                    Style="{StaticResource RokuricsCardStyle}"
                                    Padding="16,14" CornerRadius="18">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Mac 指纹" FontSize="12" FontWeight="SemiBold" Opacity="0.5" />
                                    <TextBlock Text="{x:Bind FingerprintDisplay, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Pairing code row or "Start Pairing" button -->
                            <Border x:Name="PairingCodeCard"
                                    Style="{StaticResource RokuricsCardStyle}"
                                    Padding="16" CornerRadius="18"
                                    Visibility="Collapsed">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="配对码" FontSize="12" FontWeight="SemiBold" Opacity="0.5" />
                                        <TextBlock x:Name="PairingCodeText"
                                                   FontSize="30" FontWeight="Bold"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="3:00"
                                               FontSize="13" FontWeight="SemiBold"
                                               Opacity="0.5"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Start Pairing button (when no active code) -->
                            <Button x:Name="StartPairingButton"
                                    Content="开始配对"
                                    Style="{StaticResource RokuricsAccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="StartPairing_Click" />

                            <!-- Copy pairing info button -->
                            <Button Content="复制配对信息"
                                    Style="{StaticResource RokuricsAccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="CopyPairingInfo_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
