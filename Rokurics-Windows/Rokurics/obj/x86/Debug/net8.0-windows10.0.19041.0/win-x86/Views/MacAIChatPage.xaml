<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Rokurics.Views.MacAIChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource RokuricsPageGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Conversation area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Recent conversations sidebar — Mac: RecentConversationsPopover width 320 -->
            <Border x:ConnectionId='7' Grid.Column="0"
                    x:Name="RecentPanel"
                    Width="320"
                    Style="{StaticResource RokuricsCardStyle}"
                    Margin="0,0,8,0"
                    Padding="12"
                    Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="最近对话"
                               Style="{StaticResource ChineseHeadlineStyle}"
                               Margin="0,0,0,8" />
                    <ListView x:ConnectionId='13' x:Name="ConversationsList"
                                                                       
                              Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Messages — Mac: horizontalPadding 30, contentMaxWidth 780 -->
            <ScrollViewer x:ConnectionId='8' Grid.Column="1" x:Name="MessagesScroll" Padding="30,16">
                <StackPanel Spacing="22" MaxWidth="780">
                    <!-- Greeting — Mac: 24pt semibold, top padding 140 -->
                    <TextBlock x:ConnectionId='9' x:Name="GreetingText"
                               Style="{StaticResource ChatGreetingStyle}"
                               Margin="0,140,0,20"
                                                                     />

                    <!-- Messages list -->
                    <ItemsControl x:ConnectionId='10' x:Name="MessagesList" />

                    <!-- Loading -->
                    <ProgressBar x:ConnectionId='11' x:Name="LoadingBar"
                                 IsIndeterminate="True"
                                 Height="2"
                                 Visibility="Collapsed" />

                    <!-- Error -->
                    <Border x:ConnectionId='12' x:Name="ErrorBanner"
                            Background="#22FF453A"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="Collapsed">
                        <TextBlock Foreground="#FF453A" FontSize="12" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Input bar (mirrors ChatInputBar + ChatConversationButtonGroup) -->
        <Border Grid.Row="1"
                Style="{StaticResource RokuricsCardStyle}"
                Margin="24,12,24,20"
                Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Conversation buttons: recent + new — Mac: ChatConversationButtonGroup -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button x:ConnectionId='5' Style="{StaticResource RokuricsIconButtonStyle}"
                                                      
                            ToolTipService.ToolTip="最近对话">
                        <SymbolIcon Symbol="Microphone" />
                    </Button>
                    <Button x:ConnectionId='6' Style="{StaticResource RokuricsIconButtonStyle}"
                                                         
                            ToolTipService.ToolTip="新建对话">
                        <SymbolIcon Symbol="More" />
                    </Button>
                </StackPanel>

                <!-- Attachment button — Mac: import context paperclip -->
                <Button x:ConnectionId='2' x:Name="AttachButton"
                        Grid.Column="1"
                        Style="{StaticResource RokuricsIconButtonStyle}"
                                            
                        ToolTipService.ToolTip="导入学习库内容">
                    <SymbolIcon Symbol="Stop" />
                </Button>

                <!-- Text input -->
                <TextBox x:ConnectionId='3' Grid.Column="2"
                         x:Name="MessageInput"
                         PlaceholderText="消息"
                         Style="{StaticResource RokuricsTextBoxStyle}"
                         AcceptsReturn="True"
                         MaxHeight="120" />

                <!-- Send button — Mac: arrow.up.circle.fill -->
                <Button x:ConnectionId='4' Grid.Column="3"
                        Style="{StaticResource RokuricsAccentButtonStyle}"
                        Width="40" Height="40"
                                          >
                    <SymbolIcon Symbol="Send" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>

