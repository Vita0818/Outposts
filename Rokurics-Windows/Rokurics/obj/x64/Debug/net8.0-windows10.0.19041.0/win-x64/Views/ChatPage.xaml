<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Rokurics.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:ConnectionId='14' Grid.Column="0"
                    Content="≡"
                    Style="{StaticResource RokuricsIconButtonStyle}"
                                                        
                    FontSize="18" />

            <TextBlock x:ConnectionId='15' Grid.Column="1"
                                                                                                           
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <Button x:ConnectionId='16' Grid.Column="2"
                    Content="✚"
                    Style="{StaticResource RokuricsIconButtonStyle}"
                                                 
                    FontSize="16" />
        </Grid>

        <!-- Sidebar + chat area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Conversation list sidebar -->
            <Border x:ConnectionId='4' Grid.Column="0"
                    Width="260"
                    Style="{StaticResource RokuricsCardStyle}"
                                                                                     
                    Margin="0,0,8,0"
                    Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="最近对话"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,8" />

                    <ListView x:ConnectionId='12'                                                            
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8,6" Spacing="4">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UpdatedAt}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Messages area -->
            <ScrollViewer x:ConnectionId='5' Grid.Column="1" x:Name="MessagesScrollViewer">
                <StackPanel Padding="24,16" Spacing="16" MaxWidth="780">
                    <!-- Greeting -->
                    <TextBlock x:ConnectionId='6'                                                    
                               FontSize="28"
                               FontWeight="Light"
                               FontFamily="{StaticResource RokuricsFontFamily}"
                               HorizontalAlignment="Center"
                               Margin="0,80,0,20"
                               Opacity="0.6"
                                                                                                                                                    />

                    <!-- Messages -->
                    <ItemsControl x:ConnectionId='7'                                                             >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="{Binding Role, Converter={StaticResource ChatRoleToAlignmentConverter}}"
                                      MaxWidth="600">
                                    <Border Background="{Binding Role, Converter={StaticResource ChatRoleToBackgroundConverter}}"
                                            CornerRadius="12"
                                            Padding="14,10">
                                        <TextBlock Text="{Binding Content}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading indicator -->
                    <ProgressBar x:ConnectionId='8' IsIndeterminate="True"
                                                                                          
                                 Height="2" />

                    <!-- Error -->
                    <Border x:ConnectionId='9' Background="#22FF453A"
                            CornerRadius="8"
                            Padding="12"
                                                                                                                                          >
                        <TextBlock x:ConnectionId='10'                                                    
                                   Foreground="#FF453A"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Input bar -->
        <Border Grid.Row="2"
                Style="{StaticResource RokuricsCardStyle}"
                Margin="24,12,24,20"
                Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='2' Grid.Column="0"
                                                                                                                 
                         PlaceholderText="消息"
                         Style="{StaticResource RokuricsTextBoxStyle}"
                         AcceptsReturn="True"
                         MaxHeight="120"
                                                                                                                                  />

                <Button x:ConnectionId='3' Grid.Column="1"
                        Content="↑"
                        Style="{StaticResource RokuricsAccentButtonStyle}"
                        Width="40"
                        Height="40"
                        FontSize="18"
                                          
                                                                                                                                 />
            </Grid>
        </Border>
    </Grid>
</Page>

