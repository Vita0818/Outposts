<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rokurics.Views.ProviderDetailCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource RokuricsCardStyle}"
            Padding="0" CornerRadius="22">
        <StackPanel Spacing="0">

            <!-- Header: Provider name + type badge + status dot -->
            <Grid Padding="20,18" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Provider icon circle (glass-style) -->
                <Border x:ConnectionId='21' x:Name="ProviderIconCircle"
                        Grid.Column="0"
                        Width="42" Height="42"
                        CornerRadius="21"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon x:ConnectionId='29' x:Name="ProviderIconGlyph"
                              Glyph="&#xE8F2;"
                              FontSize="18"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='25' x:Name="ProviderNameBlock"
                               FontSize="18" FontWeight="SemiBold"
                               Text="Provider" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:ConnectionId='26' x:Name="TypeBadge"
                                CornerRadius="6"
                                Padding="8,3"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock x:ConnectionId='28' x:Name="TypeBadgeText"
                                       Text="AI"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                        <TextBlock x:ConnectionId='27' x:Name="ProviderIdBlock"
                                   FontSize="11" Opacity="0.4"
                                   VerticalAlignment="Center"
                                   Text="provider-id" />
                    </StackPanel>
                </StackPanel>

                <!-- Status pill -->
                <Border x:ConnectionId='22' x:Name="StatusPill"
                        Grid.Column="2"
                        CornerRadius="12"
                        Padding="14,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border x:ConnectionId='23' x:Name="StatusDot"
                                Width="9" Height="9"
                                CornerRadius="4.5" />
                        <TextBlock x:ConnectionId='24' x:Name="StatusText"
                                   Text="未配置"
                                   FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Rectangle Height="0.5" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                       Margin="20,0" Opacity="0.5" />

            <!-- Model list section -->
            <StackPanel x:ConnectionId='2' x:Name="ModelListSection" Spacing="0">
                <Grid Padding="20,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="可用模型"
                                   FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:ConnectionId='20' x:Name="ModelCountBlock"
                                   Text="0 个模型"
                                   FontSize="11" Opacity="0.5" />
                    </StackPanel>

                    <Button x:ConnectionId='19' x:Name="RefreshModelsBtn"
                            Grid.Column="1"
                            Content="刷新"
                            FontSize="12"
                            Padding="12,6"
                                                        />
                </Grid>

                <!-- Model list -->
                <ListView x:ConnectionId='15' x:Name="ModelsListView"
                          SelectionMode="Single"
                          MaxHeight="280"
                          Margin="8,0,8,8"
                          Background="Transparent"
                                                                  >
                    <ListView.ItemTemplate>
                        <DataTemplate                      >
                            <Grid Padding="14,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding}"
                                               FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="1"
                                          Symbol="Forward"
                                          Opacity="0.3"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Model loading/error status -->
                <TextBlock x:ConnectionId='16' x:Name="ModelStatusBlock"
                           FontSize="12" Opacity="0.6"
                           Margin="18,0,18,10"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <Rectangle Height="0.5" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                       Margin="20,0" Opacity="0.5" />

            <!-- API settings form -->
            <StackPanel x:ConnectionId='3' x:Name="ApiSettingsSection" Spacing="0" Padding="18,12">

                <!-- Preset selector (for OpenAI-compatible) -->
                <StackPanel x:ConnectionId='4' x:Name="PresetSelectorRow" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="Provider Preset"
                               FontSize="11" Opacity="0.5" />
                    <ComboBox x:ConnectionId='14' x:Name="PresetCombo"
                                                                       
                              Width="260" FontSize="13" />
                </StackPanel>

                <!-- Base URL -->
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="Base URL"
                               FontSize="11" Opacity="0.5" />
                    <TextBox x:ConnectionId='13' x:Name="BaseUrlBox"
                             PlaceholderText="https://api.openai.com/v1"
                             FontSize="13" />
                </StackPanel>

                <!-- API Key -->
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="API Key"
                               FontSize="11" Opacity="0.5" />
                    <PasswordBox x:ConnectionId='12' x:Name="ApiKeyBox"
                                 PlaceholderText="sk-..."
                                 FontSize="13" />
                </StackPanel>

                <!-- Model name (displayed/selected) -->
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="模型名称"
                               FontSize="11" Opacity="0.5" />
                    <TextBox x:ConnectionId='11' x:Name="ModelNameBox"
                             PlaceholderText="gpt-4o"
                             FontSize="13" />
                </StackPanel>

                <!-- Anthropic version (conditional) -->
                <StackPanel x:ConnectionId='5' x:Name="VersionRow" Spacing="4"
                            Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock Text="Anthropic Version"
                               FontSize="11" Opacity="0.5" />
                    <TextBox x:ConnectionId='10' x:Name="VersionBox"
                             Text="2023-06-01"
                             FontSize="13" Width="180" />
                </StackPanel>

                <!-- Action buttons row -->
                <Grid ColumnSpacing="10" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:ConnectionId='7' x:Name="TestConnectionBtn"
                            Grid.Column="0"
                            Content="测试连接"
                            FontSize="12" Padding="12,8"
                                                         />

                    <Button x:ConnectionId='8' x:Name="ValidateConfigBtn"
                            Grid.Column="1"
                            Content="验证配置"
                            FontSize="12" Padding="12,8"
                                                         />

                    <Button x:ConnectionId='9' x:Name="SaveSettingsBtn"
                            Grid.Column="3"
                            Content="保存设置"
                            Style="{StaticResource RokuricsAccentButtonStyle}"
                            FontSize="12" Padding="14,8"
                                                       />
                </Grid>

                <!-- Test/validation result -->
                <TextBlock x:ConnectionId='6' x:Name="TestResultBlock"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

