<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Rokurics.Views.MacSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Rokurics.Views">

    <Page.Resources>
        <DataTemplate x:Key="SettingsRowTemplate"                                   >
            <StackPanel x:ConnectionId='3' Spacing="0">
                <Button x:ConnectionId='4' Padding="18,15"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource RokuricsButtonStyle}"
                        Background="Transparent"
                        HorizontalContentAlignment="Stretch"
                                                 
                                                >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='6'                       FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:ConnectionId='7'                       FontSize="14" Opacity="0.5" />
                            <TextBlock Text="›" FontSize="12" Opacity="0.3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Rectangle x:ConnectionId='5' Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                           Margin="18,0,0,0"
                                                                     />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource RokuricsPageGradientBrush}">
        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="1040" Spacing="18">

                <TextBlock Text="设置"
                           Style="{StaticResource PageTitleStyle}" />

                <!-- Profile pane + Settings list side-by-side -->
                <Grid ColumnSpacing="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" MaxWidth="610" />
                    </Grid.ColumnDefinitions>

                    <!-- Profile pane -->
                    <Border Grid.Column="0"
                            Style="{StaticResource RokuricsGlassCardStyle}"
                            Padding="24,26" CornerRadius="22">
                        <StackPanel Spacing="13" HorizontalAlignment="Center">
                            <Border Width="96" Height="96"
                                    CornerRadius="48"
                                    Background="{StaticResource RokuricsActionGradientBrush}"
                                    HorizontalAlignment="Center">
                                <PersonPicture x:ConnectionId='14' Width="88" Height="88"
                                                                                            
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:ConnectionId='11'                                             
                                       FontSize="30" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:ConnectionId='12'                                        
                                       FontSize="15" Opacity="0.5"
                                       HorizontalAlignment="Center" />
                            <Button x:ConnectionId='13' Content="编辑个人资料"
                                    Style="{StaticResource RokuricsGlassCapsuleStyle}"
                                    FontSize="13"
                                                              />
                        </StackPanel>
                    </Border>

                    <!-- Settings groups -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <!-- Transcription Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="转写" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />
                                <ItemsControl x:ConnectionId='10' x:Name="TranscriptionRows"
                                              ItemTemplate="{StaticResource SettingsRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- AI Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="AI" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />
                                <ItemsControl x:ConnectionId='9' x:Name="AIRows"
                                              ItemTemplate="{StaticResource SettingsRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- About Section -->
                        <Border Style="{StaticResource RokuricsGlassCardStyle}"
                                Padding="0" CornerRadius="22">
                            <StackPanel Spacing="0">
                                <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.5" Margin="18,12,18,8" />
                                <ItemsControl x:ConnectionId='8' x:Name="AboutRows"
                                              ItemTemplate="{StaticResource SettingsRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

