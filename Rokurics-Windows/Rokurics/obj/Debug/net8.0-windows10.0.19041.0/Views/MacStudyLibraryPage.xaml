<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Rokurics.Views.MacStudyLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource RokuricsPageGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="34,30,34,34">
            <StackPanel MaxWidth="1120" Spacing="20">

                <!-- Title -->
                <TextBlock Text="学习库"
                           Style="{StaticResource PageTitleStyle}" />

                <!-- Browser navigation bar -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:ConnectionId='47' Grid.Column="0"
                            Style="{StaticResource RokuricsIconButtonStyle}"
                                                
                                                                       >
                        <SymbolIcon Symbol="Back" />
                    </Button>

                    <!-- Breadcrumbs -->
                    <ItemsControl x:ConnectionId='48' Grid.Column="1"
                                                                                 >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                      >
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <HyperlinkButton Content="{Binding}"
                                                     FontSize="12"
                                                     Padding="4,2" />
                                    <TextBlock Text=" › " FontSize="12" Opacity="0.4"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button x:ConnectionId='49' Style="{StaticResource RokuricsIconButtonStyle}"
                                                       
                                ToolTipService.ToolTip="新建文件夹">
                            <SymbolIcon Symbol="NewFolder" />
                        </Button>
                        <Button x:ConnectionId='50' Style="{StaticResource RokuricsIconButtonStyle}"
                                                          
                                ToolTipService.ToolTip="导入 AI 对话上下文">
                            <SymbolIcon Symbol="Message" />
                        </Button>
                        <Button x:ConnectionId='51' Style="{StaticResource RokuricsIconButtonStyle}"
                                                       
                                ToolTipService.ToolTip="打开废纸篓">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sync status bar -->
                <Border x:ConnectionId='2' x:Name="SyncStatusBar"
                        Style="{StaticResource RokuricsCardStyle}"
                        Padding="12,10"
                        Visibility="Collapsed"
                        CornerRadius="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0"
                                  Symbol="Sync"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:ConnectionId='45' Grid.Column="1"
                                   x:Name="SyncStatusText"
                                   Text="上次同步: 暂无"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <Button x:ConnectionId='46' Grid.Column="2"
                                x:Name="SyncNowStudyButton"
                                Content="立即同步"
                                FontSize="12"
                                Padding="10,6"
                                                               />
                    </Grid>
                </Border>

                <!-- Content area -->
                <Grid>
                    <!-- Detail view (shown when a recording is selected) -->
                    <StackPanel x:ConnectionId='3' x:Name="DetailPanel" x:Load="False" Visibility="Collapsed" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:ConnectionId='42' Grid.Column="0"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                                             >
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Back" />
                                    <TextBlock Text="返回" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                <TextBlock x:ConnectionId='43'                                         
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:ConnectionId='44'                                            
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Content="导入对话"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        FontSize="12" />
                                <Button Content="删除"
                                        Style="{StaticResource RokuricsButtonStyle}"
                                        FontSize="12"
                                        Foreground="#FF453A" />
                            </StackPanel>
                        </Grid>

                        <!-- Action buttons grid (2x2) -->
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:ConnectionId='38' Grid.Column="0" Content="转写"
                                    x:Name="TranscribeButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                                                   />
                            <Button x:ConnectionId='39' Grid.Column="1" Content="查看转写"
                                    x:Name="ViewTranscriptButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                                                       />
                            <Button x:ConnectionId='40' Grid.Column="2" Content="AI 总结"
                                    x:Name="GenerateNoteButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                                                     />
                            <Button x:ConnectionId='41' Grid.Column="3" Content="查看总结"
                                    x:Name="ViewNoteButton"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                    FontSize="12"
                                    Padding="12,10"
                                                                 />
                        </Grid>

                        <!-- Filing picker (4-level) -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock Text="归档分类" FontSize="14" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="门类" FontSize="10" Opacity="0.5" />
                                        <TextBox x:ConnectionId='36' x:Name="TypeBox" PlaceholderText="未分类" FontSize="12"
                                                                              
                                                                                     />
                                        <ListView x:ConnectionId='37' x:Name="TypeCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                                                 
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="课程" FontSize="10" Opacity="0.5" />
                                        <TextBox x:ConnectionId='34' x:Name="SubjectBox" PlaceholderText="未填写" FontSize="12"
                                                                              
                                                                                     />
                                        <ListView x:ConnectionId='35' x:Name="SubjectCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                                                 
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="章节" FontSize="10" Opacity="0.5" />
                                        <TextBox x:ConnectionId='32' x:Name="ChapterBox" PlaceholderText="未填写" FontSize="12"
                                                                              
                                                                                     />
                                        <ListView x:ConnectionId='33' x:Name="ChapterCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                                                 
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Text="主题" FontSize="10" Opacity="0.5" />
                                        <TextBox x:ConnectionId='30' x:Name="TopicBox" PlaceholderText="未填写" FontSize="12"
                                                                              
                                                                                     />
                                        <ListView x:ConnectionId='31' x:Name="TopicCandidates"
                                                  MaxHeight="140" FontSize="12"
                                                  Visibility="Collapsed"
                                                                                 
                                                  IsItemClickEnabled="True"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Inline create-new-value (matching MacStudyFilingPicker) -->
                                <StackPanel x:ConnectionId='23' x:Name="CreateNewPanel"
                                            Visibility="Collapsed"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,4,0,0">
                                    <TextBlock x:ConnectionId='26' x:Name="CreateNewLabel"
                                               Text="新建值"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBox x:ConnectionId='27' x:Name="CreateNewTextBox"
                                             PlaceholderText="输入名称"
                                             FontSize="12"
                                             Width="160" />
                                    <Button x:ConnectionId='28' Content="确定"
                                            FontSize="12"
                                            Padding="8,4"
                                                                                />
                                    <Button x:ConnectionId='29' Content="取消"
                                            FontSize="12"
                                            Padding="8,4"
                                                                               />
                                </StackPanel>
                                <Button x:ConnectionId='24' x:Name="ShowCreateNewButton"
                                        Content="+ 新建分类值"
                                        FontSize="11"
                                        HorizontalAlignment="Left"
                                                                        
                                        Margin="0,4,0,0" />
                                <Button x:ConnectionId='25' Content="保存归档"
                                        Style="{StaticResource RokuricsAccentButtonStyle}"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Padding="12,8"
                                                                 />
                            </StackPanel>
                        </Border>

                        <!-- File status panel -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="文件状态" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:ConnectionId='22'                                            
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- AI Summary preview -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="AI 摘要" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:ConnectionId='20'                                                
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock x:ConnectionId='21' x:Name="SummaryKeyPoints"
                                                                                            
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Browser view -->
                    <StackPanel x:ConnectionId='4' x:Name="BrowserPanel" Spacing="18">
                        <!-- Empty state -->
                        <Border x:ConnectionId='17' x:Name="EmptyState"
                                Style="{StaticResource RokuricsCardStyle}"
                                Visibility="Collapsed"
                                Padding="22">
                            <StackPanel Spacing="9">
                                <SymbolIcon Symbol="Library"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="暂无学习内容"
                                           FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="收到或保存的录音会在这里按门类、课程、章节和主题逐层显示。"
                                           FontSize="14" Opacity="0.6" />
                            </StackPanel>
                        </Border>

                        <!-- Folder tiles grid -->
                        <ItemsControl x:ConnectionId='18' x:Name="FoldersGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid MaximumRowsOrColumns="6"
                                                          ItemWidth="160" ItemHeight="140"
                                                          Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Recording cards list -->
                        <ItemsControl x:ConnectionId='19' x:Name="ItemsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Transcript detail view (full-page) -->
                    <StackPanel x:ConnectionId='5' x:Name="TranscriptPanel" x:Load="False" Visibility="Collapsed" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:ConnectionId='14' Grid.Column="0"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                                                 >
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Back" />
                                    <TextBlock Text="返回" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                <TextBlock x:ConnectionId='15' x:Name="TranscriptTitle"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:ConnectionId='16' x:Name="TranscriptSubtitle"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Transcript metadata -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="转写信息" FontSize="14" FontWeight="SemiBold" />
                                <Grid x:ConnectionId='13' x:Name="TranscriptMetadataGrid"
                                      ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Transcript content -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="18">
                            <ScrollViewer MaxHeight="600">
                                <TextBlock x:ConnectionId='12' x:Name="TranscriptContent"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Note detail view (full-page) -->
                    <StackPanel x:ConnectionId='6' x:Name="NotePanel" x:Load="False" Visibility="Collapsed" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:ConnectionId='9' Grid.Column="0"
                                    Style="{StaticResource RokuricsButtonStyle}"
                                                           >
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Back" />
                                    <TextBlock Text="返回" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                <TextBlock x:ConnectionId='10' x:Name="NoteTitle"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:ConnectionId='11' x:Name="NoteSubtitle"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Note metadata -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="笔记信息" FontSize="14" FontWeight="SemiBold" />
                                <Grid x:ConnectionId='8' x:Name="NoteMetadataGrid"
                                      ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Note content -->
                        <Border Style="{StaticResource RokuricsCardStyle}" Padding="18">
                            <ScrollViewer MaxHeight="600">
                                <TextBlock x:ConnectionId='7' x:Name="NoteContent"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

