<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rokurics.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rokurics">

    <NavigationView
        x:Name="MainNavView"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="OnNavSelectionChanged"
        OpenPaneLength="220">

        <NavigationView.Resources>
            <!-- Mint→Aqua selection accent matching macOS sidebar gradient -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#4FBEBA" />
        </NavigationView.Resources>

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="搜索学习库..."
                            QuerySubmitted="OnSearchQuerySubmitted"
                            TextChanged="OnSearchTextChanged"
                            Width="260">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </NavigationView.AutoSuggestBox>

        <NavigationView.PaneHeader>
            <StackPanel Padding="20,24,20,18" Spacing="4">
                <TextBlock Text="Rokurics"
                           FontFamily="{StaticResource RokuricsSerifFont}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="Windows"
                           FontFamily="{StaticResource RokuricsFontFamily}"
                           FontSize="12"
                           FontWeight="Medium"
                           Opacity="0.5" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="StudyLibraryNavItem"
                                Tag="studyLibrary"
                                Content="学习库"
                                IsSelected="True">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AIChatNavItem"
                                Tag="aiChat"
                                Content="AI 对话">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="iPhoneConnectionNavItem"
                                Tag="iPhoneConnection"
                                Content="iPhone 连接">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="PhoneBook" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <NavigationViewItem x:Name="SettingsNavItem"
                                Tag="settings"
                                Content="设置">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
