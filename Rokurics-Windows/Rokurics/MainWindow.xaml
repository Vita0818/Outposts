<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rokurics.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Rokurics.Views"
    Title="Rokurics"
    ExtendsContentIntoTitleBar="True"
    MinWidth="1040"
    MinHeight="690">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="210" MaxWidth="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar matching MacSidebarView -->
        <views:SidebarView x:Name="SidebarControl"
                           Grid.Column="0"
                           SelectionChanged="OnSidebarSelectionChanged" />

        <!-- Detail area matching Mac detail view -->
        <Frame x:Name="ContentFrame"
               Grid.Column="1"
               Background="Transparent" />
    </Grid>
</Window>
